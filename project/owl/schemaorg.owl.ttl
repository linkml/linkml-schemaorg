example:returnFees a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnFees" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of return fees for purchased products (for any return reason)" .

example:returnLabelSource a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnLabelSource" ;
    ns1:inScheme <http://example.org/example> ;
