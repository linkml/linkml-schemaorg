example:Course a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Course" ;
    rdfs:subClassOf example:LearningResource ;
    ns1:exactMatch <http://schema.org/Course> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of an educational course which may be offered as distinct instances at which take place at different times or take place at different locations, or be offered through different media or modes of study. An educational course is a sequence of one or more educational events and/or creative works which aims to build knowledge, competence or ability of learners." .

example:CourseInstance a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CourseInstance" ;
