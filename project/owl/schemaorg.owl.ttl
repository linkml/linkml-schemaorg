example:downloadUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "downloadUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "If the file can be downloaded, URL to download the binary." .

example:downvoteCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "downvoteCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of downvotes this question, answer or comment has received from the community." .

example:drainsTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drainsTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The vasculature that the vein drains into." .

example:driveWheelConfiguration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "driveWheelConfiguration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The drive wheel configuration, i.e. which roadwheels will receive torque from the vehicle's engine via the drivetrain." .

example:dropoffLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dropoffLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Where a rental car can be dropped off." .

example:dropoffTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dropoffTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "When a rental car can be dropped off." .

example:drug a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drug" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifying a drug or medicine used in a medication procedure." .

example:drugClass a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drugClass" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The class of drug this belongs to (e.g., statins)." .

example:drugUnit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drugUnit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The unit in which the drug is measured, e.g. '5 mg tablet'." .

example:duns a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "duns" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Dun & Bradstreet DUNS number for identifying an organization or business person." .

example:duplicateTherapy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "duplicateTherapy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A therapy that duplicates or overlaps this one." .

example:duration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "duration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The duration of the item (movie, audio recording, event, etc.) in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601)." .

example:durationOfWarranty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "durationOfWarranty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The duration of the warranty promise. Common unitCode values are ANN for year, MON for months, or DAY for days." .

example:duringMedia a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "duringMedia" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media object representing the circumstances while performing this direction." .

example:earlyPrepaymentPenalty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "earlyPrepaymentPenalty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount to be paid as a penalty in the event of early payment of the loan." .

example:editEIDR a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "editEIDR" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing a specific edit / edition for a work of film or television.

For example, the motion picture known as "Ghostbusters" whose [[titleEIDR]] is "10.5240/7EC7-228A-510A-053E-CBB8-J", has several edits e.g. "10.5240/1F2A-E1C5-680A-14C6-E76B-I" and "10.5240/8A35-3BEE-6497-5D12-9E4F-3".

Since schema.org types like [[Movie]] and [[TVEpisode]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" .

example:editor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "editor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the Person who edited the CreativeWork." .

example:eduQuestionType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eduQuestionType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For questions that are part of learning resources (e.g. Quiz), eduQuestionType indicates the format of question being given. Example: \"Multiple choice\", \"Open ended\", \"Flashcard\"." .

example:educationRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Educational background needed for the position or Occupation." .

example:educationalAlignment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalAlignment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """An alignment to an established educational framework.

This property should not be used where the nature of the alignment can be described using a simple property, for example to express that a resource [[teaches]] or [[assesses]] a competency.""" .

example:educationalCredentialAwarded a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalCredentialAwarded" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the qualification, award, certificate, diploma or other educational credential awarded as a consequence of successful completion of this course or program." .

example:educationalFramework a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalFramework" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The framework to which the resource being described is aligned." .

example:educationalLevel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalLevel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The level in terms of progression through an educational or training context. Examples of educational levels include 'beginner', 'intermediate' or 'advanced', and formal sets of level indicators." .

example:educationalProgramMode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalProgramMode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Similar to courseMode, The medium or means of delivery of the program as a whole. The value may either be a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous )." .

example:educationalRole a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalRole" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An educationalRole of an EducationalAudience." .

example:educationalUse a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "educationalUse" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The purpose of a work in the context of education; for example, 'assignment', 'group work'." .

example:elevation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "elevation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The elevation of a location ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System)). Values may be of the form 'NUMBER UNIT_OF_MEASUREMENT' (e.g., '1,000 m', '3,200 ft') while numbers alone should be assumed to be a value in meters." .

example:eligibilityToWorkRequirement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eligibilityToWorkRequirement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The legal requirements such as citizenship, visa and other documentation required for an applicant to this job." .

example:eligibleCustomerType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eligibleCustomerType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type(s) of customers for which the given offer is valid." .

example:eligibleDuration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eligibleDuration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The duration for which the given offer is valid." .

example:eligibleQuantity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eligibleQuantity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The interval and unit of measurement of ordering quantities for which the offer or price specification is valid. This allows e.g. specifying that a certain freight charge is valid only for a certain quantity." .

example:eligibleRegion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eligibleRegion" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The ISO 3166-1 (ISO 3166-1 alpha-2) or ISO 3166-2 code, the place, or the GeoShape for the geo-political region(s) for which the offer or delivery charge specification is valid.\\n\\nSee also [[ineligibleRegion]].
    """ .

example:eligibleTransactionVolume a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eligibleTransactionVolume" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The transaction volume, in a monetary unit, for which the offer or price specification is valid, e.g. for indicating a minimal purchasing volume, to express free shipping above a certain order volume, or to limit the acceptance of credit cards to purchases to a certain minimal amount." .

example:email a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "email" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Email address." .

example:embedUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "embedUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A URL pointing to a player for a specific video. In general, this is the information in the ```src``` element of an ```embed``` tag and should not be the same as the content of the ```loc``` tag." .

example:embeddedTextCaption a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "embeddedTextCaption" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents textual captioning from a [[MediaObject]], e.g. text of a 'meme'." .

example:emissionsCO2 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "emissionsCO2" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The CO2 emissions in g/km. When used in combination with a QuantitativeValue, put \"g/km\" into the unitText property of that value, since there is no UN/CEFACT Common Code for \"g/km\"." .

example:employee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "employee" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Someone working for this organization." .

example:employees a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "employees" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "People working for this organization." .

example:employerOverview a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "employerOverview" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the employer, career opportunities and work environment for this position." .

example:employmentType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "employmentType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Type of employment (e.g. full-time, part-time, contract, temporary, seasonal, internship)." .

example:employmentUnit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "employmentUnit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the department, unit and/or facility where the employee reports and/or in which the job is to be performed." .

example:encodesBioChemEntity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encodesBioChemEntity" ;
    ns2:source <http://www.bioschemas.org/Gene> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Another BioChemEntity encoded by this one. " .

example:encodesCreativeWork a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encodesCreativeWork" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The CreativeWork encoded by this media object." .

example:encoding a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encoding" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media object that encodes this CreativeWork. This property is a synonym for associatedMedia." .

example:encodingFormat a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encodingFormat" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Media type typically expressed using a MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml) and [MDN reference](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types)) e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.).

In cases where a [[CreativeWork]] has several media type representations, [[encoding]] can be used to indicate each [[MediaObject]] alongside particular [[encodingFormat]] information.

Unregistered or niche encoding and file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia/Wikidata entry.""" .

example:encodingType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encodingType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The supported encoding type(s) for an EntryPoint request." .

example:encodings a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encodings" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media object that encodes this CreativeWork." .

example:endDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "endDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The end date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." .

example:endOffset a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "endOffset" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The end time of the clip expressed as the number of seconds from the beginning of the work." .

example:endTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "endTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. e.g. John wrote a book from January to *December*. For media, including audio and video, it's the time offset of the end of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." .

example:endorsee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "endorsee" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The person/organization being supported." .

example:endorsers a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "endorsers" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "People or organizations that endorse the plan." .

example:energyEfficiencyScaleMax a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "energyEfficiencyScaleMax" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the most energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." .

example:energyEfficiencyScaleMin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "energyEfficiencyScaleMin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the least energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." .

example:engineDisplacement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "engineDisplacement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The volume swept by all of the pistons inside the cylinders of an internal combustion engine in a single movement. \\n\\nTypical unit code(s): CMQ for cubic centimeter, LTR for liters, INQ for cubic inches\\n* Note 1: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:enginePower a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enginePower" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The power of the vehicle's engine.
    Typical unit code(s): KWT for kilowatt, BHP for brake horsepower, N12 for metric horsepower (PS, with 1 PS = 735,49875 W)\\n\\n* Note 1: There are many different ways of measuring an engine's power. For an overview, see  [http://en.wikipedia.org/wiki/Horsepower#Engine_power_test_codes](http://en.wikipedia.org/wiki/Horsepower#Engine_power_test_codes).\\n* Note 2: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 3: You can use [[minValue]] and [[maxValue]] to indicate ranges.""" .

example:engineType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "engineType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of engine or engines powering the vehicle." .

example:entertainmentBusiness a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "entertainmentBusiness" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The entertainment business where the action occurred." .

example:epidemiology a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "epidemiology" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The characteristics of associated patients, such as age, gender, race etc." .

example:episode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "episode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An episode of a tv, radio or game media within a series or season." .

example:episodeNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "episodeNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Position of the episode within an ordered group of episodes." .

example:episodes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "episodes" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An episode of a TV/radio series or season." .

example:equal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "equal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This ordering relation for qualitative values indicates that the subject is equal to the object." .

example:error a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "error" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For failed actions, more information on the cause of the failure." .

example:estimatedCost a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "estimatedCost" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The estimated cost of the supply or supplies consumed when performing instructions." .

example:estimatedFlightDuration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "estimatedFlightDuration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The estimated time the flight will take." .

example:estimatedSalary a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "estimatedSalary" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An estimated salary for a job posting or occupation, based on a variety of variables including, but not limited to industry, job title, and location. Estimated salaries  are often computed by outside organizations rather than the hiring organization, who may not have committed to the estimated value." .

example:estimatesRiskOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "estimatesRiskOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The condition, complication, or symptom whose risk is being estimated." .

example:ethicsPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ethicsPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Statement about ethics policy, e.g. of a [[NewsMediaOrganization]] regarding journalistic and publishing practices, or of a [[Restaurant]], a page describing food source policies. In the case of a [[NewsMediaOrganization]], an ethicsPolicy is typically a statement describing the personal, organizational, and corporate standards of behavior expected by the organization." .

example:event a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "event" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Upcoming or past event associated with this place, organization, or action." .

example:eventAttendanceMode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eventAttendanceMode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The eventAttendanceMode of an event indicates whether it occurs online, offline, or a mix." .

example:eventSchedule a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eventSchedule" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Associates an [[Event]] with a [[Schedule]]. There are circumstances where it is preferable to share a schedule for a series of
      repeating events rather than data on the individual events themselves. For example, a website or application might prefer to publish a schedule for a weekly
      gym class rather than provide data on every event. A schedule could be processed by applications to add forthcoming events to a calendar. An [[Event]] that
      is associated with a [[Schedule]] using this property should not have [[startDate]] or [[endDate]] properties. These are instead defined within the associated
      [[Schedule]], this avoids any ambiguity for clients using the data. The property might have repeated values to specify different schedules, e.g. for different months
      or seasons.""" .

example:eventStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "eventStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled." .

example:events a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "events" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Upcoming or past events associated with this place or organization." .

example:evidenceLevel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "evidenceLevel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Strength of evidence of the data used to formulate the guideline (enumerated)." .

example:evidenceOrigin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "evidenceOrigin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Source of the data used to formulate the guidance, e.g. RCT, consensus opinion, etc." .

example:exampleOfWork a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exampleOfWork" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A creative work that this work is an example/instance/realization/derivation of." .

example:exceptDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exceptDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Defines a [[Date]] or [[DateTime]] during which a scheduled [[Event]] will not take place. The property allows exceptions to
      a [[Schedule]] to be specified. If an exception is specified as a [[DateTime]] then only the event that would have started at that specific date and time
      should be excluded from the schedule. If an exception is specified as a [[Date]] then any event that is scheduled for that 24 hour period should be
      excluded from the schedule. This allows a whole day to be excluded from the schedule without having to itemise every scheduled event.""" .

example:exchangeRateSpread a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exchangeRateSpread" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The difference between the price at which a broker or other intermediary buys and sells foreign currency." .

example:executableLibraryName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "executableLibraryName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Library file name e.g., mscorlib.dll, system.web.dll." .

example:exerciseCourse a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exerciseCourse" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The course where this action was taken." .

example:exercisePlan a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exercisePlan" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of instrument. The exercise plan used on this action." .

example:exerciseRelatedDiet a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exerciseRelatedDiet" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of instrument. The diet used in this action." .

example:exerciseType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exerciseType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Type(s) of exercise or activity, such as strength training, flexibility training, aerobics, cardiac rehabilitation, etc." .

example:exifData a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exifData" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "exif data for this object." .

example:expectedArrivalFrom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expectedArrivalFrom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The earliest date the package may arrive." .

example:expectedArrivalUntil a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expectedArrivalUntil" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The latest date the package may arrive." .

example:expectedPrognosis a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expectedPrognosis" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The likely outcome in either the short term or long term of the medical condition." .

example:expectsAcceptanceOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expectsAcceptanceOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An Offer which must be accepted before the user can perform the Action. For example, the user may need to buy a movie before being able to watch it." .

example:experienceInPlaceOfEducation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "experienceInPlaceOfEducation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether a [[JobPosting]] will accept experience (as indicated by [[OccupationalExperienceRequirements]]) in place of its formal educational qualifications (as indicated by [[educationRequirements]]). If true, indicates that satisfying one of these requirements is sufficient." .

example:experienceRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "experienceRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of skills and experience needed for the position or Occupation." .

example:expertConsiderations a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expertConsiderations" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Medical expert advice related to the plan." .

example:expires a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expires" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date the content expires and is no longer useful or available. For example a [[VideoObject]] or [[NewsArticle]] whose availability or relevance is time-limited, or a [[ClaimReview]] fact check whose publisher wants to indicate that it may no longer be relevant (or helpful to highlight) after some date." .

example:expressedIn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expressedIn" ;
    ns2:source <http://www.bioschemas.org/Gene> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Tissue, organ, biological sample, etc in which activity of this gene has been observed experimentally. For example brain, digestive system." .

example:familyName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "familyName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Family name. In the U.S., the last name of a Person." .

example:fatContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fatContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of fat." .

example:faxNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "faxNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The fax number." .

example:featureList a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "featureList" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Features or modules provided by this application (and possibly required by other applications)." .

example:feesAndCommissionsSpecification a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "feesAndCommissionsSpecification" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of fees, commissions, and other terms applied either to a class of financial product, or by a financial service organization." .

example:fiberContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fiberContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of fiber." .

example:fileFormat a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fileFormat" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Media type, typically MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml)) of the content e.g. application/zip of a SoftwareApplication binary. In cases where a CreativeWork has several media type representations, 'encoding' can be used to indicate each MediaObject alongside particular fileFormat information. Unregistered or niche file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia entry." .

example:fileSize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fileSize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Size of the application / package (e.g. 18MB). In the absence of a unit (MB, KB etc.), KB will be assumed." .

example:financialAidEligible a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "financialAidEligible" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A financial aid type or program which students may use to pay for tuition or fees associated with the program." .

example:firstAppearance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "firstAppearance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the first known occurence of a [[Claim]] in some [[CreativeWork]]." .

example:firstPerformance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "firstPerformance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date and place the work was first performed." .

example:flightDistance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "flightDistance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The distance of the flight." .

example:flightNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "flightNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The unique identifier for a flight including the airline IATA code. For example, if describing United flight 110, where the IATA code for United is 'UA', the flightNumber is 'UA110'." .

example:floorLevel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "floorLevel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The floor level for an [[Accommodation]] in a multi-storey building. Since counting
  systems [vary internationally](https://en.wikipedia.org/wiki/Storey#Consecutive_number_floor_designations), the local system should be used where possible.""" .

example:floorLimit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "floorLimit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A floor limit is the amount of money above which credit card transactions must be authorized." .

example:floorSize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "floorSize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The size of the accommodation, e.g. in square meter or squarefoot.
Typical unit code(s): MTK for square meter, FTK for square foot, or YDK for square yard """ .

example:followee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "followee" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of object. The person or organization being followed." .

example:follows a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "follows" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The most generic uni-directional social relation." .

example:followup a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "followup" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Typical or recommended followup care after the procedure is performed." .

example:foodEstablishment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "foodEstablishment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The specific food establishment where the action occurred." .

example:foodEvent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "foodEvent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The specific food event where the action occurred." .

example:foodWarning a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "foodWarning" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any precaution, guidance, contraindication, etc. related to consumption of specific foods while taking this drug." .

example:founder a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "founder" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person who founded this organization." .

example:founders a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "founders" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person who founded this organization." .

example:foundingDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "foundingDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date that this organization was founded." .

example:foundingLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "foundingLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place where the Organization was founded." .

example:free a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "free" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A flag to signal that the item, event, or place is accessible for free." .

example:freeShippingThreshold a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "freeShippingThreshold" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A monetary value above which (or equal to) the shipping rate becomes free. Intended to be used via an [[OfferShippingDetails]] with [[shippingSettingsLink]] matching this [[ShippingRateSettings]]." .

example:frequency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "frequency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "How often the dose is taken, e.g. 'daily'." .

example:fromLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fromLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The original location of the object or the agent before the action." .

example:fuelCapacity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fuelCapacity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The capacity of the fuel tank or in the case of electric cars, the battery. If there are multiple components for storage, this should indicate the total of all storage of the same type.\\n\\nTypical unit code(s): LTR for liters, GLL of US gallons, GLI for UK / imperial gallons, AMH for ampere-hours (for electrical vehicles)." .

example:fuelConsumption a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fuelConsumption" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of fuel consumed for traveling a particular distance or temporal duration with the given vehicle (e.g. liters per 100 km).\\n\\n* Note 1: There are unfortunately no standard unit codes for liters per 100 km.  Use [[unitText]] to indicate the unit of measurement, e.g. L/100 km.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel consumption to another value." .

example:fuelEfficiency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fuelEfficiency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The distance traveled per unit of fuel used; most commonly miles per gallon (mpg) or kilometers per liter (km/L).\\n\\n* Note 1: There are unfortunately no standard unit codes for miles per gallon or kilometers per liter. Use [[unitText]] to indicate the unit of measurement, e.g. mpg or km/L.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel economy to another value." .

example:fuelType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fuelType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of fuel suitable for the engine or engines of the vehicle. If the vehicle has only one engine, this property can be attached directly to the vehicle." .

example:functionalClass a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "functionalClass" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The degree of mobility the joint allows." .

example:fundedItem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fundedItem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates an item funded or sponsored through a [[Grant]]." .

example:funder a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "funder" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person or organization that supports (sponsors) something through some kind of financial contribution." .

example:game a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "game" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Video game which is played on this server." .

example:gameItem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gameItem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An item is an object within the game world that can be collected by a player or, occasionally, a non-player character." .

example:gameLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gameLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Real or fictional location of the game (or part of game)." .

example:gamePlatform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gamePlatform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The electronic systems used to play <a href=\"http://en.wikipedia.org/wiki/Category:Video_game_platforms\">video games</a>." .

example:gameServer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gameServer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The server on which  it is possible to play the game." .

example:gameTip a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gameTip" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Links to tips, tactics, etc." .

example:gender a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gender" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Gender of something, typically a [[Person]], but possibly also fictional characters, animals, etc. While https://schema.org/Male and https://schema.org/Female may be used, text strings are also acceptable for people who do not identify as a binary gender. The [[gender]] property can also be used in an extended sense to cover e.g. the gender of sports teams. As with the gender of individuals, we do not try to enumerate all possibilities. A mixed-gender [[SportsTeam]] can be indicated with a text value of \"Mixed\"." .

example:genre a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "genre" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Genre of the creative work, broadcast channel or group." .

example:geo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The geo coordinates of the place." .

example:geoContains a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoContains" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents a relationship between two geometries (or the places they represent), relating a containing geometry to a contained geometry. \"a contains b iff no points of b lie in the exterior of a, and at least one point of the interior of b lies in the interior of a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geoCoveredBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoCoveredBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that covers it. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geoCovers a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoCovers" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents a relationship between two geometries (or the places they represent), relating a covering geometry to a covered geometry. \"Every point of b is a point of (the interior or boundary of) a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geoCrosses a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoCrosses" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that crosses it: \"a crosses b: they have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geoDisjoint a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoDisjoint" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents spatial relations in which two geometries (or the places they represent) are topologically disjoint: they have no point in common. They form a set of disconnected geometries.\" (a symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM))" .

example:geoEquals a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoEquals" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents spatial relations in which two geometries (or the places they represent) are topologically equal, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM). \"Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other\" (a symmetric relationship)" .

example:geoIntersects a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoIntersects" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents spatial relations in which two geometries (or the places they represent) have at least one point in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geoMidpoint a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoMidpoint" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the GeoCoordinates at the centre of a GeoShape e.g. GeoCircle." .

example:geoOverlaps a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoOverlaps" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that geospatially overlaps it, i.e. they have some but not all points in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geoRadius a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoRadius" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the approximate radius of a GeoCircle (metres unless indicated otherwise via Distance notation)." .

example:geoTouches a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoTouches" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents spatial relations in which two geometries (or the places they represent) touch: they have at least one boundary point in common, but no interior points.\" (a symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM) )" .

example:geoWithin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geoWithin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents a relationship between two geometries (or the places they represent), relating a geometry to one that contains it, i.e. it is inside (i.e. within) its interior. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

example:geographicArea a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geographicArea" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The geographic area associated with the audience." .

example:gettingTestedInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gettingTestedInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Information about getting tested (for a [[MedicalCondition]]), e.g. in the context of a pandemic." .

example:givenName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "givenName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Given name. In the U.S., the first name of a Person." .

example:globalLocationNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "globalLocationNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The [Global Location Number](http://www.gs1.org/gln) (GLN, sometimes also referred to as International Location Number or ILN) of the respective organization, person, or place. The GLN is a 13-digit number used to identify parties and physical locations." .

example:governmentBenefitsInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "governmentBenefitsInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "governmentBenefitsInfo provides information about government benefits associated with a SpecialAnnouncement." .

example:gracePeriod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gracePeriod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The period of time after any due date that the borrower has to fulfil its obligations before a default (failure to pay) is deemed to have occurred." .

example:grantee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "grantee" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person, organization, contact point, or audience that has been granted this permission." .

example:greater a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "greater" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This ordering relation for qualitative values indicates that the subject is greater than the object." .

example:greaterOrEqual a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "greaterOrEqual" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This ordering relation for qualitative values indicates that the subject is greater than or equal to the object." .

example:gtin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gtin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A Global Trade Item Number ([GTIN](https://www.gs1.org/standards/id-keys/gtin)). GTINs identify trade items, including products and services, using numeric identification codes. The [[gtin]] property generalizes the earlier [[gtin8]], [[gtin12]], [[gtin13]], and [[gtin14]] properties. The GS1 [digital link specifications](https://www.gs1.org/standards/Digital-Link/) express GTINs as URLs. A correct [[gtin]] value should be a valid GTIN, which means that it should be an all-numeric string of either 8, 12, 13 or 14 digits, or a "GS1 Digital Link" URL based on such a string. The numeric component should also have a [valid GS1 check digit](https://www.gs1.org/services/check-digit-calculator) and meet the other rules for valid GTINs. See also [GS1's GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) and [Wikipedia](https://en.wikipedia.org/wiki/Global_Trade_Item_Number) for more details. Left-padding of the gtin values is not required or encouraged.
   """ .

example:gtin12 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gtin12" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The GTIN-12 code of the product, or the product to which the offer refers. The GTIN-12 is the 12-digit GS1 Identification Key composed of a U.P.C. Company Prefix, Item Reference, and Check Digit used to identify trade items. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." .

example:gtin13 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gtin13" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The GTIN-13 code of the product, or the product to which the offer refers. This is equivalent to 13-digit ISBN codes and EAN UCC-13. Former 12-digit UPC codes can be converted into a GTIN-13 code by simply adding a preceding zero. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." .

example:gtin14 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gtin14" ;
    ns1:inScheme <http://example.org/example> ;
