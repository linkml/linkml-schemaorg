example:targetPlatform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targetPlatform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Type of app development: phone, Metro style, desktop, XBox, etc." .

example:targetPopulation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targetPopulation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Characteristics of the population for which this is intended, or which typically uses it, e.g. 'adults'." .

example:targetProduct a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targetProduct" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Target Operating System / Product to which the code applies.  If applies to several versions, just the product name can be used." .

example:targetUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targetUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The URL of a node in an established educational framework." .

example:taxID a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxID" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Tax / Fiscal ID of the organization or person, e.g. the TIN in the US or the CIF/NIF in Spain." .

example:taxonRank a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonRank" ;
    ns2:source <http://www.bioschemas.org/Taxon> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The taxonomic rank of this taxon given preferably as a URI from a controlled vocabulary â€“ (typically the ranks from TDWG TaxonRank ontology or equivalent Wikidata URIs)." .

example:taxonomicRange a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomicRange" ;
    ns2:source <http://www.bioschemas.org> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The taxonomic grouping of the organism that expresses, encodes, or in someway related to the BioChemEntity." .

example:teaches a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "teaches" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The item being described is intended to help a person learn the competency or learning outcome defined by the referenced term." .

example:telephone a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "telephone" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The telephone number." .

example:temporal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "temporal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The "temporal" property can be used in cases where more specific properties
(e.g. [[temporalCoverage]], [[dateCreated]], [[dateModified]], [[datePublished]]) are not known to be appropriate.""" .

example:temporalCoverage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "temporalCoverage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The temporalCoverage of a CreativeWork indicates the period that the content applies to, i.e. that it describes, either as a DateTime or as a textual string indicating a time period in [ISO 8601 time interval format](https://en.wikipedia.org/wiki/ISO_8601#Time_intervals). In
      the case of a Dataset it will typically indicate the relevant time period in a precise notation (e.g. for a 2011 census dataset, the year 2011 would be written "2011/2012"). Other forms of content e.g. ScholarlyArticle, Book, TVSeries or TVEpisode may indicate their temporalCoverage in broader terms - textually or via well-known URL.
      Written works such as books may sometimes have precise temporal coverage too, e.g. a work set in 1939 - 1945 can be indicated in ISO 8601 interval format format via "1939/1945".

Open-ended date ranges can be written with ".." in place of the end date. For example, "2015-11/.." indicates a range beginning in November 2015 and with no specified final date. This is tentative and might be updated in future when ISO 8601 is officially updated.""" .

example:termCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "termCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A code that identifies this [[DefinedTerm]] within a [[DefinedTermSet]]" .

example:termDuration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "termDuration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of time in a term as defined by the institution. A term is a length of time where students take one or more classes. Semesters and quarters are common units for term." .

example:termsOfService a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "termsOfService" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Human-readable terms of service documentation." .

example:termsPerYear a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "termsPerYear" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of times terms of study are offered per year. Semesters and quarters are common units for term. For example, if the student can only take 2 semesters for the program in one year, then termsPerYear should be 2." .

example:text a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "text" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The textual content of this CreativeWork." .

example:textValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "textValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Text value being annotated." .

example:thumbnail a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "thumbnail" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Thumbnail image for an image or video." .

example:thumbnailUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "thumbnailUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A thumbnail image relevant to the Thing." .

example:tickerSymbol a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tickerSymbol" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The exchange traded instrument associated with a Corporation object. The tickerSymbol is expressed as an exchange and an instrument name separated by a space character. For the exchange component of the tickerSymbol attribute, we recommend using the controlled vocabulary of Market Identifier Codes (MIC) specified in ISO15022." .

example:ticketNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ticketNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The unique identifier for the ticket." .

example:ticketToken a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ticketToken" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Reference to an asset (e.g., Barcode, QR code image or PDF) usable for entrance." .

example:ticketedSeat a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ticketedSeat" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The seat associated with the ticket." .

example:timeOfDay a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "timeOfDay" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time of day the program normally runs. For example, \"evenings\"." .

example:timeRequired a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "timeRequired" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Approximate or typical time it takes to work with or through this learning resource for the typical intended target audience, e.g. 'PT30M', 'PT1H25M'." .

example:timeToComplete a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "timeToComplete" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The expected length of time to complete the program if attending full-time." .

example:tissueSample a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tissueSample" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of tissue sample required for the test." .

example:title a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "title" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The title of the job." .

example:titleEIDR a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "titleEIDR" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing at the most general/abstract level, a work of film or television.

For example, the motion picture known as "Ghostbusters" has a titleEIDR of  "10.5240/7EC7-228A-510A-053E-CBB8-J". This title (or work) may have several variants, which EIDR calls "edits". See [[editEIDR]].

Since schema.org types like [[Movie]] and [[TVEpisode]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" .

example:toLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "toLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The final location of the object or the agent after the action." .

example:toRecipient a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "toRecipient" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of recipient. The recipient who was directly sent the message." .

example:tocContinuation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tocContinuation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A [[HyperTocEntry]] can have a [[tocContinuation]] indicated, which is another [[HyperTocEntry]] that would be the default next item to play or render." .

example:tocEntry a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tocEntry" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a [[HyperTocEntry]] in a [[HyperToc]]." .

example:tongueWeight a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tongueWeight" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The permitted vertical load (TWR) of a trailer attached to the vehicle. Also referred to as Tongue Load Rating (TLR) or Vertical Load Rating (VLR)\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:tool a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tool" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of instrument. An object used (but not consumed) when performing instructions or a direction." .

example:torque a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "torque" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The torque (turning force) of the vehicle's engine.\\n\\nTypical unit code(s): NU for newton metre (N m), F17 for pound-force per foot, or F48 for pound-force per inch\\n\\n* Note 1: You can link to information about how the given value has been determined (e.g. reference RPM) using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:totalJobOpenings a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "totalJobOpenings" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of positions open for this job posting. Use a positive integer. Do not use if the number of positions is unclear or not known." .

example:totalPaymentDue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "totalPaymentDue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total amount due." .

example:totalPrice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "totalPrice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total price for the reservation or ticket, including applicable taxes, shipping, etc.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

example:totalTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "totalTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total time required to perform instructions or a direction (including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

example:tourBookingPage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tourBookingPage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A page providing information on how to book a tour of some [[Place]], such as an [[Accommodation]] or [[ApartmentComplex]] in a real estate setting, as well as other kinds of tours as appropriate." .

example:touristType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "touristType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Attraction suitable for type(s) of tourist. eg. Children, visitors from a particular country, etc. " .

example:track a ns3:ObjectProperty,
        linkml:SlotDefinition ;
