    ns1:note "Indicates a range of postalcodes, usually defined as the set of valid codes between [[postalCodeBegin]] and [[postalCodeEnd]], inclusively." .

example:Poster a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Poster" ;
