    ns1:exactMatch <http://schema.org/WarrantyScope> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A range of of services that will be provided to a customer free of charge in case of a defect or malfunction of a product.\\n\\nCommonly used values:\\n\\n* http://purl.org/goodrelations/v1#Labor-BringIn\\n* http://purl.org/goodrelations/v1#PartsAndLabor-BringIn\\n* http://purl.org/goodrelations/v1#PartsAndLabor-PickUp
      """ .

example:WatchAction a ns3:Class,
