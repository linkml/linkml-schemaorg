example:PriceComponentTypeEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PriceComponentTypeEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/PriceComponentTypeEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerates different price components that together make up the total price for an offered product." .

example:PriceTypeEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PriceTypeEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/PriceTypeEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerates different price types, for example list price, invoice price, and sale price." .

example:PrimaryCare a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PrimaryCare" ;
    rdfs:subClassOf example:MedicalBusiness ;
    ns1:exactMatch <http://schema.org/PrimaryCare> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The medical care by a physician, or other health-care professional, who is the patient's first contact with the health-care system and who may recommend a specialist if necessary." .

example:ProductCollection a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProductCollection" ;
    rdfs:subClassOf example:Product ;
    ns1:exactMatch <http://schema.org/ProductCollection> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A set of products (either [[ProductGroup]]s or specific variants) that are listed together e.g. in an [[Offer]]." .

example:ProductGroup a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProductGroup" ;
    rdfs:subClassOf example:Product ;
    ns1:exactMatch <http://schema.org/ProductGroup> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A ProductGroup represents a group of [[Product]]s that vary only in certain well-described ways, such as by [[size]], [[color]], [[material]] etc.

While a ProductGroup itself is not directly offered for sale, the various varying products that it represents can be. The ProductGroup serves as a prototype or template, standing in for all of the products who have an [[isVariantOf]] relationship to it. As such, properties (including additional types) can be applied to the ProductGroup to represent characteristics shared by each of the (possibly very many) variants. Properties that reference a ProductGroup are not included in this mechanism; neither are the following specific properties [[variesBy]], [[hasVariant]], [[url]]. """ .

example:ProductModel a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProductModel" ;
    rdfs:subClassOf example:Product ;
    ns1:exactMatch <http://schema.org/ProductModel> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A datasheet or vendor specification of a product (in the sense of a prototypical description)." .

example:ProfessionalService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProfessionalService" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/ProfessionalService> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Original definition: "provider of professional services."\\n\\nThe general [[ProfessionalService]] type for local businesses was deprecated due to confusion with [[Service]]. For reference, the types that it included were: [[Dentist]],
        [[AccountingService]], [[Attorney]], [[Notary]], as well as types for several kinds of [[HomeAndConstructionBusiness]]: [[Electrician]], [[GeneralContractor]],
        [[HousePainter]], [[Locksmith]], [[Plumber]], [[RoofingContractor]]. [[LegalService]] was introduced as a more inclusive supertype of [[Attorney]].""" .

example:ProfilePage a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProfilePage" ;
    rdfs:subClassOf example:WebPage ;
    ns1:exactMatch <http://schema.org/ProfilePage> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Web page type: Profile page." .

example:ProgramMembership a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProgramMembership" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/ProgramMembership> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Used to describe membership in a loyalty programs (e.g. \"StarAliance\"), traveler clubs (e.g. \"AAA\"), purchase clubs (\"Safeway Club\"), etc." .

example:PronounceableText a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PronounceableText" ;
    rdfs:subClassOf example:Text ;
    ns1:exactMatch <http://schema.org/PronounceableText> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Data type: PronounceableText." .

example:Property a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Property" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Property> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A property, used to indicate attributes and relationships of some Thing; equivalent to rdf:Property." .

example:PropertyValueSpecification a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PropertyValueSpecification" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/PropertyValueSpecification> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A Property value specification." .

example:Protein a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Protein" ;
    ns2:source <http://bioschemas.org> ;
    rdfs:subClassOf example:BioChemEntity ;
    ns1:exactMatch <http://schema.org/Protein> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Protein is here used in its widest possible definition, as classes of amino acid based molecules. Amyloid-beta Protein in human (UniProt P05067), eukaryota (e.g. an OrthoDB group) or even a single molecule that one can point to are all of type schema:Protein. A protein can thus be a subclass of another protein, e.g. schema:Protein as a UniProt record can have multiple isoforms inside it which would also be schema:Protein. They can be imagined, synthetic, hypothetical or naturally occurring." .

example:Psychiatric a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Psychiatric" ;
    rdfs:subClassOf example:MedicalBusiness ;
    ns1:exactMatch <http://schema.org/Psychiatric> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A specific branch of medical science that is concerned with the study, treatment, and prevention of mental illness, using both medical and psychological therapies." .

example:PsychologicalTreatment a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PsychologicalTreatment" ;
    rdfs:subClassOf example:TherapeuticProcedure ;
    ns1:exactMatch <http://schema.org/PsychologicalTreatment> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A process of care relying upon counseling, dialogue and communication  aimed at improving a mental health condition without use of drugs." .

example:PublicHealth a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PublicHealth" ;
    rdfs:subClassOf example:MedicalBusiness ;
    ns1:exactMatch <http://schema.org/PublicHealth> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Branch of medicine that pertains to the health services to improve and protect community health, especially epidemiology, sanitation, immunization, and preventive medicine." .

example:PublicSwimmingPool a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PublicSwimmingPool" ;
    rdfs:subClassOf example:SportsActivityLocation ;
    ns1:exactMatch <http://schema.org/PublicSwimmingPool> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A public swimming pool." .

example:PublicToilet a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PublicToilet" ;
    rdfs:subClassOf example:CivicStructure ;
    ns1:exactMatch <http://schema.org/PublicToilet> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A public toilet is a room or small building containing one or more toilets (and possibly also urinals) which is available for use by the general public, or by customers or employees of certain businesses." .

example:PublicationVolume a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PublicationVolume" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/PublicationVolume> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A part of a successively published publication such as a periodical or multi-volume work, often numbered. It may represent a time span, such as a year.\\n\\nSee also [blog post](http://blog.schema.org/2014/09/schemaorg-support-for-bibliographic_2.html)." .

example:QAPage a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "QAPage" ;
    rdfs:subClassOf example:WebPage ;
    ns1:exactMatch <http://schema.org/QAPage> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A QAPage is a WebPage focussed on a specific Question and its Answer(s), e.g. in a question answering site or documenting Frequently Asked Questions (FAQs)." .

example:QuantitativeValue a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "QuantitativeValue" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/QuantitativeValue> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note " A point value or interval for product characteristics and other purposes." .

example:Question a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Question" ;
    rdfs:subClassOf example:Comment ;
    ns1:exactMatch <http://schema.org/Question> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A specific question - e.g. from a user seeking answers online, or collected in a Frequently Asked Questions (FAQ) document." .

example:Quiz a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Quiz" ;
    rdfs:subClassOf example:LearningResource ;
    ns1:exactMatch <http://schema.org/Quiz> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Quiz: A test of knowledge, skills and abilities." .

example:Quotation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Quotation" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Quotation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A quotation. Often but not necessarily from some written work, attributable to a real world author and - if associated with a fictional character - to any fictional Person. Use [[isBasedOn]] to link to source/origin. The [[recordedIn]] property can be used to reference a Quotation from an [[Event]]." .

example:QuoteAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "QuoteAction" ;
    rdfs:subClassOf example:TradeAction ;
    ns1:exactMatch <http://schema.org/QuoteAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An agent quotes/estimates/appraises an object/product/service with a price at a location/store." .

example:RVPark a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RVPark" ;
    rdfs:subClassOf example:CivicStructure ;
    ns1:exactMatch <http://schema.org/RVPark> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A place offering space for \"Recreational Vehicles\", Caravans, mobile homes and the like." .

example:RadiationTherapy a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadiationTherapy" ;
    rdfs:subClassOf example:MedicalTherapy ;
    ns1:exactMatch <http://schema.org/RadiationTherapy> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A process of care using radiation aimed at improving a health condition." .

example:RadioBroadcastService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioBroadcastService" ;
    rdfs:subClassOf example:BroadcastService ;
    ns1:exactMatch <http://schema.org/RadioBroadcastService> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A delivery service through which radio content is provided via broadcast over the air or online." .

example:RadioClip a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioClip" ;
    rdfs:subClassOf example:Clip ;
    ns1:exactMatch <http://schema.org/RadioClip> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A short radio program or a segment/part of a radio program." .

example:RadioEpisode a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioEpisode" ;
    rdfs:subClassOf example:Episode ;
    ns1:exactMatch <http://schema.org/RadioEpisode> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A radio episode which can be part of a series or season." .

example:RadioSeason a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioSeason" ;
    rdfs:subClassOf example:CreativeWorkSeason ;
    ns1:exactMatch <http://schema.org/RadioSeason> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Season dedicated to radio broadcast and associated online delivery." .

example:RadioSeries a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioSeries" ;
    rdfs:subClassOf example:CreativeWorkSeries ;
    ns1:exactMatch <http://schema.org/RadioSeries> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "CreativeWorkSeries dedicated to radio broadcast and associated online delivery." .

example:RadioStation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioStation" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/RadioStation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A radio station." .

example:ReadAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReadAction" ;
    rdfs:subClassOf example:ConsumeAction ;
    ns1:exactMatch <http://schema.org/ReadAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of consuming written content." .

example:RealEstateAgent a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RealEstateAgent" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/RealEstateAgent> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A real-estate agent." .

example:RealEstateListing a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RealEstateListing" ;
    rdfs:subClassOf example:WebPage ;
    ns1:exactMatch <http://schema.org/RealEstateListing> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A [[RealEstateListing]] is a listing that describes one or more real-estate [[Offer]]s (whose [[businessFunction]] is typically to lease out, or to sell).
  The [[RealEstateListing]] type itself represents the overall listing, as manifested in some [[WebPage]].
  """ .

example:ReceiveAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReceiveAction" ;
    rdfs:subClassOf example:TransferAction ;
    ns1:exactMatch <http://schema.org/ReceiveAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of physically/electronically taking delivery of an object that has been transferred from an origin to a destination. Reciprocal of SendAction.\\n\\nRelated actions:\\n\\n* [[SendAction]]: The reciprocal of ReceiveAction.\\n* [[TakeAction]]: Unlike TakeAction, ReceiveAction does not imply that the ownership has been transfered (e.g. I can receive a package, but it does not mean the package is now mine)." .

example:Recipe a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Recipe" ;
    rdfs:subClassOf example:HowTo ;
    ns1:exactMatch <http://schema.org/Recipe> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A recipe. For dietary restrictions covered by the recipe, a few common restrictions are enumerated via [[suitableForDiet]]. The [[keywords]] property can also be used to add more detail." .

example:Recommendation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Recommendation" ;
    rdfs:subClassOf example:Review ;
    ns1:exactMatch <http://schema.org/Recommendation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "[[Recommendation]] is a type of [[Review]] that suggests or proposes something as the best option or best course of action. Recommendations may be for products or services, or other concrete things, as in the case of a ranked list or product guide. A [[Guide]] may list multiple recommendations for different categories. For example, in a [[Guide]] about which TVs to buy, the author may have several [[Recommendation]]s." .

example:RecommendedDoseSchedule a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RecommendedDoseSchedule" ;
    rdfs:subClassOf example:DoseSchedule ;
    ns1:exactMatch <http://schema.org/RecommendedDoseSchedule> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A recommended dosing schedule for a drug or supplement as prescribed or recommended by an authority or by the drug/supplement's manufacturer. Capture the recommending authority in the recognizingAuthority property of MedicalEntity." .

example:RecyclingCenter a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RecyclingCenter" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/RecyclingCenter> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A recycling center." .

example:RefundTypeEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RefundTypeEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/RefundTypeEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerates several kinds of product return refund types." .

example:RegisterAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RegisterAction" ;
    rdfs:subClassOf example:InteractAction ;
    ns1:exactMatch <http://schema.org/RegisterAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of registering to be a user of a service, product or web page.\\n\\nRelated actions:\\n\\n* [[JoinAction]]: Unlike JoinAction, RegisterAction implies you are registering to be a user of a service, *not* a group/team of people.\\n* [FollowAction]]: Unlike FollowAction, RegisterAction doesn't imply that the agent is expecting to poll for updates from the object.\\n* [[SubscribeAction]]: Unlike SubscribeAction, RegisterAction doesn't imply that the agent is expecting updates from the object." .

example:RejectAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RejectAction" ;
    rdfs:subClassOf example:AllocateAction ;
    ns1:exactMatch <http://schema.org/RejectAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of rejecting to/adopting an object.\\n\\nRelated actions:\\n\\n* [[AcceptAction]]: The antonym of RejectAction." .

example:RentAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RentAction" ;
    rdfs:subClassOf example:TradeAction ;
    ns1:exactMatch <http://schema.org/RentAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of giving money in return for temporary use, but not ownership, of an object such as a vehicle or property. For example, an agent rents a property from a landlord in exchange for a periodic payment." .

example:RentalCarReservation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RentalCarReservation" ;
    rdfs:subClassOf example:Reservation ;
    ns1:exactMatch <http://schema.org/RentalCarReservation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A reservation for a rental car.\\n\\nNote: This type is for information about actual reservations, e.g. in confirmation emails or HTML pages with individual confirmations of reservations." .

example:RepaymentSpecification a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RepaymentSpecification" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/RepaymentSpecification> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A structured value representing repayment." .

example:ReplaceAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReplaceAction" ;
    rdfs:subClassOf example:UpdateAction ;
    ns1:exactMatch <http://schema.org/ReplaceAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of editing a recipient by replacing an old object with a new object." .

example:ReplyAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReplyAction" ;
    rdfs:subClassOf example:CommunicateAction ;
    ns1:exactMatch <http://schema.org/ReplyAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of responding to a question/message asked/sent by the object. Related to [[AskAction]]\\n\\nRelated actions:\\n\\n* [[AskAction]]: Appears generally as an origin of a ReplyAction." .

example:Report a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Report" ;
    rdfs:subClassOf example:Article ;
    ns1:exactMatch <http://schema.org/Report> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A Report generated by governmental or non-governmental organization." .

example:ReportageNewsArticle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReportageNewsArticle" ;
    rdfs:subClassOf example:NewsArticle ;
    ns1:exactMatch <http://schema.org/ReportageNewsArticle> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The [[ReportageNewsArticle]] type is a subtype of [[NewsArticle]] representing
 news articles which are the result of journalistic news reporting conventions.

In practice many news publishers produce a wide variety of article types, many of which might be considered a [[NewsArticle]] but not a [[ReportageNewsArticle]]. For example, opinion pieces, reviews, analysis, sponsored or satirical articles, or articles that combine several of these elements.

The [[ReportageNewsArticle]] type is based on a stricter ideal for "news" as a work of journalism, with articles based on factual information either observed or verified by the author, or reported and verified from knowledgeable sources.  This often includes perspectives from multiple viewpoints on a particular issue (distinguishing news reports from public relations or propaganda).  News reports in the [[ReportageNewsArticle]] sense de-emphasize the opinion of the author, with commentary and value judgements typically expressed elsewhere.

A [[ReportageNewsArticle]] which goes deeper into analysis can also be marked with an additional type of [[AnalysisNewsArticle]].
""" .

example:ReportedDoseSchedule a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReportedDoseSchedule" ;
    rdfs:subClassOf example:DoseSchedule ;
    ns1:exactMatch <http://schema.org/ReportedDoseSchedule> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A patient-reported or observed dosing schedule for a drug or supplement." .

example:ResearchOrganization a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ResearchOrganization" ;
    rdfs:subClassOf example:Organization ;
