example:returnMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of return method offered, specified from an enumeration." .

example:returnPolicyCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnPolicyCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies an applicable return policy (from an enumeration)." .

example:returnPolicyCountry a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnPolicyCountry" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The country where the product has to be sent to for returns, for example \"Ireland\" using the [[name]] property of [[Country]]. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1). Note that this can be different from the country where the product was originally shipped from or sent too." .

example:returnPolicySeasonalOverride a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnPolicySeasonalOverride" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Seasonal override of a return policy." .

example:returnShippingFeesAmount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "returnShippingFeesAmount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Amount of shipping costs for product returns (for any reason). Applicable when property [[returnFees]] equals [[ReturnShippingFees]]." .

example:review a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "review" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A review of the item." .

example:reviewAspect a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviewAspect" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This Review or Rating is relevant to this part or facet of the itemReviewed." .

example:reviewBody a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviewBody" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The actual body of the review." .

example:reviewCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviewCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The count of total number of reviews." .

example:reviewRating a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviewRating" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The rating given in this review. Note that reviews can themselves be rated. The ```reviewRating``` applies to rating given by the review. The [[aggregateRating]] property applies to the review itself, as a creative work." .

example:reviewedBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviewedBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "People or organizations that have reviewed the content on this web page for accuracy and/or completeness." .

example:reviews a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviews" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Review of the item." .

example:riskFactor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "riskFactor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A modifiable or non-modifiable factor that increases the risk of a patient contracting this condition, e.g. age,  coexisting condition." .

example:risks a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "risks" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specific physiologic risks associated to the diet plan." .

example:roleName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "roleName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A role played, performed or filled by a person or organization. For example, the team of creators for a comic book might fill the roles named 'inker', 'penciller', and 'letterer'; or an athlete in a SportsTeam might play in the position named 'Quarterback'." .

example:roofLoad a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "roofLoad" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The permitted total weight of cargo and installations (e.g. a roof rack) on top of the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]]\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:rsvpResponse a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rsvpResponse" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The response (yes, no, maybe) to the RSVP." .

example:runsTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "runsTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The vasculature the lymphatic structure runs, or efferents, to." .

example:runtime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "runtime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Runtime platform or script interpreter dependencies (Example - Java v1, Python2.3, .Net Framework 3.0)." .

example:runtimePlatform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "runtimePlatform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Runtime platform or script interpreter dependencies (Example - Java v1, Python2.3, .Net Framework 3.0)." .

example:rxcui a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rxcui" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The RxCUI drug identifier from RXNORM." .

example:safetyConsideration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "safetyConsideration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any potential safety concern associated with the supplement. May include interactions with other drugs and foods, pregnancy, breastfeeding, known adverse reactions, and documented efficacy of the supplement." .

example:salaryCurrency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "salaryCurrency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The currency (coded using [ISO 4217](http://en.wikipedia.org/wiki/ISO_4217) ) used for the main salary information in this job posting or for this employee." .

example:salaryUponCompletion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "salaryUponCompletion" ;
    ns1:inScheme <http://example.org/example> ;
