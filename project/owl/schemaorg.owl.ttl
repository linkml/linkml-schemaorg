    rdfs:label "LibrarySystem" ;
    rdfs:subClassOf example:Organization ;
    ns1:exactMatch <http://schema.org/LibrarySystem> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A [[LibrarySystem]] is a collaborative system amongst several libraries." .

example:Ligament a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Ligament" ;
    rdfs:subClassOf example:AnatomicalStructure ;
    ns1:exactMatch <http://schema.org/Ligament> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A short band of tough, flexible, fibrous connective tissue that functions to connect multiple bones, cartilages, and structurally support joints." .

example:LikeAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LikeAction" ;
    rdfs:subClassOf example:ReactAction ;
    ns1:exactMatch <http://schema.org/LikeAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of expressing a positive sentiment about the object. An agent likes an object (a proposition, topic or theme) with participants." .

example:LinkRole a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LinkRole" ;
    rdfs:subClassOf example:Role ;
    ns1:exactMatch <http://schema.org/LinkRole> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A Role that represents a Web link e.g. as expressed via the 'url' property. Its linkRelationship property can indicate URL-based and plain textual link types e.g. those in IANA link registry or others such as 'amphtml'. This structure provides a placeholder where details from HTML's link element can be represented outside of HTML, e.g. in JSON-LD feeds." .

example:LiquorStore a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LiquorStore" ;
    rdfs:subClassOf example:Store ;
    ns1:exactMatch <http://schema.org/LiquorStore> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A shop that sells alcoholic drinks such as wine, beer, whisky and other spirits." .

example:ListenAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ListenAction" ;
    rdfs:subClassOf example:ConsumeAction ;
    ns1:exactMatch <http://schema.org/ListenAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of consuming audio content." .

example:LiteraryEvent a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LiteraryEvent" ;
    rdfs:subClassOf example:Event ;
    ns1:exactMatch <http://schema.org/LiteraryEvent> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Event type: Literary event." .

example:LiveBlogPosting a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LiveBlogPosting" ;
    rdfs:subClassOf example:BlogPosting ;
    ns1:exactMatch <http://schema.org/LiveBlogPosting> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A [[LiveBlogPosting]] is a [[BlogPosting]] intended to provide a rolling textual coverage of an ongoing event through continuous updates." .

example:LocationFeatureSpecification a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LocationFeatureSpecification" ;
    rdfs:subClassOf example:PropertyValue ;
    ns1:exactMatch <http://schema.org/LocationFeatureSpecification> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies a location feature by providing a structured value representing a feature of an accommodation as a property-value pair of varying degrees of formality." .

example:Locksmith a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Locksmith" ;
    rdfs:subClassOf example:HomeAndConstructionBusiness ;
    ns1:exactMatch <http://schema.org/Locksmith> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A locksmith." .

example:LodgingReservation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LodgingReservation" ;
    rdfs:subClassOf example:Reservation ;
    ns1:exactMatch <http://schema.org/LodgingReservation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A reservation for lodging at a hotel, motel, inn, etc.\\n\\nNote: This type is for information about actual reservations, e.g. in confirmation emails or HTML pages with individual confirmations of reservations." .

example:LoseAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LoseAction" ;
    rdfs:subClassOf example:AchieveAction ;
    ns1:exactMatch <http://schema.org/LoseAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of being defeated in a competitive activity." .

example:LymphaticVessel a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LymphaticVessel" ;
    rdfs:subClassOf example:Vessel ;
    ns1:exactMatch <http://schema.org/LymphaticVessel> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A type of blood vessel that specifically carries lymph fluid unidirectionally toward the heart." .

example:Manuscript a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Manuscript" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Manuscript> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A book, document, or piece of music written by hand rather than typed or printed." .

example:Map a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Map" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Map> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A map." .

example:MapCategoryType a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MapCategoryType" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/MapCategoryType> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An enumeration of several kinds of Map." .

example:MarryAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MarryAction" ;
    rdfs:subClassOf example:InteractAction ;
    ns1:exactMatch <http://schema.org/MarryAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of marrying a person." .

example:Mass a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Mass" ;
    rdfs:subClassOf example:Quantity ;
    ns1:exactMatch <http://schema.org/Mass> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Properties that take Mass as values are of the form '&lt;Number&gt; &lt;Mass unit of measure&gt;'. E.g., '7 kg'." .

example:MathSolver a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MathSolver" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/MathSolver> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A math solver which is capable of solving a subset of mathematical problems." .

example:MaximumDoseSchedule a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MaximumDoseSchedule" ;
    rdfs:subClassOf example:DoseSchedule ;
    ns1:exactMatch <http://schema.org/MaximumDoseSchedule> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The maximum dosing schedule considered safe for a drug or supplement as recommended by an authority or by the drug/supplement's manufacturer. Capture the recommending authority in the recognizingAuthority property of MedicalEntity." .

example:MediaManipulationRatingEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MediaManipulationRatingEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/MediaManipulationRatingEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note " Codes for use with the [[mediaAuthenticityCategory]] property, indicating the authenticity of a media object (in the context of how it was published or shared). In general these codes are not mutually exclusive, although some combinations (such as 'original' versus 'transformed', 'edited' and 'staged') would be contradictory if applied in the same [[MediaReview]]. Note that the application of these codes is with regard to a piece of media shared or published in a particular context." .

example:MediaReview a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MediaReview" ;
    rdfs:subClassOf example:Review ;
    ns1:exactMatch <http://schema.org/MediaReview> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A [[MediaReview]] is a more specialized form of Review dedicated to the evaluation of media content online, typically in the context of fact-checking and misinformation.
    For more general reviews of media in the broader sense, use [[UserReview]], [[CriticReview]] or other [[Review]] types. This definition is
    a work in progress. While the [[MediaManipulationRatingEnumeration]] list reflects significant community review amongst fact-checkers and others working
    to combat misinformation, the specific structures for representing media objects, their versions and publication context, is still evolving. Similarly, best practices for the relationship between [[MediaReview]] and [[ClaimReview]] markup has not yet been finalized.""" .

example:MediaReviewItem a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MediaReviewItem" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/MediaReviewItem> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents an item or group of closely related items treated as a unit for the sake of evaluation in a [[MediaReview]]. Authorship etc. apply to the items rather than to the curation/grouping or reviewing party." .

example:MediaSubscription a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MediaSubscription" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/MediaSubscription> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A subscription which allows a user to access media including audio, video, books, etc." .

example:MedicalAudience a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalAudience" ;
    rdfs:subClassOf example:PeopleAudience ;
    ns1:exactMatch <http://schema.org/MedicalAudience> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Target audiences for medical web pages." .

example:MedicalAudienceType a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalAudienceType" ;
    rdfs:subClassOf example:MedicalEnumeration ;
    ns1:exactMatch <http://schema.org/MedicalAudienceType> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Target audiences types for medical web pages. Enumerated type." .

example:MedicalCause a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalCause" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalCause> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The causative agent(s) that are responsible for the pathophysiologic process that eventually results in a medical condition, symptom or sign. In this schema, unless otherwise specified this is meant to be the proximate cause of the medical condition, symptom or sign. The proximate cause is defined as the causative agent that most directly results in the medical condition, symptom or sign. For example, the HIV virus could be considered a cause of AIDS. Or in a diagnostic context, if a patient fell and sustained a hip fracture and two days later sustained a pulmonary embolism which eventuated in a cardiac arrest, the cause of the cardiac arrest (the proximate cause) would be the pulmonary embolism and not the fall. Medical causes can include cardiovascular, chemical, dermatologic, endocrine, environmental, gastroenterologic, genetic, hematologic, gynecologic, iatrogenic, infectious, musculoskeletal, neurologic, nutritional, obstetric, oncologic, otolaryngologic, pharmacologic, psychiatric, pulmonary, renal, rheumatologic, toxic, traumatic, or urologic causes; medical conditions can be causes as well." .

example:MedicalCode a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalCode" ;
    rdfs:subClassOf example:MedicalIntangible ;
    ns1:exactMatch <http://schema.org/MedicalCode> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A code for a medical entity." .

example:MedicalConditionStage a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalConditionStage" ;
    rdfs:subClassOf example:MedicalIntangible ;
    ns1:exactMatch <http://schema.org/MedicalConditionStage> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A stage of a medical condition, such as 'Stage IIIa'." .

example:MedicalContraindication a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalContraindication" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalContraindication> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A condition or factor that serves as a reason to withhold a certain medical therapy. Contraindications can be absolute (there are no reasonable circumstances for undertaking a course of action) or relative (the patient is at higher risk of complications, but that these risks may be outweighed by other considerations or mitigated by other measures)." .

example:MedicalDevice a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalDevice" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalDevice> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any object used in a medical capacity, such as to diagnose or treat a patient." .

example:MedicalDevicePurpose a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalDevicePurpose" ;
    rdfs:subClassOf example:MedicalEnumeration ;
