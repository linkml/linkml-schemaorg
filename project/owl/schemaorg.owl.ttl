example:repetitions a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "repetitions" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Number of times one should repeat the activity." .

example:replacee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
