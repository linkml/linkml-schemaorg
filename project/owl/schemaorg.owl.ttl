example:programMembershipUsed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "programMembershipUsed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any membership in a frequent flyer, hotel loyalty program, etc. being applied to the reservation." .

example:programName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "programName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The program providing the membership." .

example:programPrerequisites a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "programPrerequisites" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Prerequisites for enrolling in the program." .

example:programType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "programType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of educational or occupational program. For example, classroom, internship, alternance, etc.." .

example:programmingLanguage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "programmingLanguage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The computer programming language." .

example:programmingModel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "programmingModel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether API is managed or unmanaged." .

example:propertyID a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "propertyID" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be
(1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific id of the property), or (3)
a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry).
Standards bodies should promote a standard prefix for the identifiers of properties from their standards.""" .

example:proprietaryName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proprietaryName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Proprietary name given to the diet plan, typically by its originator or creator." .

example:proteinContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proteinContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of protein." .

example:provider a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "provider" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The service provider, service operator, or service performer; the goods producer. Another party (a seller) may offer those services or goods on behalf of the provider. A provider may also serve as the seller." .

example:providerMobility a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "providerMobility" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the mobility of a provided service (e.g. 'static', 'dynamic')." .

example:providesBroadcastService a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "providesBroadcastService" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The BroadcastService offered on this channel." .

example:providesService a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "providesService" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The service provided by this channel." .

example:publicAccess a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publicAccess" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A flag to signal that the [[Place]] is open to public visitors.  If this property is omitted there is no assumed default boolean value" .

example:publicTransportClosuresInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publicTransportClosuresInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Information about public transport closures." .

example:publication a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publication" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A publication event associated with the item." .

example:publicationType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publicationType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of the medical article, taken from the US NLM MeSH publication type catalog. See also [MeSH documentation](http://www.nlm.nih.gov/mesh/pubtypes.html)." .

example:publishedBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publishedBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An agent associated with the publication event." .

example:publishedOn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publishedOn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A broadcast service associated with the publication event." .

example:publisher a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publisher" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The publisher of the creative work." .

example:publisherImprint a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publisherImprint" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The publishing division which published the comic." .

example:publishingPrinciples a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publishingPrinciples" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The publishingPrinciples property indicates (typically via [[URL]]) a document describing the editorial principles of an [[Organization]] (or individual e.g. a [[Person]] writing a blog) that relate to their activities as a publisher, e.g. ethics or diversity policies. When applied to a [[CreativeWork]] (e.g. [[NewsArticle]]) the principles are those of the party primarily responsible for the creation of the [[CreativeWork]].

While such policies are most typically expressed in natural language, sometimes related information (e.g. indicating a [[funder]]) can be expressed using schema.org terminology.
""" .

example:purchaseDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "purchaseDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date the item e.g. vehicle was purchased by the current owner." .

example:qualifications a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "qualifications" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specific qualifications required for this role or Occupation." .

example:quarantineGuidelines a ns3:ObjectProperty,
        linkml:SlotDefinition ;
