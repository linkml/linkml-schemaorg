    rdfs:label "PrependAction" ;
    rdfs:subClassOf example:InsertAction ;
    ns1:exactMatch <http://schema.org/PrependAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of inserting at the beginning if an ordered collection." .

example:Preschool a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Preschool" ;
    rdfs:subClassOf example:EducationalOrganization ;
    ns1:exactMatch <http://schema.org/Preschool> ;
    ns1:inScheme <http://example.org/example> ;
