example:AnatomicalSystem a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AnatomicalSystem" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/AnatomicalSystem> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An anatomical system is a group of anatomical structures that work together to perform a certain task. Anatomical systems, such as organ systems, are one organizing principle of anatomy, and can includes circulatory, digestive, endocrine, integumentary, immune, lymphatic, muscular, nervous, reproductive, respiratory, skeletal, urinary, vestibular, and other systems." .

example:AnimalShelter a ns3:Class,
