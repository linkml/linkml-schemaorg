    rdfs:label "AcceptAction" ;
    rdfs:subClassOf example:AllocateAction ;
    ns1:exactMatch <http://schema.org/AcceptAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of committing to/adopting an object.\\n\\nRelated actions:\\n\\n* [[RejectAction]]: The antonym of AcceptAction." .

example:AccountingService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AccountingService" ;
    rdfs:subClassOf example:FinancialService ;
    ns1:exactMatch <http://schema.org/AccountingService> ;
