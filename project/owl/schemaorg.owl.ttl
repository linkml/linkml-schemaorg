example:childMinAge a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "childMinAge" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Minimal age of the child." .

example:childTaxon a ns3:ObjectProperty,
        linkml:SlotDefinition ;
