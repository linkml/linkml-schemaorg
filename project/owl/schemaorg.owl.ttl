        linkml:SlotDefinition ;
    rdfs:label "infectiousAgent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The actual infectious agent, such as a specific bacterium." .

example:infectiousAgentClass a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "infectiousAgentClass" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The class of infectious agent (bacteria, prion, etc.) that causes the disease." .

example:ingredients a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ingredients" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A single ingredient used in the recipe, e.g. sugar, flour or garlic." .

example:inker a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "inker" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The individual who traces over the pencil drawings in ink after pencils are complete." .

example:insertion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "insertion" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place of attachment of a muscle, or what the muscle moves." .

example:installUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "installUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "URL at which the app may be installed, if different from the URL of the item." .

example:instructor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "instructor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person assigned to instruct or provide instructional assistance for the [[CourseInstance]]." .

example:instrument a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "instrument" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The object that helped the agent perform the action. e.g. John wrote a book with *a pen*." .

example:intensity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "intensity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Quantitative measure gauging the degree of force involved in the exercise, for example, heartbeats per minute. May include the velocity of the movement." .

example:interactingDrug a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interactingDrug" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Another drug that is known to interact with this drug in a way that impacts the effect of this drug or causes a risk to the patient. Note: disease interactions are typically captured as contraindications." .

example:interactionCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interactionCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This property is deprecated, alongside the UserInteraction types on which it depended." .

example:interactionService a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interactionService" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The WebSite or SoftwareApplication where the interactions took place." .

example:interactionStatistic a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interactionStatistic" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication. The most specific child type of InteractionCounter should be used." .

example:interactionType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interactionType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Action representing the type of interaction. For up votes, +1s, etc. use [[LikeAction]]. For down votes use [[DislikeAction]]. Otherwise, use the most specific Action." .

example:interactivityType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interactivityType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The predominant mode of learning supported by the learning resource. Acceptable values are 'active', 'expositive', or 'mixed'." .

example:interestRate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interestRate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The interest rate, charged or paid, applicable to the financial product. Note: This is different from the calculated annualPercentageRate." .

example:interpretedAsClaim a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interpretedAsClaim" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Used to indicate a specific claim contained, implied, translated or refined from the content of a [[MediaObject]] or other [[CreativeWork]]. The interpreting party can be indicated using [[claimInterpreter]]." .

example:inventoryLevel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "inventoryLevel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The current approximate inventory level for the item or items." .

example:inverseOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "inverseOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Relates a property to a property that is its inverse. Inverse properties relate the same pairs of items to each other, but in reversed direction. For example, the 'alumni' and 'alumniOf' properties are inverseOf each other. Some properties don't have explicit inverses; in these situations RDFa and JSON-LD syntax for reverse properties can be used." .

example:isAcceptingNewPatients a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isAcceptingNewPatients" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether the provider is accepting new patients." .

example:isAccessibleForFree a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isAccessibleForFree" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A flag to signal that the item, event, or place is accessible for free." .

example:isAccessoryOrSparePartFor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isAccessoryOrSparePartFor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to another product (or multiple products) for which this product is an accessory or spare part." .

example:isAvailableGenerically a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isAvailableGenerically" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "True if the drug is available in a generic form (regardless of name)." .

example:isBasedOn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isBasedOn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A resource from which this work is derived or from which it is a modification or adaption." .

example:isBasedOnUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isBasedOnUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A resource that was used in the creation of this resource. This term can be repeated for multiple sources. For example, http://example.com/great-multiplication-intro.html." .

example:isConsumableFor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isConsumableFor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to another product (or multiple products) for which this product is a consumable." .

example:isEncodedByBioChemEntity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isEncodedByBioChemEntity" ;
    ns2:source <http://www.bioschemas.org/Gene> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Another BioChemEntity encoding by this one." .

example:isFamilyFriendly a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isFamilyFriendly" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether this content is family friendly." .

example:isGift a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isGift" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Was the offer accepted as a gift for someone other than the buyer." .

example:isInvolvedInBiologicalProcess a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isInvolvedInBiologicalProcess" ;
    ns2:source <http://www.bioschemas.org/BioChemEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Biological process this BioChemEntity is involved in; please use PropertyValue if you want to include any evidence." .

example:isLiveBroadcast a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isLiveBroadcast" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "True if the broadcast is of a live event." .

example:isLocatedInSubcellularLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isLocatedInSubcellularLocation" ;
    ns2:source <http://www.bioschemas.org/BioChemEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Subcellular location where this BioChemEntity is located; please use PropertyValue if you want to include any evidence." .

example:isPartOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isPartOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of." .

example:isPartOfBioChemEntity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isPartOfBioChemEntity" ;
    ns2:source <http://www.bioschemas.org> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a BioChemEntity that is (in some sense) a part of this BioChemEntity. " .

example:isPlanForApartment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isPlanForApartment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates some accommodation that this floor plan describes." .

example:isProprietary a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isProprietary" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "True if this item's name is a proprietary/brand name (vs. generic name)." .

example:isRelatedTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isRelatedTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to another, somehow related product (or multiple products)." .

example:isResizable a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isResizable" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether the 3DModel allows resizing. For example, room layout applications often do not allow 3DModel elements to be resized to reflect reality." .

example:isSimilarTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isSimilarTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to another, functionally similar product (or multiple products)." .

example:isUnlabelledFallback a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isUnlabelledFallback" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This can be marked 'true' to indicate that some published [[DeliveryTimeSettings]] or [[ShippingRateSettings]] are intended to apply to all [[OfferShippingDetails]] published by the same merchant, when referenced by a [[shippingSettingsLink]] in those settings. It is not meaningful to use a 'true' value for this property alongside a transitTimeLabel (for [[DeliveryTimeSettings]]) or shippingLabel (for [[ShippingRateSettings]]), since this property is for use with unlabelled settings." .

example:isVariantOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isVariantOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the kind of product that this is a variant of. In the case of [[ProductModel]], this is a pointer (from a ProductModel) to a base product from which this product is a variant. It is safe to infer that the variant inherits all product features from the base model, unless defined locally. This is not transitive. In the case of a [[ProductGroup]], the group description also serves as a template, representing a set of Products that vary on explicitly defined, specific dimensions only (so it defines both a set of variants, as well as which values distinguish amongst those variants). When used with [[ProductGroup]], this property can apply to any [[Product]] included in the group." .

example:isbn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isbn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The ISBN of the book." .

example:isicV4 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isicV4" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The International Standard of Industrial Classification of All Economic Activities (ISIC), Revision 4 code for a particular organization, business person, or place." .

example:isrcCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isrcCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The International Standard Recording Code for the recording." .

example:issn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "issn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The International Standard Serial Number (ISSN) that identifies this serial publication. You can repeat this property to identify different formats of, or the linking ISSN (ISSN-L) for, this serial publication." .

example:issueNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "issueNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifies the issue of publication; for example, \"iii\" or \"2\"." .

example:issuedBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "issuedBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The organization issuing the ticket or permit." .

example:issuedThrough a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "issuedThrough" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The service through with the permit was granted." .

example:iswcCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "iswcCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The International Standard Musical Work Code for the composition." .

example:item a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "item" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An entity represented by an entry in a list or data feed (e.g. an 'artist' in a list of 'artists')â€™." .

example:itemCondition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemCondition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A predefined value from OfferItemCondition specifying the condition of the product or service, or the products or services included in the offer. Also used for product return policies to specify the condition of products accepted for returns." .

example:itemDefectReturnFees a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemDefectReturnFees" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of return fees for returns of defect products." .

example:itemDefectReturnLabelSource a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemDefectReturnLabelSource" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The method (from an enumeration) by which the customer obtains a return shipping label for a defect product." .

example:itemDefectReturnShippingFeesAmount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemDefectReturnShippingFeesAmount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Amount of shipping costs for defect product returns. Applicable when property [[itemDefectReturnFees]] equals [[ReturnShippingFees]]." .

example:itemListElement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemListElement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For itemListElement values, you can use simple strings (e.g. \"Peter\", \"Paul\", \"Mary\"), existing entities, or use ListItem.\\n\\nText values are best if the elements in the list are plain strings. Existing entities are best for a simple, unordered list of existing things in your data. ListItem is used with ordered lists when you want to provide additional context about the element in that list or when the same item might be in different places in different lists.\\n\\nNote: The order of elements in your mark-up is not sufficient for indicating the order or elements.  Use ListItem with a 'position' property in such cases." .

example:itemListOrder a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemListOrder" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Type of ordering (e.g. Ascending, Descending, Unordered)." .

example:itemLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Current location of the item." .

example:itemOffered a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemOffered" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An item being offered (or demanded). The transactional nature of the offer or demand is documented using [[businessFunction]], e.g. sell, lease etc. While several common expected types are listed explicitly in this definition, others can be used. Using a second type, such as Product or a subtype of Product, can clarify the nature of the offer." .

example:itemReviewed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemReviewed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The item that is being reviewed/rated." .

example:itemShipped a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itemShipped" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Item(s) being shipped." .

example:itinerary a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "itinerary" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Destination(s) ( [[Place]] ) that make up a trip. For a trip where destination order is important use [[ItemList]] to specify that order (see examples)." .

example:iupacName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "iupacName" ;
    ns2:source <http://www.bioschemas.org/MolecularEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Systematic method of naming chemical compounds as recommended by the International Union of Pure and Applied Chemistry (IUPAC)." .

example:jobBenefits a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jobBenefits" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of benefits associated with the job." .

example:jobImmediateStart a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jobImmediateStart" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An indicator as to whether a position is available for an immediate start." .

example:jobLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jobLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A (typically single) geographic location associated with the job position." .

example:jobLocationType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jobLocationType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the job location (e.g TELECOMMUTE for telecommute jobs)." .

example:jobStartDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jobStartDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date on which a successful applicant for this job would be expected to start work. Choose a specific date in the future or use the jobImmediateStart property to indicate the position is to be filled as soon as possible." .

example:jobTitle a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jobTitle" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The job title of the person (for example, Financial Manager)." .

example:jurisdiction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "jurisdiction" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a legal jurisdiction, e.g. of some legislation, or where some government service is based." .

example:keywords a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "keywords" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Keywords or tags used to describe this content. Multiple entries in a keywords list are typically delimited by commas." .

example:knownVehicleDamages a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "knownVehicleDamages" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A textual description of known damages, both repaired and unrepaired." .

example:knows a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "knows" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The most generic bi-directional social/work relation." .

example:knowsAbout a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "knowsAbout" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Of a [[Person]], and less typically of an [[Organization]], to indicate a topic that is known about - suggesting possible expertise but not implying it. We do not distinguish skill levels here, or relate this to educational content, events, objectives or [[JobPosting]] descriptions." .

example:knowsLanguage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "knowsLanguage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Of a [[Person]], and less typically of an [[Organization]], to indicate a known language. We do not distinguish skill levels or reading/writing/speaking/signing here. Use language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47)." .

example:labelDetails a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "labelDetails" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Link to the drug's label details." .

example:landlord a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "landlord" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The owner of the real estate property." .

example:language a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "language" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of instrument. The language used on this action." .

example:lastReviewed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lastReviewed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date on which the content on this web page was last reviewed for accuracy and/or completeness." .

example:latitude a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "latitude" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The latitude of a location. For example ```37.42242``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." .

example:layoutImage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "layoutImage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A schematic image showing the floorplan layout." .

example:learningResourceType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "learningResourceType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The predominant type or kind characterizing the learning resource. For example, 'presentation', 'handout'." .

example:leaseLength a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "leaseLength" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Length of the lease for some [[Accommodation]], either particular to some [[Offer]] or in some cases intrinsic to the property." .

example:legalName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legalName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The official name of the organization, e.g. the registered company name." .

example:legalStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legalStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The drug or supplement's legal status, including any controlled substance schedules that apply." .

example:legislationApplies a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationApplies" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#implements> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates that this legislation (or part of a legislation) somehow transfers another legislation in a different legislative context. This is an informative link, and it has no legal value. For legally-binding links of transposition, use the <a href=\"/legislationTransposes\">legislationTransposes</a> property. For example an informative consolidated law of a European Union's member state \"applies\" the consolidated version of the European Directive implemented in it." .

example:legislationChanges a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationChanges" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#changes> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Another legislation that this legislation changes. This encompasses the notions of amendment, replacement, correction, repeal, or other types of change. This may be a direct change (textual or non-textual amendment) or a consequential or indirect change. The property is to be used to express the existence of a change relationship between two acts rather than the existence of a consolidated version of the text that shows the result of the change. For consolidation relationships, use the <a href=\"/legislationConsolidates\">legislationConsolidates</a> property." .

example:legislationConsolidates a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationConsolidates" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#consolidates> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates another legislation taken into account in this consolidated legislation (which is usually the product of an editorial process that revises the legislation). This property should be used multiple times to refer to both the original version or the previous consolidated version, and to the legislations making the change." .

example:legislationDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationDate" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#date_document> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date of adoption or signature of the legislation. This is the date at which the text is officially aknowledged to be a legislation, even though it might not even be published or in force." .

example:legislationDateVersion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationDateVersion" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#version_date> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The point-in-time at which the provided description of the legislation is valid (e.g. : when looking at the law on the 2016-04-07 (= dateVersion), I get the consolidation of 2015-04-12 of the \"National Insurance Contributions Act 2015\")" .

example:legislationIdentifier a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationIdentifier" ;
    ns1:closeMatch <http://data.europa.eu/eli/ontology#id_local> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An identifier for the legislation. This can be either a string-based identifier, like the CELEX at EU level or the NOR in France, or a web-based, URL/URI identifier, like an ELI (European Legislation Identifier) or an URN-Lex." .

example:legislationJurisdiction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationJurisdiction" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#jurisdiction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The jurisdiction from which the legislation originates." .

example:legislationLegalForce a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationLegalForce" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#in_force> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether the legislation is currently in force, not in force, or partially in force." .

example:legislationLegalValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationLegalValue" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#legal_value> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The legal value of this legislation file. The same legislation can be written in multiple files with different legal values. Typically a digitally signed PDF have a \"stronger\" legal value than the HTML file of the same act." .

example:legislationPassedBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationPassedBy" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#passed_by> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person or organization that originally passed or made the law : typically parliament (for primary legislation) or government (for secondary legislation). This indicates the \"legal author\" of the law, as opposed to its physical author." .

example:legislationResponsible a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationResponsible" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#responsibility_of> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An individual or organization that has some kind of responsibility for the legislation. Typically the ministry who is/was in charge of elaborating the legislation, or the adressee for potential questions about the legislation once it is published." .

example:legislationTransposes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationTransposes" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#transposes> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates that this legislation (or part of legislation) fulfills the objectives set by another legislation, by passing appropriate implementation measures. Typically, some legislations of European Union's member states or regions transpose European Directives. This indicates a legally binding link between the 2 legislations." .

example:legislationType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "legislationType" ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#type_document> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of the legislation. Examples of values are \"law\", \"act\", \"directive\", \"decree\", \"regulation\", \"statutory instrument\", \"loi organique\", \"rÃ¨glement grand-ducal\", etc., depending on the country." .

example:leiCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "leiCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An organization identifier that uniquely identifies a legal entity as defined in ISO 17442." .

example:lender a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lender" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The person that lends the object being borrowed." .

example:lesser a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lesser" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This ordering relation for qualitative values indicates that the subject is lesser than the object." .

example:lesserOrEqual a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lesserOrEqual" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This ordering relation for qualitative values indicates that the subject is lesser than or equal to the object." .

example:letterer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "letterer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The individual who adds lettering, including speech balloons and sound effects, to artwork." .

example:license a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "license" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A license document that applies to this content, typically indicated by URL." .

example:line a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "line" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A line is a point-to-point path consisting of two or more points. A line is expressed as a series of two or more point objects separated by space." .

example:linkRelationship a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "linkRelationship" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the relationship type of a Web link. " .

example:liveBlogUpdate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "liveBlogUpdate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An update to the LiveBlog." .

example:loanMortgageMandateAmount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loanMortgageMandateAmount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Amount of mortgage mandate that can be converted into a proper mortgage at a later stage." .

example:loanPaymentAmount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loanPaymentAmount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of money to pay in a single payment." .

example:loanPaymentFrequency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loanPaymentFrequency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Frequency of payments due, i.e. number of months between payments. This is defined as a frequency, i.e. the reciprocal of a period of time." .

example:loanRepaymentForm a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loanRepaymentForm" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A form of paying back money previously borrowed from a lender. Repayment usually takes the form of periodic payments that normally include part principal plus interest in each payment." .

example:loanTerm a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loanTerm" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The duration of the loan or credit agreement." .

example:loanType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loanType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of a loan or credit." .

example:location a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "location" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location of, for example, where an event is happening, where an organization is located, or where an action takes place." .

example:locationCreated a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "locationCreated" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork." .

example:lodgingUnitDescription a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lodgingUnitDescription" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A full description of the lodging unit." .

example:lodgingUnitType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lodgingUnitType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Textual description of the unit type (including suite vs. room, size of bed, etc.)." .

example:logo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "logo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An associated logo." .

example:longitude a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "longitude" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The longitude of a location. For example ```-122.08585``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." .

example:loser a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "loser" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The loser of the action." .

example:lowPrice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lowPrice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The lowest price of all offers available.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

example:lyricist a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lyricist" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person who wrote the words." .

example:lyrics a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lyrics" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The words in the song." .

example:mainContentOfPage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mainContentOfPage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates if this web page element is the main subject of the page." .

example:mainEntity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mainEntity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the primary entity described in some page or other CreativeWork." .

example:mainEntityOfPage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mainEntityOfPage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a page (or other CreativeWork) for which this thing is the main entity being described. See [background notes](/docs/datamodel.html#mainEntityBackground) for details." .

example:maintainer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maintainer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A maintainer of a [[Dataset]], software package ([[SoftwareApplication]]), or other [[Project]]. A maintainer is a [[Person]] or [[Organization]] that manages contributions to, and/or publication of, some (typically complex) artifact. It is common for distributions of software and data to be based on "upstream" sources. When [[maintainer]] is applied to a specific version of something e.g. a particular version or packaging of a [[Dataset]], it is always  possible that the upstream source has a different maintainer. The [[isBasedOn]] property can be used to indicate such relationships between datasets to make the different maintenance roles clear. Similarly in the case of software, a package may have dedicated maintainers working on integration into software distributions such as Ubuntu, as well as upstream maintainers of the underlying work.
      """ .

example:makesOffer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "makesOffer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to products or services offered by the organization or person." .

example:manufacturer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "manufacturer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The manufacturer of the product." .

example:map a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "map" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A URL to a map of the place." .

example:mapType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mapType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the kind of Map, from the MapCategoryType Enumeration." .

example:maps a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maps" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A URL to a map of the place." .

example:marginOfError a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "marginOfError" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A marginOfError for an [[Observation]]." .

example:masthead a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "masthead" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For a [[NewsMediaOrganization]], a link to the masthead page or a page listing top editorial management." .

example:material a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "material" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A material that something is made from, e.g. leather, wool, cotton, paper." .

example:materialExtent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "materialExtent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The quantity of the materials being described or an expression of the physical space they occupy." .

example:mathExpression a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mathExpression" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A mathematical expression (e.g. 'x^2-3x=0') that may be solved for a specific variable, simplified, or transformed. This can take many formats, e.g. LaTeX, Ascii-Math, or math as you would write with a keyboard." .

example:maxPrice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maxPrice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The highest price if the price is a range." .

example:maxValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maxValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The upper value of some characteristic or property." .

example:maximumAttendeeCapacity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maximumAttendeeCapacity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total number of individuals that may attend an event or venue." .

example:maximumEnrollment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maximumEnrollment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The maximum number of students who may be enrolled in the program." .

example:maximumIntake a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maximumIntake" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Recommended intake of this supplement for a given population as defined by a specific recommending authority." .

example:maximumPhysicalAttendeeCapacity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maximumPhysicalAttendeeCapacity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The maximum physical attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OfflineEventAttendanceMode]] (or the offline aspects, in the case of a [[MixedEventAttendanceMode]]). " .

example:maximumVirtualAttendeeCapacity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maximumVirtualAttendeeCapacity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The maximum physical attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OnlineEventAttendanceMode]] (or the online aspects, in the case of a [[MixedEventAttendanceMode]]). " .

example:mealService a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mealService" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of the meals that will be provided or available for purchase." .

example:measuredProperty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "measuredProperty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The measuredProperty of an [[Observation]], either a schema.org property, a property from other RDF-compatible systems e.g. W3C RDF Data Cube, or schema.org extensions such as [GS1's](https://www.gs1.org/voc/?show=properties)." .

example:measuredValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "measuredValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The measuredValue of an [[Observation]]." .

example:measurementTechnique a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "measurementTechnique" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A technique or technology used in a [[Dataset]] (or [[DataDownload]], [[DataCatalog]]),
corresponding to the method used for measuring the corresponding variable(s) (described using [[variableMeasured]]). This is oriented towards scientific and scholarly dataset publication but may have broader applicability; it is not intended as a full representation of measurement, but rather as a high level summary for dataset discovery.

For example, if [[variableMeasured]] is: molecule concentration, [[measurementTechnique]] could be: "mass spectrometry" or "nmr spectroscopy" or "colorimetry" or "immunofluorescence".

If the [[variableMeasured]] is "depression rating", the [[measurementTechnique]] could be "Zung Scale" or "HAM-D" or "Beck Depression Inventory".

If there are several [[variableMeasured]] properties recorded for some given data object, use a [[PropertyValue]] for each [[variableMeasured]] and attach the corresponding [[measurementTechnique]].
      """ .

example:mechanismOfAction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mechanismOfAction" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The specific biochemical interaction through which this drug or supplement produces its pharmacological effect." .

example:mediaAuthenticityCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mediaAuthenticityCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a MediaManipulationRatingEnumeration classification of a media object (in the context of how it was published or shared)." .

example:mediaItemAppearance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mediaItemAppearance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "In the context of a [[MediaReview]], indicates specific media item(s) that are grouped using a [[MediaReviewItem]]." .

example:median a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "median" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The median value." .

example:medicalAudience a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "medicalAudience" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Medical audience for page." .

example:medicalSpecialty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "medicalSpecialty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical specialty of the provider." .

example:medicineSystem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "medicineSystem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The system of medicine that includes this MedicalEntity, for example 'evidence-based', 'homeopathic', 'chiropractic', etc." .

example:meetsEmissionStandard a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "meetsEmissionStandard" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates that the vehicle meets the respective emission standard." .

example:member a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "member" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals." .

example:memberOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "memberOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An Organization (or ProgramMembership) to which this Person or Organization belongs." .

example:members a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "members" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A member of this organization." .

example:membershipNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "membershipNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A unique identifier for the membership." .

example:membershipPointsEarned a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "membershipPointsEarned" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of membership points earned by the member. If necessary, the unitText can be used to express the units the points are issued in. (e.g. stars, miles, etc.)" .

example:memoryRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "memoryRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Minimum memory requirements." .

example:mentions a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mentions" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept." .

example:menu a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "menu" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Either the actual menu as a structured representation, as text, or a URL of the menu." .

example:menuAddOn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "menuAddOn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Additional menu item(s) such as a side dish of salad or side order of fries that can be added to this menu item. Additionally it can be a menu section containing allowed add-on menu items for this menu item." .

example:merchant a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "merchant" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "'merchant' is an out-dated term for 'seller'." .

example:merchantReturnDays a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "merchantReturnDays" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies either a fixed return date or the number of days (from the delivery date) that a product can be returned. Used when the [[returnPolicyCategory]] property is specified as [[MerchantReturnFiniteReturnWindow]]." .

example:merchantReturnLink a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "merchantReturnLink" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies a Web page or service by URL, for product returns." .

example:messageAttachment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "messageAttachment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A CreativeWork attached to the message." .

example:mileageFromOdometer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mileageFromOdometer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total distance travelled by the particular vehicle since its initial production, as read from its odometer.\\n\\nTypical unit code(s): KMT for kilometers, SMI for statute miles" .

example:minPrice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "minPrice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The lowest price if the price is a range." .

example:minValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "minValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The lower value of some characteristic or property." .

example:minimumPaymentDue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "minimumPaymentDue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The minimum payment required at this time." .

example:missionCoveragePrioritiesPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "missionCoveragePrioritiesPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For a [[NewsMediaOrganization]], a statement on coverage priorities, including any public agenda or stance on issues." .

example:model a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "model" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The model of the product. Use with the URL of a ProductModel or a textual representation of the model identifier. The URL of the ProductModel can be from an external source. It is recommended to additionally provide strong product identifiers via the gtin8/gtin13/gtin14 and mpn properties." .

example:modelDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "modelDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The release date of a vehicle model (often used to differentiate versions of the same make and model)." .

example:modifiedTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "modifiedTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date and time the reservation was modified." .

example:molecularFormula a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "molecularFormula" ;
    ns2:source <http://www.bioschemas.org/MolecularEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The empirical formula is the simplest whole number ratio of all the atoms in a molecule." .

example:molecularWeight a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "molecularWeight" ;
    ns2:source <http://www.bioschemas.org/MolecularEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This is the molecular weight of the entity being described, not of the parent. Units should be included in the form '&lt;Number&gt; &lt;unit&gt;', for example '12 amu' or as '&lt;QuantitativeValue&gt;." .

example:monoisotopicMolecularWeight a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "monoisotopicMolecularWeight" ;
    ns2:source <http://www.bioschemas.org/MolecularEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The monoisotopic mass is the sum of the masses of the atoms in a molecule using the unbound, ground-state, rest mass of the principal (most abundant) isotope for each element instead of the isotopic average mass. Please include the units the form '&lt;Number&gt; &lt;unit&gt;', for example '770.230488 g/mol' or as '&lt;QuantitativeValue&gt;." .

example:monthlyMinimumRepaymentAmount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "monthlyMinimumRepaymentAmount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The minimum payment is the lowest amount of money that one is required to pay on a credit card statement each month." .

example:monthsOfExperience a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "monthsOfExperience" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the minimal number of months of experience required for a position." .

example:mpn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mpn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Manufacturer Part Number (MPN) of the product, or the product to which the offer refers." .

example:multipleValues a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "multipleValues" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether multiple values are allowed for the property.  Default is false." .

example:muscleAction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "muscleAction" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The movement the muscle generates." .

example:musicArrangement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "musicArrangement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An arrangement derived from the composition." .

example:musicBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "musicBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The composer of the soundtrack." .

example:musicCompositionForm a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "musicCompositionForm" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of composition (e.g. overture, sonata, symphony, etc.)." .

example:musicGroupMember a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "musicGroupMember" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A member of a music group&#x2014;for example, John, Paul, George, or Ringo." .

example:musicReleaseFormat a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "musicReleaseFormat" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Format of this release (the type of recording media used, ie. compact disc, digital media, LP, etc.)." .

example:musicalKey a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "musicalKey" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The key, mode, or scale this composition uses." .

example:naics a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "naics" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The North American Industry Classification System (NAICS) code for a particular organization or business person." .

example:name a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name of the item." .

example:namedPosition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "namedPosition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A position played, performed or filled by a person or organization, as part of an organization. For example, an athlete in a SportsTeam might play in the position named 'Quarterback'." .

example:nationality a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nationality" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Nationality of the person." .

example:naturalProgression a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "naturalProgression" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The expected progression of the condition if it is not treated and allowed to progress naturally." .

example:negativeNotes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "negativeNotes" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates, in the context of a [[Review]] (e.g. framed as 'pro' vs 'con' considerations), negative considerations - either as unstructured text, or a list." .

example:nerve a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nerve" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The underlying innervation associated with the muscle." .

example:nerveMotor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nerveMotor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The neurological pathway extension that involves muscle control." .

example:netWorth a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "netWorth" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total financial value of the person as calculated by subtracting assets from liabilities." .

example:newsUpdatesAndGuidelines a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "newsUpdatesAndGuidelines" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a page with news updates and guidelines. This could often be (but is not required to be) the main page containing [[SpecialAnnouncement]] markup on a site." .

example:nextItem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nextItem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A link to the ListItem that follows the current one." .

example:noBylinesPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "noBylinesPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For a [[NewsMediaOrganization]] or other news-related [[Organization]], a statement explaining when authors of articles are not named in bylines." .

example:nonEqual a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nonEqual" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This ordering relation for qualitative values indicates that the subject is not equal to the object." .

example:nonProprietaryName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nonProprietaryName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The generic name of this drug or supplement." .

example:nonprofitStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nonprofitStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "nonprofit Status indicates the legal status of a non-profit organization in its primary place of business." .

example:normalRange a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "normalRange" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Range of acceptable values for a typical patient, when applicable." .

example:nsn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nsn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the [NATO stock number](https://en.wikipedia.org/wiki/NATO_Stock_Number) (nsn) of a [[Product]]. " .

example:numAdults a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numAdults" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of adults staying in the unit." .

example:numChildren a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numChildren" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of children staying in the unit." .

example:numConstraints a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numConstraints" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the number of constraints (not counting [[populationType]]) defined for a particular [[StatisticalPopulation]]. This helps applications understand if they have access to a sufficiently complete description of a [[StatisticalPopulation]]." .

example:numTracks a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numTracks" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of tracks in this album or playlist." .

example:numberOfAccommodationUnits a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfAccommodationUnits" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the total (available plus unavailable) number of accommodation units in an [[ApartmentComplex]], or the number of accommodation units for a specific [[FloorPlan]] (within its specific [[ApartmentComplex]]). See also [[numberOfAvailableAccommodationUnits]]." .

example:numberOfAirbags a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfAirbags" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number or type of airbags in the vehicle." .

example:numberOfAvailableAccommodationUnits a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfAvailableAccommodationUnits" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the number of available accommodation units in an [[ApartmentComplex]], or the number of accommodation units for a specific [[FloorPlan]] (within its specific [[ApartmentComplex]]). See also [[numberOfAccommodationUnits]]." .

example:numberOfAxles a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfAxles" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of axles.\\n\\nTypical unit code(s): C62" .

example:numberOfBathroomsTotal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfBathroomsTotal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total integer number of bathrooms in a some [[Accommodation]], following real estate conventions as [documented in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsTotalInteger+Field): \"The simple sum of the number of bathrooms. For example for a property with two Full Bathrooms and one Half Bathroom, the Bathrooms Total Integer will be 3.\". See also [[numberOfRooms]]." .

example:numberOfBedrooms a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfBedrooms" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total integer number of bedrooms in a some [[Accommodation]], [[ApartmentComplex]] or [[FloorPlan]]." .

example:numberOfBeds a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfBeds" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The quantity of the given bed type available in the HotelRoom, Suite, House, or Apartment." .

example:numberOfCredits a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfCredits" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of credits or units awarded by a Course or required to complete an EducationalOccupationalProgram." .

example:numberOfDoors a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfDoors" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of doors.\\n\\nTypical unit code(s): C62" .

example:numberOfEmployees a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfEmployees" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of employees in an organization e.g. business." .

example:numberOfEpisodes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfEpisodes" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of episodes in this season or series." .

example:numberOfForwardGears a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfForwardGears" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total number of forward gears available for the transmission system of the vehicle.\\n\\nTypical unit code(s): C62" .

example:numberOfFullBathrooms a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfFullBathrooms" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Number of full bathrooms - The total number of full and Â¾ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsFull field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsFull+Field)." .

example:numberOfItems a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfItems" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of items in an ItemList. Note that some descriptions might not fully describe all items in a list (e.g., multi-page pagination); in such cases, the numberOfItems would be for the entire list." .

example:numberOfLoanPayments a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfLoanPayments" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of payments contractually required at origination to repay the loan. For monthly paying loans this is the number of months from the contractual first payment date to the maturity date." .

example:numberOfPages a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfPages" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of pages in the book." .

example:numberOfPartialBathrooms a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfPartialBathrooms" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Number of partial bathrooms - The total number of half and Â¼ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsPartial field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsPartial+Field). " .

example:numberOfPlayers a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfPlayers" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicate how many people can play this game (minimum, maximum, or range)." .

example:numberOfPreviousOwners a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfPreviousOwners" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of owners of the vehicle, including the current one.\\n\\nTypical unit code(s): C62" .

example:numberOfRooms a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfRooms" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The number of rooms (excluding bathrooms and closets) of the accommodation or lodging business.
Typical unit code(s): ROM for room or C62 for no unit. The type of room can be put in the unitText property of the QuantitativeValue.""" .

example:numberOfSeasons a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberOfSeasons" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of seasons in this series." .

example:numberedPosition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "numberedPosition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A number associated with a role in an organization, for example, the number on an athlete's jersey." .

example:nutrition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nutrition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Nutrition information about the recipe or menu item." .

example:object a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "object" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The object upon which the action is carried out, whose state is kept intact or changed. Also known as the semantic roles patient, affected or undergoer (which change their state) or theme (which doesn't). e.g. John read *a book*." .

example:observationDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "observationDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The observationDate of an [[Observation]]." .

example:observedNode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "observedNode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The observedNode of an [[Observation]], often a [[StatisticalPopulation]]." .

example:occupancy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occupancy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The allowed total occupancy for the accommodation in persons (including infants etc). For individual accommodations, this is not necessarily the legal maximum but defines the permitted usage as per the contractual agreement (e.g. a double room used by a single person).
Typical unit code(s): C62 for person""" .

example:occupationLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occupationLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note " The region/country for which this occupational description is appropriate. Note that educational requirements and qualifications can vary between jurisdictions." .

example:occupationalCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occupationalCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A category describing the job, preferably using a term from a taxonomy such as [BLS O*NET-SOC](http://www.onetcenter.org/taxonomy.html), [ISCO-08](https://www.ilo.org/public/english/bureau/stat/isco/isco08/) or similar, with the property repeated for each applicable value. Ideally the taxonomy should be identified, and both the textual label and formal code for the category should be provided.\\n
Note: for historical reasons, any textual label and formal code provided as a literal may be assumed to be from O*NET-SOC.""" .

example:occupationalCredentialAwarded a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occupationalCredentialAwarded" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the qualification, award, certificate, diploma or other occupational credential awarded as a consequence of successful completion of this course or program." .

example:offerCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "offerCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of offers for the product." .

example:offeredBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "offeredBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to the organization or person making the offer." .

example:offers a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "offers" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """An offer to provide this item&#x2014;for example, an offer to sell a product, rent the DVD of a movie, perform a service, or give away tickets to an event. Use [[businessFunction]] to indicate the kind of transaction offered, i.e. sell, lease, etc. This property can also be used to describe a [[Demand]]. While this property is listed as expected on a number of common types, it can be used in others. In that case, using a second type, such as Product or a subtype of Product, can clarify the nature of the offer.
      """ .

example:offersPrescriptionByMail a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "offersPrescriptionByMail" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether prescriptions can be delivered by mail." .

example:openingHours a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "openingHours" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The general opening hours for a business. Opening hours can be specified as a weekly time range, starting with days, then times per day. Multiple days can be listed with commas ',' separating each day. Day or time ranges are specified using a hyphen '-'.\\n\\n* Days are specified using the following two-letter combinations: ```Mo```, ```Tu```, ```We```, ```Th```, ```Fr```, ```Sa```, ```Su```.\\n* Times are specified using 24:00 format. For example, 3pm is specified as ```15:00```, 10am as ```10:00```. \\n* Here is an example: <code>&lt;time itemprop=\"openingHours\" datetime=&quot;Tu,Th 16:00-20:00&quot;&gt;Tuesdays and Thursdays 4-8pm&lt;/time&gt;</code>.\\n* If a business is open 7 days a week, then it can be specified as <code>&lt;time itemprop=&quot;openingHours&quot; datetime=&quot;Mo-Su&quot;&gt;Monday through Sunday, all day&lt;/time&gt;</code>." .

example:openingHoursSpecification a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "openingHoursSpecification" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The opening hours of a certain place." .

example:opens a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "opens" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The opening hour of the place or service on the given day(s) of the week." .

example:operatingSystem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "operatingSystem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Operating systems supported (Windows 7, OSX 10.6, Android 1.6)." .

example:opponent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "opponent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The opponent on this action." .

example:option a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "option" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of object. The options subject to this action." .

example:orderDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date order was placed." .

example:orderDelivery a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderDelivery" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The delivery of the parcel related to this order or order item." .

example:orderItemNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderItemNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The identifier of the order item." .

example:orderItemStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderItemStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The current status of the order item." .

example:orderNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The identifier of the transaction." .

example:orderQuantity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderQuantity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of the item ordered. If the property is not set, assume the quantity is one." .

example:orderStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The current status of the order." .

example:orderedItem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "orderedItem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The item ordered." .

example:organizer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "organizer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An organizer of an Event." .

example:originAddress a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "originAddress" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Shipper's address." .

example:originalMediaContextDescription a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "originalMediaContextDescription" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Describes, in a [[MediaReview]] when dealing with [[DecontextualizedContent]], background information that can contribute to better interpretation of the [[MediaObject]]." .

example:originalMediaLink a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "originalMediaLink" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Link to the page containing an original version of the content, or directly to an online copy of the original [[MediaObject]] content, e.g. video file." .

example:originatesFrom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "originatesFrom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The vasculature the lymphatic structure originates, or afferents, from." .

example:overdosage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "overdosage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any information related to overdose on a drug, including signs or symptoms, treatments, contact information for emergency response." .

example:ownedFrom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ownedFrom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date and time of obtaining the product." .

example:ownedThrough a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ownedThrough" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date and time of giving up ownership on the product." .

example:ownershipFundingInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ownershipFundingInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a description of organizational ownership structure; funding and grants. In a news/media setting, this is with particular reference to editorial independence.   Note that the [[funder]] is also available and can be used to make basic funder information machine-readable." .

example:owns a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "owns" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Products owned by the organization or person." .

example:pageEnd a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pageEnd" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The page on which the work ends; for example \"138\" or \"xvi\"." .

example:pageStart a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pageStart" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The page on which the work starts; for example \"135\" or \"xiii\"." .

example:pagination a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pagination" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any description of pages that is not separated into pageStart and pageEnd; for example, \"1-6, 9, 55\" or \"10-12, 46-49\"." .

example:parent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A parent of this person." .

example:parentItem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parentItem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The parent of a question, answer or item in general." .

example:parentOrganization a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parentOrganization" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The larger organization that this organization is a [[subOrganization]] of, if any." .

example:parentService a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parentService" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A broadcast service to which the broadcast service may belong to such as regional variations of a national channel." .

example:parentTaxon a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parentTaxon" ;
    ns2:source <http://www.bioschemas.org/Taxon> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Closest parent taxon of the taxon in question." .

example:parents a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parents" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A parents of the person." .

example:partOfEpisode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfEpisode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The episode to which this clip belongs." .

example:partOfInvoice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfInvoice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The order is being paid as part of the referenced Invoice." .

example:partOfOrder a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfOrder" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The overall order the items in this delivery were included in." .

example:partOfSeason a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfSeason" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The season to which this episode belongs." .

example:partOfSeries a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfSeries" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The series to which this episode or season belongs." .

example:partOfSystem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfSystem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The anatomical or organ system that this structure is part of." .

example:partOfTVSeries a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfTVSeries" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The TV series to which this episode or season belongs." .

example:partOfTrip a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partOfTrip" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifies that this [[Trip]] is a subTrip of another Trip.  For example Day 1, Day 2, etc. of a multi-day trip." .

example:participant a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "participant" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Other co-agents that participated in the action indirectly. e.g. John wrote a book with *Steve*." .

example:partySize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "partySize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Number of people the reservation should accommodate." .

example:passengerPriorityStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "passengerPriorityStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The priority status assigned to a passenger for security or boarding (e.g. FastTrack or Priority)." .

example:passengerSequenceNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "passengerSequenceNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The passenger's sequence number as assigned by the airline." .

example:pathophysiology a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pathophysiology" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Changes in the normal mechanical, physical, and biochemical functions that are associated with this activity or condition." .

example:pattern a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pattern" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pattern that something has, for example 'polka dot', 'striped', 'Canadian flag'. Values are typically expressed as text, although links to controlled value schemes are also supported." .

example:payload a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "payload" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The permitted weight of passengers and cargo, EXCLUDING the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: Many databases specify the permitted TOTAL weight instead, which is the sum of [[weight]] and [[payload]]\\n* Note 2: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 3: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 4: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:paymentAccepted a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentAccepted" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Cash, Credit Card, Cryptocurrency, Local Exchange Tradings System, etc." .

example:paymentDue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentDue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date that payment is due." .

example:paymentDueDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentDueDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date that payment is due." .

example:paymentMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name of the credit card or other method of payment for the order." .

example:paymentMethodId a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentMethodId" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An identifier for the method of payment used (e.g. the last 4 digits of the credit card)." .

example:paymentStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The status of payment; whether the invoice has been paid or not." .

example:paymentUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paymentUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The URL for sending a payment." .

example:penciler a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "penciler" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The individual who draws the primary narrative artwork." .

example:percentile10 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "percentile10" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The 10th percentile value." .

example:percentile25 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "percentile25" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The 25th percentile value." .

example:percentile75 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "percentile75" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The 75th percentile value." .

example:percentile90 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "percentile90" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The 90th percentile value." .

example:performTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "performTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The length of time it takes to perform instructions or a direction (not including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

example:performer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "performer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A performer at the event&#x2014;for example, a presenter, musician, musical group or actor." .

example:performerIn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "performerIn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Event that this person is a performer or participant in." .

example:performers a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "performers" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The main performer or performers of the event&#x2014;for example, a presenter, musician, or actor." .

example:permissionType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "permissionType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of permission granted the person, organization, or audience." .

example:permissions a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "permissions" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Permission(s) required to run the app (for example, a mobile app may require full internet access or may run only on wifi)." .

example:permitAudience a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "permitAudience" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The target audience for this permit." .

example:permittedUsage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "permittedUsage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indications regarding the permitted usage of the accommodation." .

example:petsAllowed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "petsAllowed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether pets are allowed to enter the accommodation or lodging business. More detailed information can be put in a text value." .

example:phoneticText a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "phoneticText" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Representation of a text [[textValue]] using the specified [[speechToTextMarkup]]. For example the city name of Houston in IPA: /ËˆhjuËstÉ™n/." .

example:photo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "photo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A photograph of this place." .

example:photos a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "photos" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Photographs of this place." .

example:physicalRequirement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "physicalRequirement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the types of physical activity associated with the job. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." .

example:physiologicalBenefits a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "physiologicalBenefits" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specific physiologic benefits associated to the plan." .

example:pickupLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pickupLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Where a taxi will pick up a passenger or a rental car can be picked up." .

example:pickupTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pickupTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "When a taxi will pickup a passenger or a rental car can be picked up." .

example:playMode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "playMode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether this game is multi-player, co-op or single-player.  The game can be marked as multi-player, co-op and single-player at the same time." .

example:playerType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "playerType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Player type required&#x2014;for example, Flash or Silverlight." .

example:playersOnline a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "playersOnline" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Number of players on the server." .

example:polygon a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "polygon" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A polygon is the area enclosed by a point-to-point path for which the starting and ending points are the same. A polygon is expressed as a series of four or more space delimited points where the first and final points are identical." .

example:populationType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "populationType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the populationType common to all members of a [[StatisticalPopulation]]." .

example:position a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "position" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The position of an item in a series or sequence of items." .

example:positiveNotes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "positiveNotes" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates, in the context of a [[Review]] (e.g. framed as 'pro' vs 'con' considerations), positive considerations - either as unstructured text, or a list." .

example:possibleComplication a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "possibleComplication" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A possible unexpected and unfavorable evolution of a medical condition. Complications may include worsening of the signs or symptoms of the disease, extension of the condition to other organ systems, etc." .

example:possibleTreatment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "possibleTreatment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A possible treatment to address this condition, sign or symptom." .

example:postOfficeBoxNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postOfficeBoxNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The post office box number for PO box addresses." .

example:postOp a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postOp" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the postoperative procedures, care, and/or followups for this device." .

example:postalCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postalCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The postal code. For example, 94043." .

example:postalCodeBegin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postalCodeBegin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "First postal code in a range (included)." .

example:postalCodeEnd a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postalCodeEnd" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Last postal code in the range (included). Needs to be after [[postalCodeBegin]]." .

example:postalCodePrefix a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postalCodePrefix" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A defined range of postal codes indicated by a common textual prefix. Used for non-numeric systems such as UK." .

example:postalCodeRange a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "postalCodeRange" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A defined range of postal codes." .

example:potentialAction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "potentialAction" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a potential Action, which describes an idealized action in which this thing would play an 'object' role." .

example:potentialUse a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "potentialUse" ;
    ns2:source <http://www.bioschemas.org/ChemicalSubstance> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Intended use of the BioChemEntity by humans." .

example:preOp a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "preOp" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the workup, testing, and other preparations required before implanting this device." .

example:predecessorOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "predecessorOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer from a previous, often discontinued variant of the product to its newer variant." .

example:pregnancyCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pregnancyCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Pregnancy category of this drug." .

example:pregnancyWarning a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pregnancyWarning" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any precaution, guidance, contraindication, etc. related to this drug's use during pregnancy." .

example:prepTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "prepTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The length of time it takes to prepare the items to be used in instructions or a direction, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

example:preparation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "preparation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Typical preparation that a patient must undergo before having the procedure performed." .

example:prescribingInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "prescribingInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Link to prescribing information for the drug." .

example:prescriptionStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "prescriptionStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the status of drug prescription eg. local catalogs classifications or whether the drug is available by prescription or over-the-counter, etc." .

example:previousItem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "previousItem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A link to the ListItem that preceeds the current one." .

example:previousStartDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "previousStartDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Used in conjunction with eventStatus for rescheduled or cancelled events. This property contains the previously scheduled start date. For rescheduled events, the startDate property should be used for the newly scheduled start date. In the (rare) case of an event that has been postponed and rescheduled multiple times, this field may be repeated." .

example:price a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "price" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The offer price of a product, or of a price component when attached to PriceSpecification and its subtypes.\\n\\nUsage guidelines:\\n\\n* Use the [[priceCurrency]] property (with standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. "USD"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. "BTC"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. "Ithaca HOUR") instead of including [ambiguous symbols](http://en.wikipedia.org/wiki/Dollar_sign#Currencies_that_use_the_dollar_or_peso_sign) such as '$' in the value.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.\\n* Note that both [RDFa](http://www.w3.org/TR/xhtml-rdfa-primer/#using-the-content-attribute) and Microdata syntax allow the use of a "content=" attribute for publishing simple machine-readable values alongside more human-friendly formatting.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.
      """ .

example:priceComponent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceComponent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This property links to all [[UnitPriceSpecification]] nodes that apply in parallel for the [[CompoundPriceSpecification]] node." .

example:priceComponentType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceComponentType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifies a price component (for example, a line item on an invoice), part of the total price for an offer." .

example:priceCurrency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceCurrency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The currency of the price, or a price component when attached to [[PriceSpecification]] and its subtypes.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." .

example:priceRange a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceRange" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The price range of the business, for example ```$$$```." .

example:priceSpecification a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceSpecification" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "One or more detailed price specifications, indicating the unit price and delivery or payment charges." .

example:priceType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Defines the type of a price specified for an offered product, for example a list price, a (temporary) sale price or a manufacturer suggested retail price. If multiple prices are specified for an offer the [[priceType]] property can be used to identify the type of each such specified price. The value of priceType can be specified as a value from enumeration PriceTypeEnumeration or as a free form text string for price types that are not already predefined in PriceTypeEnumeration." .

example:priceValidUntil a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "priceValidUntil" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date after which the price is no longer available." .

example:primaryImageOfPage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "primaryImageOfPage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the main image on the page." .

example:primaryPrevention a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "primaryPrevention" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A preventative therapy used to prevent an initial occurrence of the medical condition, such as vaccination." .

example:printColumn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "printColumn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of the column in which the NewsArticle appears in the print edition." .

example:printEdition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "printEdition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The edition of the print product in which the NewsArticle appears." .

example:printPage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "printPage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "If this NewsArticle appears in print, this field indicates the name of the page on which the article is found. Please note that this field is intended for the exact page name (e.g. A5, B18)." .

example:printSection a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "printSection" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "If this NewsArticle appears in print, this field indicates the print section in which the article appeared." .

example:procedure a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "procedure" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the procedure involved in setting up, using, and/or installing the device." .

example:procedureType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "procedureType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of procedure, for example Surgical, Noninvasive, or Percutaneous." .

example:processingTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
