example:benefits a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "benefits" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of benefits associated with the job." .

example:benefitsSummaryUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "benefitsSummaryUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The URL that goes directly to the summary of benefits and coverage for the specific standard plan or plan variation." .

example:bestRating a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bestRating" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The highest value allowed in this rating system. If bestRating is omitted, 5 is assumed." .

example:billingAddress a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "billingAddress" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The billing address for the order." .

example:billingDuration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "billingDuration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies for how long this price (or price component) will be billed. Can be used, for example, to model the contractual duration of a subscription or payment plan. Type can be either a Duration or a Number (in which case the unit of measurement, for example month, is specified by the unitCode property)." .

example:billingIncrement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "billingIncrement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "This property specifies the minimal quantity and rounding increment that will be the basis for the billing. The unit of measurement is specified by the unitCode property." .

example:billingPeriod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "billingPeriod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time interval used to compute the invoice." .

example:billingStart a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "billingStart" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies after how much time this price (or price component) becomes valid and billing starts. Can be used, for example, to model a price increase after the first year of a subscription. The unit of measurement is specified by the unitCode property." .

example:bioChemInteraction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bioChemInteraction" ;
    ns2:source <http://www.bioschemas.org> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A BioChemEntity that is known to interact with this item." .

example:bioChemSimilarity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bioChemSimilarity" ;
    ns2:source <http://www.bioschemas.org> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A similar BioChemEntity, e.g., obtained by fingerprint similarity algorithms." .

example:biologicalRole a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biologicalRole" ;
    ns2:source <http://www.bioschemas.org> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A role played by the BioChemEntity within a biological context." .

example:biomechnicalClass a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biomechnicalClass" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The biomechanical properties of the bone." .

example:birthDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "birthDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date of birth." .

example:birthPlace a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "birthPlace" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place where the person was born." .

example:bitrate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bitrate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The bitrate of the media object." .

example:blogPost a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "blogPost" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A posting that is part of this blog." .

example:blogPosts a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "blogPosts" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a post that is part of a [[Blog]]. Note that historically, what we term a \"Blog\" was once known as a \"weblog\", and that what we term a \"BlogPosting\" is now often colloquially referred to as a \"blog\"." .

example:bloodSupply a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bloodSupply" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The blood vessel that carries blood from the heart to the muscle." .

example:boardingGroup a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "boardingGroup" ;
    ns1:inScheme <http://example.org/example> ;
