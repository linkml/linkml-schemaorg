    ns1:exactMatch <http://schema.org/AskAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of posing a question / favor to someone.\\n\\nRelated actions:\\n\\n* [[ReplyAction]]: Appears generally as a response to AskAction." .

example:AskPublicNewsArticle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AskPublicNewsArticle" ;
    rdfs:subClassOf example:NewsArticle ;
    ns1:exactMatch <http://schema.org/AskPublicNewsArticle> ;
    ns1:inScheme <http://example.org/example> ;
