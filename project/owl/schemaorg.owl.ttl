example:about a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "about" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The subject matter of the content." .

example:abridged a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "abridged" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether the book is an abridged edition." .

example:abstract a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "abstract" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An abstract is a short description that summarizes a [[CreativeWork]]." .

example:accelerationTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accelerationTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time needed to accelerate the vehicle from a given start velocity to a given target velocity.\\n\\nTypical unit code(s): SEC for seconds\\n\\n* Note: There are unfortunately no standard unit codes for seconds/0..100 km/h or seconds/0..60 mph. Simply use \"SEC\" for seconds and indicate the velocities in the [[name]] of the [[QuantitativeValue]], or use [[valueReference]] with a [[QuantitativeValue]] of 0..60 mph or 0..100 km/h to specify the reference speeds." .

example:acceptedAnswer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acceptedAnswer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The answer(s) that has been accepted as best, typically on a Question/Answer site. Sites vary in their selection mechanisms, e.g. drawing on community opinion and/or the view of the Question author." .

example:acceptedOffer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acceptedOffer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The offer(s) -- e.g., product, quantity and price combinations -- included in the order." .

example:acceptedPaymentMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acceptedPaymentMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The payment method(s) accepted by seller for this offer." .

example:acceptsReservations a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acceptsReservations" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether a FoodEstablishment accepts reservations. Values can be Boolean, an URL at which reservations can be made or (for backwards compatibility) the strings ```Yes``` or ```No```." .

example:accessCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Password, PIN, or access code needed for delivery (e.g. from a locker)." .

example:accessMode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessMode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The human sensory perceptual system or cognitive faculty through which a person may process or perceive information. Expected values include: auditory, tactile, textual, visual, colorDependent, chartOnVisual, chemOnVisual, diagramOnVisual, mathOnVisual, musicOnVisual, textOnVisual.
      """ .

example:accessModeSufficient a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessModeSufficient" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A list of single or combined accessModes that are sufficient to understand all the intellectual content of a resource. Expected values include:  auditory, tactile, textual, visual.
      """ .

example:accessibilityAPI a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessibilityAPI" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates that the resource is compatible with the referenced accessibility API ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." .

example:accessibilityControl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessibilityControl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifies input methods that are sufficient to fully control the described resource ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." .

example:accessibilityFeature a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessibilityFeature" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Content features of the resource, such as accessible media, alternatives and supported enhancements for accessibility ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." .

example:accessibilityHazard a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessibilityHazard" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A characteristic of the described resource that is physiologically dangerous to some users. Related to WCAG 2.0 guideline 2.3 ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." .

example:accessibilitySummary a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessibilitySummary" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A human-readable summary of specific accessibility features or deficiencies, consistent with the other accessibility metadata but expressing subtleties such as \"short descriptions are present but long descriptions will be needed for non-visual users\" or \"short descriptions are present and no long descriptions are needed.\"" .

example:accommodationCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accommodationCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Category of an [[Accommodation]], following real estate conventions e.g. RESO (see [PropertySubType](https://ddwiki.reso.org/display/DDW17/PropertySubType+Field), and [PropertyType](https://ddwiki.reso.org/display/DDW17/PropertyType+Field) fields  for suggested values)." .

example:accommodationFloorPlan a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accommodationFloorPlan" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A floorplan of some [[Accommodation]]." .

example:accountId a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accountId" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The identifier for the account the payment will be applied to." .

example:accountMinimumInflow a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accountMinimumInflow" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A minimum amount that has to be paid in every month." .

example:accountOverdraftLimit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accountOverdraftLimit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An overdraft is an extension of credit from a lending institution when an account reaches zero. An overdraft allows the individual to continue withdrawing money even if the account has no funds in it. Basically the bank allows people to borrow a set amount of money." .

example:accountablePerson a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accountablePerson" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the Person that is legally accountable for the CreativeWork." .

example:acquireLicensePage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acquireLicensePage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a page documenting how licenses can be purchased or otherwise acquired, for the current item." .

example:acquiredFrom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acquiredFrom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The organization or person from which the product was acquired." .

example:acrissCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acrissCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The ACRISS Car Classification Code is a code used by many car rental companies, for classifying vehicles. ACRISS stands for Association of Car Rental Industry Systems and Standards." .

example:actionAccessibilityRequirement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actionAccessibilityRequirement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A set of requirements that a must be fulfilled in order to perform an Action. If more than one value is specied, fulfilling one set of requirements will allow the Action to be performed." .

example:actionApplication a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actionApplication" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An application that can complete the request." .

example:actionOption a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actionOption" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of object. The options subject to this action." .

example:actionPlatform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actionPlatform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The high level platform(s) where the Action can be performed for the given URL. To specify a specific application or operating system instance, use actionApplication." .

example:actionStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actionStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the current disposition of the Action." .

example:actionableFeedbackPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actionableFeedbackPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For a [[NewsMediaOrganization]] or other news-related [[Organization]], a statement about public engagement activities (for news media, the newsroomâ€™s), including involving the public - digitally or otherwise -- in coverage decisions, reporting and activities after publication." .

example:activeIngredient a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activeIngredient" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An active ingredient, typically chemical compounds and/or biologic substances." .

example:activityDuration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activityDuration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Length of time to engage in the activity." .

example:activityFrequency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activityFrequency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "How often one should engage in the activity." .

example:actor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An actor, e.g. in tv, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip." .

example:actors a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "actors" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An actor, e.g. in tv, radio, movie, video games etc. Actors can be associated with individual items or with a series, episode, clip." .

example:addOn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "addOn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An additional offer that can only be obtained in combination with the first base offer (e.g. supplements and extensions that are available for a surcharge)." .

example:additionalName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "additionalName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An additional name for a Person, can be used for a middle name." .

example:additionalNumberOfGuests a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "additionalNumberOfGuests" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "If responding yes, the number of guests who will attend in addition to the invitee." .

example:additionalProperty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "additionalProperty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A property-value pair representing an additional characteristics of the entitity, e.g. a product feature or another characteristic for which there is no matching property in schema.org.\\n\\nNote: Publishers should be aware that applications designed to use specific schema.org properties (e.g. https://schema.org/width, https://schema.org/color, https://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism.
""" .

example:additionalType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "additionalType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. In RDFa syntax, it is better to use the native RDFa syntax - the 'typeof' attribute - for multiple types. Schema.org tools may have only weaker understanding of extra types, in particular those defined externally." .

example:additionalVariable a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "additionalVariable" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any additional component of the exercise prescription that may need to be articulated to the patient. This may include the order of exercises, the number of repetitions of movement, quantitative distance, progressions over time, etc." .

example:address a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "address" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Physical address of the item." .

example:addressCountry a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "addressCountry" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The country. For example, USA. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1)." .

example:addressLocality a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "addressLocality" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The locality in which the street address is, and which is in the region. For example, Mountain View." .

example:addressRegion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "addressRegion" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level [Administrative division](https://en.wikipedia.org/wiki/List_of_administrative_divisions_by_country) " .

example:administrationRoute a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "administrationRoute" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A route by which this drug may be administered, e.g. 'oral'." .

example:advanceBookingRequirement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "advanceBookingRequirement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of time that is required between accepting the offer and the actual usage of the resource or service." .

example:adverseOutcome a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "adverseOutcome" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A possible complication and/or side effect of this therapy. If it is known that an adverse outcome is serious (resulting in death, disability, or permanent damage; requiring hospitalization; or is otherwise life-threatening or requires immediate medical attention), tag it as a seriouseAdverseOutcome instead." .

example:affectedBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "affectedBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Drugs that affect the test's results." .

example:affiliation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "affiliation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An organization that this person is affiliated with. For example, a school/university, a club, or a team." .

example:afterMedia a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "afterMedia" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media object representing the circumstances after performing this direction." .

example:agent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "agent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The direct performer or driver of the action (animate or inanimate). e.g. *John* wrote a book." .

example:aggregateRating a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aggregateRating" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The overall rating, based on a collection of reviews or ratings, of the item." .

example:aircraft a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aircraft" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The kind of aircraft (e.g., \"Boeing 747\")." .

example:album a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "album" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A music album." .

example:albumProductionType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "albumProductionType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Classification of the album by it's type of content: soundtrack, live album, studio album, etc." .

example:albumRelease a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "albumRelease" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A release of this album." .

example:albumReleaseType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "albumReleaseType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The kind of release which this album is: single, EP or album." .

example:albums a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "albums" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A collection of music albums." .

example:alcoholWarning a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alcoholWarning" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any precaution, guidance, contraindication, etc. related to consumption of alcohol while taking this drug." .

example:algorithm a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "algorithm" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The algorithm or rules to follow to compute the score." .

example:alignmentType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alignmentType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A category of alignment between the learning resource and the framework node. Recommended values include: 'requires', 'textComplexity', 'readingLevel', and 'educationalSubject'." .

example:alternateName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alternateName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An alias for the item." .

example:alternativeHeadline a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alternativeHeadline" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A secondary title of the CreativeWork." .

example:alternativeOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alternativeOf" ;
    ns2:source <http://www.bioschemas.org/Gene> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Another gene which is a variation of this one." .

example:alumni a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alumni" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Alumni of an organization." .

example:alumniOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alumniOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An organization that the person is an alumni of." .

example:amenityFeature a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "amenityFeature" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An amenity feature (e.g. a characteristic or service) of the Accommodation. This generic property does not make a statement about whether the feature is included in an offer for the main accommodation or available at extra costs." .

example:amount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "amount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of money." .

example:amountOfThisGood a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "amountOfThisGood" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The quantity of the goods included in the offer." .

example:announcementLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "announcementLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a specific [[CivicStructure]] or [[LocalBusiness]] associated with the SpecialAnnouncement. For example, a specific testing facility or business with special opening hours. For a larger geographic region like a quarantine of an entire region, use [[spatialCoverage]]." .

example:annualPercentageRate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "annualPercentageRate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The annual rate that is charged for borrowing (or made by investing), expressed as a single percentage number that represents the actual yearly cost of funds over the term of a loan. This includes any fees or additional costs associated with the transaction." .

example:answerCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "answerCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of answers this question has received." .

example:answerExplanation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "answerExplanation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A step-by-step or full explanation about Answer. Can outline how this Answer was achieved or contain more broad clarification or statement about it. " .

example:antagonist a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "antagonist" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The muscle whose action counteracts the specified muscle." .

example:appearance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "appearance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates an occurence of a [[Claim]] in some [[CreativeWork]]." .

example:applicableLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicableLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location in which the status applies." .

example:applicantLocationRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicantLocationRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location(s) applicants can apply from. This is usually used for telecommuting jobs where the applicant does not need to be in a physical office. Note: This should not be used for citizenship or work visa requirements." .

example:application a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "application" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An application that can complete the request." .

example:applicationCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicationCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Type of software application, e.g. 'Game, Multimedia'." .

example:applicationContact a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicationContact" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Contact details for further information relevant to this job posting." .

example:applicationDeadline a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicationDeadline" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date at which the program stops collecting applications for the next enrollment cycle." .

example:applicationStartDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicationStartDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date at which the program begins collecting applications for the next enrollment cycle." .

example:applicationSubCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicationSubCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Subcategory of the application, e.g. 'Arcade Game'." .

example:applicationSuite a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "applicationSuite" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name of the application suite to which the application belongs (e.g. Excel belongs to Office)." .

example:appliesToDeliveryMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "appliesToDeliveryMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The delivery method(s) to which the delivery charge or payment charge specification applies." .

example:appliesToPaymentMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "appliesToPaymentMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The payment method(s) to which the payment charge specification applies." .

example:archiveHeld a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "archiveHeld" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Collection, [fonds](https://en.wikipedia.org/wiki/Fonds), or item held, kept or maintained by an [[ArchiveOrganization]]." .

example:archivedAt a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "archivedAt" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a page or other link involved in archival of a [[CreativeWork]]. In the case of [[MediaReview]], the items in a [[MediaReviewItem]] may often become inaccessible, but be archived by archival, journalistic, activist, or law enforcement organizations. In such cases, the referenced page may not directly publish the content." .

example:area a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "area" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The area within which users can expect to reach the broadcast service." .

example:areaServed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "areaServed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The geographic area where a service or offered item is provided." .

example:arrivalAirport a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalAirport" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The airport where the flight terminates." .

example:arrivalBoatTerminal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalBoatTerminal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The terminal or port from which the boat arrives." .

example:arrivalBusStop a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalBusStop" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The stop or station from which the bus arrives." .

example:arrivalGate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalGate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifier of the flight's arrival gate." .

example:arrivalPlatform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalPlatform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The platform where the train arrives." .

example:arrivalStation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalStation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The station where the train trip ends." .

example:arrivalTerminal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalTerminal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifier of the flight's arrival terminal." .

example:arrivalTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arrivalTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The expected arrival time." .

example:artEdition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "artEdition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of copies when multiple copies of a piece of artwork are produced - e.g. for a limited edition of 20 prints, 'artEdition' refers to the total number of copies (in this example \"20\")." .

example:artMedium a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "artMedium" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The material used. (e.g. Oil, Watercolour, Acrylic, Linoprint, Marble, Cyanotype, Digital, Lithograph, DryPoint, Intaglio, Pastel, Woodcut, Pencil, Mixed Media, etc.)" .

example:arterialBranch a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "arterialBranch" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The branches that comprise the arterial structure." .

example:artform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "artform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "e.g. Painting, Drawing, Sculpture, Print, Photograph, Assemblage, Collage, etc." .

example:articleBody a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "articleBody" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The actual body of the article." .

example:articleSection a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "articleSection" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Articles may belong to one or more 'sections' in a magazine or newspaper, such as Sports, Lifestyle, etc." .

example:artist a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "artist" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The primary artist for a work
    	in a medium other than pencils or digital line art--for example, if the
    	primary artwork is done in watercolors or digital paints.""" .

example:artworkSurface a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "artworkSurface" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The supporting materials for the artwork, e.g. Canvas, Paper, Wood, Board, etc." .

example:aspect a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aspect" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An aspect of medical practice that is considered on the page, such as 'diagnosis', 'treatment', 'causes', 'prognosis', 'etiology', 'epidemiology', etc." .

example:assembly a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assembly" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Library file name e.g., mscorlib.dll, system.web.dll." .

example:assemblyVersion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assemblyVersion" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Associated product/technology version. e.g., .NET Framework 4.5." .

example:assesses a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assesses" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The item being described is intended to assess the competency or learning outcome defined by the referenced term." .

example:associatedAnatomy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedAnatomy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The anatomy of the underlying organ system or structures associated with this entity." .

example:associatedArticle a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedArticle" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A NewsArticle associated with the Media Object." .

example:associatedClaimReview a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedClaimReview" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An associated [[ClaimReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." .

example:associatedDisease a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedDisease" ;
    ns2:source <http://www.bioschemas.org/BioChemEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Disease associated to this BioChemEntity. Such disease can be a MedicalCondition or a URL. If you want to add an evidence supporting the association, please use PropertyValue." .

example:associatedMedia a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedMedia" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media object that encodes this CreativeWork. This property is a synonym for encoding." .

example:associatedMediaReview a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedMediaReview" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An associated [[MediaReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." .

example:associatedPathophysiology a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedPathophysiology" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "If applicable, a description of the pathophysiology associated with the anatomical system, including potential abnormal changes in the mechanical, physical, and biochemical functions of the system." .

example:associatedReview a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "associatedReview" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An associated [[Review]]." .

example:athlete a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "athlete" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person that acts as performing member of a sports team; a player as opposed to a coach." .

example:attendee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "attendee" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person or organization attending the event." .

example:attendees a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "attendees" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person attending the event." .

example:audience a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "audience" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An intended audience, i.e. a group for whom something was created." .

example:audienceType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "audienceType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The target group associated with a given audience (e.g. veterans, car owners, musicians, etc.)." .

example:audio a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "audio" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An embedded audio object." .

example:authenticator a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "authenticator" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Organization responsible for authenticating the user's subscription. For example, many media apps require a cable/satellite provider to authenticate your subscription before playing media." .

example:author a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "author" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The author of this content or rating. Please note that author is special in that HTML 5 provides a special mechanism for indicating authorship via the rel tag. That is equivalent to this and may be used interchangeably." .

example:availability a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "availability" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The availability of this item&#x2014;for example In stock, Out of stock, Pre-order, etc." .

example:availabilityEnds a ns3:ObjectProperty,
        linkml:SlotDefinition ;
