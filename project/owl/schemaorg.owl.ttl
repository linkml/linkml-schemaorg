example:boardingPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "boardingPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of boarding policy used by the airline (e.g. zone-based or group-based)." .

example:bodyLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bodyLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Location in the body of the anatomical structure." .

example:bodyType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bodyType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the design and body style of the vehicle (e.g. station wagon, hatchback, etc.)." .

example:bookEdition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bookEdition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The edition of the book." .

example:bookFormat a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bookFormat" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The format of the book." .

example:bookingAgent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bookingAgent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "'bookingAgent' is an out-dated term indicating a 'broker' that serves as a booking agent." .

example:bookingTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bookingTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date and time the reservation was booked." .

example:borrower a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "borrower" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The person that borrows the object being lent." .

example:box a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "box" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A box is the area enclosed by the rectangle formed by two points. The first point is the lower corner, the second point is the upper corner. A box is expressed as two points separated by a space character." .

example:branch a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "branch" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The branches that delineate from the nerve bundle. Not to be confused with [[branchOf]]." .

example:branchCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "branchCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A short textual code (also called "store code") that uniquely identifies a place of business. The code is typically assigned by the parentOrganization and used in structured URLs.\\n\\nFor example, in the URL http://www.starbucks.co.uk/store-locator/etc/detail/3047 the code "3047" is a branchCode for a particular branch.
      """ .

example:branchOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "branchOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The larger organization that this local business is a branch of, if any. Not to be confused with (anatomical)[[branch]]." .

example:brand a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "brand" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person." .

example:breadcrumb a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "breadcrumb" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A set of links that can help a user understand and navigate a website hierarchy." .

example:breastfeedingWarning a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "breastfeedingWarning" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any precaution, guidance, contraindication, etc. related to this drug's use by breastfeeding mothers." .

example:broadcastAffiliateOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastAffiliateOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The media network(s) whose content is broadcast on this station." .

example:broadcastChannelId a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastChannelId" ;
