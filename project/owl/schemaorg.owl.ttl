example:requiresSubscription a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requiresSubscription" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates if use of the media require a subscription  (either paid or free). Allowed values are ```true``` or ```false``` (note that an earlier version had 'yes', 'no')." .

example:reservationFor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reservationFor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The thing -- flight, event, restaurant,etc. being reserved." .

example:reservationId a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reservationId" ;
    ns1:inScheme <http://example.org/example> ;
