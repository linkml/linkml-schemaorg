example:DeliveryEvent a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DeliveryEvent" ;
    rdfs:subClassOf example:Event ;
    ns1:exactMatch <http://schema.org/DeliveryEvent> ;
    ns1:inScheme <http://example.org/example> ;
