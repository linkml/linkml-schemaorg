example:DietarySupplement a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DietarySupplement" ;
    rdfs:subClassOf example:Substance ;
    ns1:exactMatch <http://schema.org/DietarySupplement> ;
    ns1:inScheme <http://example.org/example> ;
