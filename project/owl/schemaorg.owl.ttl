    rdfs:label "JewelryStore" ;
    rdfs:subClassOf example:Store ;
    ns1:exactMatch <http://schema.org/JewelryStore> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A jewelry store." .

example:JobPosting a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "JobPosting" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/JobPosting> ;
    ns1:inScheme <http://example.org/example> ;
