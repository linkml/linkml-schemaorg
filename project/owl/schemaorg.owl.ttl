example:awards a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "awards" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Awards won by or for this item." .

example:awayTeam a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "awayTeam" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The away team in a sports event." .

example:backstory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "backstory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For an [[Article]], typically a [[NewsArticle]], the backstory property provides a textual summary giving a brief explanation of why and how an article was created. In a journalistic setting this could include information about reporting process, methods, interviews, data sources, etc." .

example:bankAccountType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bankAccountType" ;
