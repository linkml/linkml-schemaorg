    ns1:inScheme <http://example.org/example> ;
    ns1:note "A music recording (track)&#x2014;usually a single song. If an ItemList is given, the list should contain items of type MusicRecording." .

example:trackingNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "trackingNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Shipper tracking number." .

example:trackingUrl a ns3:ObjectProperty,
