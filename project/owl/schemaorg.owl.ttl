    ns1:note "The suggested gender of the intended person or audience, for example \"male\", \"female\", or \"unisex\"." .

example:suggestedMaxAge a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggestedMaxAge" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Maximum recommended age in years for the audience or user." .

example:suggestedMeasurement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggestedMeasurement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A suggested range of body measurements for the intended audience or person, for example inseam between 32 and 34 inches or height between 170 and 190 cm. Typically found on a size chart for wearable products." .

example:suggestedMinAge a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggestedMinAge" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Minimum recommended age in years for the audience or user." .

example:suitableForDiet a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suitableForDiet" ;
