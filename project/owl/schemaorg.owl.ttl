example:reservedTicket a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reservedTicket" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A ticket associated with the reservation." .

example:responsibilities a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "responsibilities" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Responsibilities associated with this role or Occupation." .

example:restPeriods a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "restPeriods" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "How often one should break from the activity." .

example:restockingFee a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "restockingFee" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Use [[MonetaryAmount]] to specify a fixed restocking fee for product returns, or use [[Number]] to specify a percentage of the product price paid by the customer." .

example:result a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "result" ;
    ns1:inScheme <http://example.org/example> ;
