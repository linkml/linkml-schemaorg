example:FoodService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "FoodService" ;
    rdfs:subClassOf example:Service ;
    ns1:exactMatch <http://schema.org/FoodService> ;
    ns1:inScheme <http://example.org/example> ;
