    ns1:inScheme <http://example.org/example> ;
    ns1:note "A [blog](https://en.wikipedia.org/wiki/Blog), sometimes known as a \"weblog\". Note that the individual posts ([[BlogPosting]]s) in a [[Blog]] are often colloqually referred to by the same term." .

example:BloodTest a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "BloodTest" ;
    rdfs:subClassOf example:MedicalTest ;
    ns1:exactMatch <http://schema.org/BloodTest> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical test performed on a sample of a patient's blood." .

