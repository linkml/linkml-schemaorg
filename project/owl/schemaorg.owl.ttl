example:JoinAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "JoinAction" ;
    rdfs:subClassOf example:InteractAction ;
    ns1:exactMatch <http://schema.org/JoinAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An agent joins an event/group with participants/friends at a location.\\n\\nRelated actions:\\n\\n* [[RegisterAction]]: Unlike RegisterAction, JoinAction refers to joining a group/team of people.\\n* [[SubscribeAction]]: Unlike SubscribeAction, JoinAction does not imply that you'll be receiving updates.\\n* [[FollowAction]]: Unlike FollowAction, JoinAction does not imply that you'll be polling for updates." .

example:Joint a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Joint" ;
    rdfs:subClassOf example:AnatomicalStructure ;
    ns1:exactMatch <http://schema.org/Joint> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The anatomical location at which two or more bones make contact." .

example:LakeBodyOfWater a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LakeBodyOfWater" ;
    rdfs:subClassOf example:BodyOfWater ;
    ns1:exactMatch <http://schema.org/LakeBodyOfWater> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A lake (for example, Lake Pontrachain)." .

example:LandmarksOrHistoricalBuildings a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LandmarksOrHistoricalBuildings" ;
    rdfs:subClassOf example:Place ;
    ns1:exactMatch <http://schema.org/LandmarksOrHistoricalBuildings> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An historical landmark or building." .

example:Language a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Language" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Language> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Natural languages such as Spanish, Tamil, Hindi, English, etc. Formal language code tags expressed in [BCP 47](https://en.wikipedia.org/wiki/IETF_language_tag) can be used via the [[alternateName]] property. The Language type previously also covered programming languages such as Scheme and Lisp, which are now best represented using [[ComputerLanguage]]." .

example:LeaveAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LeaveAction" ;
    rdfs:subClassOf example:InteractAction ;
    ns1:exactMatch <http://schema.org/LeaveAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An agent leaves an event / group with participants/friends at a location.\\n\\nRelated actions:\\n\\n* [[JoinAction]]: The antonym of LeaveAction.\\n* [[UnRegisterAction]]: Unlike UnRegisterAction, LeaveAction implies leaving a group/team of people rather than a service." .

example:LegalForceStatus a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LegalForceStatus" ;
    rdfs:subClassOf example:StatusEnumeration ;
    ns1:exactMatch <http://data.europa.eu/eli/ontology#InForce>,
        <http://schema.org/LegalForceStatus> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A list of possible statuses for the legal force of a legislation." .

example:LegalValueLevel a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LegalValueLevel" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:closeMatch <http://data.europa.eu/eli/ontology#LegalValue> ;
    ns1:exactMatch <http://schema.org/LegalValueLevel> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A list of possible levels for the legal validity of a legislation." .

example:Legislation a ns3:Class,
        linkml:ClassDefinition ;
