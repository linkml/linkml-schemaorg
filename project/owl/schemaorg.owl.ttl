example:CheckAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CheckAction" ;
    rdfs:subClassOf example:FindAction ;
    ns1:exactMatch <http://schema.org/CheckAction> ;
    ns1:inScheme <http://example.org/example> ;
