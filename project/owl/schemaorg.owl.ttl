    rdfs:subClassOf example:MedicalIndication ;
    ns1:exactMatch <http://schema.org/ApprovedIndication> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An indication for a medical therapy that has been formally specified or approved by a regulatory body that regulates use of the therapy; for example, the US FDA approves indications for most drugs in the US." .

example:Aquarium a ns3:Class,
        linkml:ClassDefinition ;
