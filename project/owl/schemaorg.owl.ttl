example:checkoutTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "checkoutTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The latest someone may check out of a lodging establishment." .

example:chemicalComposition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chemicalComposition" ;
    ns2:source <http://www.bioschemas.org/ChemicalSubstance> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The chemical composition describes the identity and relative ratio of the chemical elements that make up the substance." .

example:chemicalRole a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chemicalRole" ;
    ns2:source <http://www.bioschemas.org/ChemicalSubstance> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A role played by the BioChemEntity within a chemical context." .

example:childMaxAge a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "childMaxAge" ;
    ns1:inScheme <http://example.org/example> ;
