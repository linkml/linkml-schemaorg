example:sameAs a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sameAs" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website." .

example:sampleType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sampleType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." .

example:saturatedFatContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "saturatedFatContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of saturated fat." .

example:scheduleTimezone a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "scheduleTimezone" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the timezone for which the time(s) indicated in the [[Schedule]] are given. The value provided should be among those listed in the IANA Time Zone Database." .

example:scheduledPaymentDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "scheduledPaymentDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date the invoice is scheduled to be paid." .

example:scheduledTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "scheduledTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time the object is scheduled to." .

example:schemaVersion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "schemaVersion" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Indicates (by URL or string) a particular version of a schema used in some CreativeWork. This property was created primarily to
    indicate the use of a specific schema.org release, e.g. ```10.0``` as a simple string, or more explicitly via URL, ```https://schema.org/docs/releases.html#v10.0```. There may be situations in which other schemas might usefully be referenced this way, e.g. ```http://dublincore.org/specifications/dublin-core/dces/1999-07-02/``` but this has not been carefully explored in the community.""" .

example:schoolClosuresInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "schoolClosuresInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Information about school closures." .

example:screenCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "screenCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of screens in the movie theater." .

example:screenshot a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "screenshot" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A link to a screenshot image of the app." .

example:sdDatePublished a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sdDatePublished" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the date on which the current structured data was generated / published. Typically used alongside [[sdPublisher]]" .

example:sdLicense a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sdLicense" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A license document that applies to this structured data, typically indicated by URL." .

example:sdPublisher a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sdPublisher" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Indicates the party responsible for generating and publishing the current structured data markup, typically in cases where the structured data is derived automatically from existing published content but published on a different site. For example, student projects and open data initiatives often re-publish existing content with more explicitly structured metadata. The
[[sdPublisher]] property helps make such practices more explicit.""" .

example:season a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "season" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A season in a media series." .

example:seasonNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seasonNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Position of the season within an ordered group of seasons." .

example:seasons a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seasons" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A season in a media series." .

example:seatNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seatNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location of the reserved seat (e.g., 27)." .

example:seatRow a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seatRow" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The row location of the reserved seat (e.g., B)." .

example:seatSection a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seatSection" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The section location of the reserved seat (e.g. Orchestra)." .

example:seatingCapacity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seatingCapacity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of persons that can be seated (e.g. in a vehicle), both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons " .

example:seatingType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seatingType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type/class of the seat." .

example:secondaryPrevention a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "secondaryPrevention" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A preventative therapy used to prevent reoccurrence of the medical condition after an initial episode of the condition." .

example:securityClearanceRequirement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "securityClearanceRequirement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of any security clearance requirements of the job." .

example:securityScreening a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "securityScreening" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of security screening the passenger is subject to." .

example:seeks a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seeks" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer to products or services sought by the organization or person (demand)." .

example:seller a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seller" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An entity which offers (sells / leases / lends / loans) the services / goods.  A seller may also be a provider." .

example:sender a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sender" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The participant who is at the sending end of the action." .

example:sensoryRequirement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sensoryRequirement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of any sensory requirements and levels necessary to function on the job, including hearing and vision. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." .

example:sensoryUnit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sensoryUnit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The neurological pathway extension that inputs and sends information to the brain or spinal cord." .

example:serialNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serialNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The serial number or any alphanumeric identifier of a particular product. When attached to an offer, it is a shortcut for the serial number of the product included in the offer." .

example:seriousAdverseOutcome a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seriousAdverseOutcome" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A possible serious complication and/or serious side effect of this therapy. Serious adverse outcomes include those that are life-threatening; result in death, disability, or permanent damage; require hospitalization or prolong existing hospitalization; cause congenital anomalies or birth defects; or jeopardize the patient and may require medical or surgical intervention to prevent one of the outcomes in this definition." .

example:serverStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serverStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Status of a game server." .

example:servesCuisine a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "servesCuisine" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The cuisine of the restaurant." .

example:serviceArea a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceArea" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The geographic area where the service is provided." .

example:serviceAudience a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceAudience" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The audience eligible for this service." .

example:serviceLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location (e.g. civic structure, local business, etc.) where a person can go to access the service." .

example:serviceOperator a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceOperator" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The operating organization, if different from the provider.  This enables the representation of services that are provided by an organization, but operated by another organization like a subcontractor." .

example:serviceOutput a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceOutput" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The tangible thing generated by the service, e.g. a passport, permit, etc." .

example:servicePhone a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "servicePhone" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The phone number to use to access the service." .

example:servicePostalAddress a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "servicePostalAddress" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The address for accessing the service by mail." .

example:serviceSmsNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceSmsNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number to access the service by text message." .

example:serviceType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of service being offered, e.g. veterans' benefits, emergency relief, etc." .

example:serviceUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serviceUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The website to access the service." .

example:servingSize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "servingSize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The serving size, in terms of the number of volume or mass." .

example:sha256 a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sha256" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The [SHA-2](https://en.wikipedia.org/wiki/SHA-2) SHA256 hash of the content of the item. For example, a zero-length input has value 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'" .

example:sharedContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sharedContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A CreativeWork such as an image, video, or audio clip shared as part of this posting." .

example:shippingDestination a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "shippingDestination" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "indicates (possibly multiple) shipping destinations. These can be defined in several ways e.g. postalCode ranges." .

example:shippingDetails a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "shippingDetails" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates information about the shipping policies and options associated with an [[Offer]]." .

example:shippingLabel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "shippingLabel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Label to match an [[OfferShippingDetails]] with a [[ShippingRateSettings]] (within the context of a [[shippingSettingsLink]] cross-reference)." .

example:shippingRate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "shippingRate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The shipping rate is the cost of shipping to the specified destination. Typically, the maxValue and currency values (of the [[MonetaryAmount]]) are most appropriate." .

example:shippingSettingsLink a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "shippingSettingsLink" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Link to a page containing [[ShippingRateSettings]] and [[DeliveryTimeSettings]] details." .

example:sibling a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sibling" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sibling of the person." .

example:siblings a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "siblings" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sibling of the person." .

example:signDetected a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "signDetected" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sign detected by the test." .

example:signOrSymptom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "signOrSymptom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sign or symptom of this condition. Signs are objective or physically observable manifestations of the medical condition while symptoms are the subjective experience of the medical condition." .

example:significance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "significance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The significance associated with the superficial anatomy; as an example, how characteristics of the superficial anatomy can suggest underlying medical conditions or courses of treatment." .

example:significantLink a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "significantLink" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "One of the more significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." .

example:significantLinks a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "significantLinks" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The most significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." .

example:size a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "size" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A standardized size of a product or creative work, specified either through a simple textual string (for example 'XL', '32Wx34L'), a  QuantitativeValue with a unitCode, or a comprehensive and structured [[SizeSpecification]]; in other cases, the [[width]], [[height]], [[depth]] and [[weight]] properties may be more applicable. " .

example:sizeGroup a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sizeGroup" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The size group (also known as \"size type\") for a product's size. Size groups are common in the fashion industry to define size segments and suggested audiences for wearable products. Multiple values can be combined, for example \"men's big and tall\", \"petite maternity\" or \"regular\"" .

example:sizeSystem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sizeSystem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The size system used to identify a product's size. Typically either a standard (for example, \"GS1\" or \"ISO-EN13402\"), country code (for example \"US\" or \"JP\"), or a measuring system (for example \"Metric\" or \"Imperial\")." .

example:skills a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "skills" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A statement of knowledge, skill, ability, task or any other assertion expressing a competency that is desired or required to fulfill this role or to work in this occupation." .

example:sku a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sku" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Stock Keeping Unit (SKU), i.e. a merchant-specific identifier for a product or service, or the product to which the offer refers." .

example:slogan a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "slogan" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A slogan or motto associated with the item." .

example:smiles a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "smiles" ;
    ns2:source <http://www.bioschemas.org/MolecularEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A specification in form of a line notation for describing the structure of chemical species using short ASCII strings.  Double bond stereochemistry \\ indicators may need to be escaped in the string in formats where the backslash is an escape character." .

example:smokingAllowed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "smokingAllowed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether it is allowed to smoke in the place, e.g. in the restaurant, hotel or hotel room." .

example:sodiumContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sodiumContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of milligrams of sodium." .

example:softwareAddOn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "softwareAddOn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Additional content for a software application." .

example:softwareHelp a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "softwareHelp" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Software application help." .

example:softwareRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "softwareRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (Examples: DirectX, Java or .NET runtime)." .

example:softwareVersion a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "softwareVersion" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Version of the software instance." .

example:sourceOrganization a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceOrganization" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Organization on whose behalf the creator was working." .

example:sourcedFrom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourcedFrom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The neurological pathway that originates the neurons." .

example:spatial a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spatial" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The "spatial" property can be used in cases when more specific properties
(e.g. [[locationCreated]], [[spatialCoverage]], [[contentLocation]]) are not known to be appropriate.""" .

example:spatialCoverage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spatialCoverage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content. It is a subproperty of
      contentLocation intended primarily for more technical and detailed materials. For example with a Dataset, it indicates
      areas that the dataset describes: a dataset of New York weather would have spatialCoverage which was the place: the state of New York.""" .

example:speakable a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "speakable" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Indicates sections of a Web page that are particularly 'speakable' in the sense of being highlighted as being especially appropriate for text-to-speech conversion. Other sections of a page may also be usefully spoken in particular circumstances; the 'speakable' property serves to indicate the parts most likely to be generally useful for speech.

The *speakable* property can be repeated an arbitrary number of times, with three kinds of possible 'content-locator' values:

1.) *id-value* URL references - uses *id-value* of an element in the page being annotated. The simplest use of *speakable* has (potentially relative) URL values, referencing identified sections of the document concerned.

2.) CSS Selectors - addresses content in the annotated page, eg. via class attribute. Use the [[cssSelector]] property.

3.)  XPaths - addresses content via XPaths (assuming an XML view of the content). Use the [[xpath]] property.


For more sophisticated markup of speakable sections beyond simple ID references, either CSS selectors or XPath expressions to pick out document section(s) as speakable. For this
we define a supporting type, [[SpeakableSpecification]]  which is defined to be a possible value of the *speakable* property.
         """ .

example:specialCommitments a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "specialCommitments" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any special commitments associated with this job posting. Valid entries include VeteranCommit, MilitarySpouseCommit, etc." .

example:specialOpeningHoursSpecification a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "specialOpeningHoursSpecification" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The special opening hours of a certain place.\\n\\nUse this to explicitly override general opening hours brought in scope by [[openingHoursSpecification]] or [[openingHours]].
      """ .

example:specialty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "specialty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "One of the domain specialities to which this web page's content applies." .

example:speechToTextMarkup a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "speechToTextMarkup" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Form of markup used. eg. [SSML](https://www.w3.org/TR/speech-synthesis11) or [IPA](https://www.wikidata.org/wiki/Property:P898)." .

example:speed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "speed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The speed range of the vehicle. If the vehicle is powered by an engine, the upper limit of the speed range (indicated by [[maxValue]] should be the maximum speed achievable under regular conditions.\\n\\nTypical unit code(s): KMH for km/h, HM for mile per hour (0.447 04 m/s), KNT for knot\\n\\n*Note 1: Use [[minValue]] and [[maxValue]] to indicate the range. Typically, the minimal value is zero.\\n* Note 2: There are many different ways of measuring the speed range. You can link to information about how the given value has been determined using the [[valueReference]] property." .

example:spokenByCharacter a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spokenByCharacter" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The (e.g. fictional) character, Person or Organization to whom the quotation is attributed within the containing CreativeWork." .

example:sponsor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sponsor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person or organization that supports a thing through a pledge, promise, or financial contribution. e.g. a sponsor of a Medical Study or a corporate sponsor of an event." .

example:sport a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sport" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A type of sport (e.g. Baseball)." .

example:sportsActivityLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sportsActivityLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The sports activity location where this action occurred." .

example:sportsEvent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sportsEvent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The sports event where this action occurred." .

example:sportsTeam a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sportsTeam" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The sports team that participated on this action." .

example:spouse a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spouse" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person's spouse." .

example:stage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "stage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The stage of the condition, if applicable." .

example:stageAsNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "stageAsNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The stage represented as a number, e.g. 3." .

example:starRating a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "starRating" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An official rating for a lodging business or food establishment, e.g. from national associations or standards bodies. Use the author property to indicate the rating organization, e.g. as an Organization with name such as (e.g. HOTREC, DEHOGA, WHR, or Hotelstars)." .

example:startDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "startDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The start date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." .

example:startOffset a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "startOffset" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The start time of the clip expressed as the number of seconds from the beginning of the work." .

example:startTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "startTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. e.g. John wrote a book from *January* to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." .

example:status a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "status" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The status of the study (enumerated)." .

example:steeringPosition a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "steeringPosition" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The position of the steering wheel or similar device (mostly for cars)." .

example:step a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "step" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection." .

example:stepValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "stepValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The stepValue attribute indicates the granularity that is expected (and required) of the value in a PropertyValueSpecification." .

example:steps a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "steps" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection (originally misnamed 'steps'; 'step' is preferred)." .

example:storageRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "storageRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Storage requirements (free space required)." .

example:streetAddress a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "streetAddress" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The street address. For example, 1600 Amphitheatre Pkwy." .

example:strengthUnit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "strengthUnit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The units of an active ingredient's strength, e.g. mg." .

example:strengthValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "strengthValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The value of an active ingredient's strength, e.g. 325." .

example:structuralClass a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "structuralClass" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name given to how bone physically connects to each other." .

example:study a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "study" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical study or trial related to this entity." .

example:studyDesign a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyDesign" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifics about the observational study design (enumerated)." .

example:studyLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location in which the study is taking/took place." .

example:studySubject a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studySubject" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A subject of the study, i.e. one of the medical conditions, therapies, devices, drugs, etc. investigated by the study." .

example:subEvent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subEvent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An Event that is part of this event. For example, a conference event includes many presentations, each of which is a subEvent of the conference." .

example:subEvents a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subEvents" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Events that are a part of this event. For example, a conference event includes many presentations, each subEvents of the conference." .

example:subOrganization a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subOrganization" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A relationship between two organizations where the first includes the second, e.g., as a subsidiary. See also: the more specific 'department' property." .

example:subReservation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subReservation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The individual reservations included in the package. Typically a repeated property." .

example:subStageSuffix a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subStageSuffix" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The substage, e.g. 'a' for Stage IIIa." .

example:subStructure a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subStructure" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Component (sub-)structure(s) that comprise this anatomical structure." .

example:subTest a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subTest" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A component test of the panel." .

example:subTrip a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subTrip" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifies a [[Trip]] that is a subTrip of this Trip.  For example Day 1, Day 2, etc. of a multi-day trip." .

example:subjectOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subjectOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A CreativeWork or Event about this Thing." .

example:subtitleLanguage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subtitleLanguage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Languages in which subtitles/captions are available, in [IETF BCP 47 standard format](http://tools.ietf.org/html/bcp47)." .

example:successorOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "successorOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A pointer from a newer variant of a product  to its previous, often discontinued predecessor." .

example:sugarContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sugarContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of sugar." .

example:suggestedAge a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggestedAge" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The age or age range for the intended audience or person, for example 3-12 months for infants, 1-5 years for toddlers." .

example:suggestedAnswer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggestedAnswer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An answer (possibly one of several, possibly incorrect) to a Question, e.g. on a Question/Answer site." .

example:suggestedGender a ns3:ObjectProperty,
        linkml:SlotDefinition ;
