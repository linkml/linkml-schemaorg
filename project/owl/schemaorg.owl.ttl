example:realEstateAgent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "realEstateAgent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The real estate agent involved in the action." .

example:recipe a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recipe" ;
    ns1:inScheme <http://example.org/example> ;
