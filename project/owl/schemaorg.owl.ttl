example:MedicalObservationalStudy a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalObservationalStudy" ;
    rdfs:subClassOf example:MedicalStudy ;
    ns1:exactMatch <http://schema.org/MedicalObservationalStudy> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An observational study is a type of medical study that attempts to infer the possible effect of a treatment through observation of a cohort of subjects over a period of time. In an observational study, the assignment of subjects into treatment groups versus control groups is outside the control of the investigator. This is in contrast with controlled studies, such as the randomized controlled trials represented by MedicalTrial, where each subject is randomly assigned to a treatment group or a control group before the start of the treatment." .

example:MedicalObservationalStudyDesign a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalObservationalStudyDesign" ;
    rdfs:subClassOf example:MedicalEnumeration ;
    ns1:exactMatch <http://schema.org/MedicalObservationalStudyDesign> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Design models for observational medical studies. Enumerated type." .

