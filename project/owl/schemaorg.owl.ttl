    ns1:inScheme <http://example.org/example> ;
    ns1:note "An event that this event is a part of. For example, a collection of individual music performances might each have a music festival as their superEvent." .

example:supersededBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supersededBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Relates a term (i.e. a property, class or enumeration) to one that supersedes it." .

example:supply a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supply" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub-property of instrument. A supply consumed when performing instructions or a direction." .

example:supplyTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supplyTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The area to which the artery supplies blood." .

example:supportingData a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supportingData" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Supporting data for a SoftwareApplication." .

example:surface a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "surface" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A material used as a surface in some artwork, e.g. Canvas, Paper, Wood, Board, etc." .

example:target a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a target EntryPoint for an Action." .

example:targetCollection a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targetCollection" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of object. The collection target of the action." .

example:targetDescription a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targetDescription" ;
    ns1:inScheme <http://example.org/example> ;
