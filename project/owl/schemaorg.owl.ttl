    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name displayed in the channel guide. For many US affiliates, it is the network name." .

example:broadcastFrequency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastFrequency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The frequency used for over-the-air broadcasts. Numeric values or simple ranges e.g. 87-99. In addition a shortcut idiom is supported for frequences of AM and FM radio channels, e.g. \"87 FM\"." .

example:broadcastFrequencyValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastFrequencyValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The frequency in MHz for a particular broadcast." .

example:broadcastOfEvent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastOfEvent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The event being broadcast such as a sporting event or awards ceremony." .

example:broadcastServiceTier a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastServiceTier" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of service required to have access to the channel (e.g. Standard or Premium)." .

example:broadcastSignalModulation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastSignalModulation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The modulation (e.g. FM, AM, etc) used by a particular broadcast service." .

example:broadcastSubChannel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastSubChannel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The subchannel used for the broadcast." .

example:broadcastTimezone a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcastTimezone" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The timezone in [ISO 8601 format](http://en.wikipedia.org/wiki/ISO_8601) for which the service bases its broadcasts" .

example:broadcaster a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broadcaster" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The organization owning or operating the broadcast service." .

example:broker a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broker" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An entity that arranges for an exchange between a buyer and a seller.  In most cases a broker never acquires or releases ownership of a product or service involved in an exchange.  If it is not clear whether an entity is a broker, seller, or buyer, the latter two terms are preferred." .

example:browserRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "browserRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies browser requirements in human-readable text. For example, 'requires HTML5 support'." .

example:busName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "busName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name of the bus (e.g. Bolt Express)." .

example:busNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "busNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The unique identifier for the bus." .

example:businessDays a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "businessDays" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Days of the week when the merchant typically operates, indicated via opening hours markup." .

example:businessFunction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "businessFunction" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The business function (e.g. sell, lease, repair, dispose) of the offer or component of a bundle (TypeAndQuantityNode). The default is http://purl.org/goodrelations/v1#Sell." .

example:buyer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "buyer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The participant/person/organization that bought the object." .

example:byArtist a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "byArtist" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The artist that performed this album or recording." .

example:byDay a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "byDay" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Defines the day(s) of the week on which a recurring [[Event]] takes place. May be specified using either [[DayOfWeek]], or alternatively [[Text]] conforming to iCal's syntax for byDay recurrence rules." .

example:byMonth a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "byMonth" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Defines the month(s) of the year on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-12. January is 1." .

example:byMonthDay a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "byMonthDay" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Defines the day(s) of the month on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-31." .

example:byMonthWeek a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "byMonthWeek" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Defines the week(s) of the month on which a recurring Event takes place. Specified as an Integer between 1-5. For clarity, byMonthWeek is best used in conjunction with byDay to indicate concepts like the first and third Mondays of a month." .

example:callSign a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "callSign" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A [callsign](https://en.wikipedia.org/wiki/Call_sign), as used in broadcasting and radio communications to identify people, radio and TV stations, or vehicles." .

example:calories a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "calories" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of calories." .

example:candidate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "candidate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of object. The candidate subject of this action." .

example:caption a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "caption" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The caption for this object. For downloadable machine formats (closed caption, subtitles etc.) use MediaObject and indicate the [[encodingFormat]]." .

example:carbohydrateContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "carbohydrateContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of carbohydrates." .

example:cargoVolume a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cargoVolume" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The available volume for cargo or luggage. For automobiles, this is usually the trunk volume.\\n\\nTypical unit code(s): LTR for liters, FTQ for cubic foot/feet\\n\\nNote: You can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:carrier a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "carrier" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "'carrier' is an out-dated term indicating the 'provider' for parcel delivery and flights." .

example:carrierRequirements a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "carrierRequirements" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies specific carrier(s) requirements for the application (e.g. an application may only work on a specific carrier network)." .

example:cashBack a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cashBack" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A cardholder benefit that pays the cardholder a small percentage of their net expenditures." .

example:catalog a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "catalog" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A data catalog which contains this dataset." .

example:catalogNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "catalogNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The catalog number for the release." .

example:category a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "category" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A category for the item. Greater signs or slashes can be used to informally indicate a category hierarchy." .

example:causeOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "causeOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The condition, complication, symptom, sign, etc. caused." .

example:ccRecipient a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ccRecipient" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of recipient. The recipient copied on a message." .

example:character a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "character" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Fictional person connected with a creative work." .

example:characterAttribute a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "characterAttribute" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A piece of data that represents a particular aspect of a fictional character (skill, power, character points, advantage, disadvantage)." .

example:characterName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "characterName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The name of a character played in some acting or performing role, i.e. in a PerformanceRole." .

example:cheatCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cheatCode" ;
    ns1:inScheme <http://example.org/example> ;
