    ns1:exactMatch <http://schema.org/ApplyAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of registering to an organization/service without the guarantee to receive it.\\n\\nRelated actions:\\n\\n* [[RegisterAction]]: Unlike RegisterAction, ApplyAction has no guarantees that the application will be accepted." .

