example:recipeYield a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recipeYield" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The quantity produced by the recipe (for example, number of people served, number of servings, etc)." .

example:recipient a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recipient" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The participant who is at the receiving end of the action." .

example:recognizedBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recognizedBy" ;
    ns1:inScheme <http://example.org/example> ;
