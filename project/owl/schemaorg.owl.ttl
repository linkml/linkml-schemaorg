example:recipeCuisine a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recipeCuisine" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The cuisine of the recipe (for example, French or Ethiopian)." .

example:recipeIngredient a ns3:ObjectProperty,
        linkml:SlotDefinition ;
