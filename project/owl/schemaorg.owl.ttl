example:trainingSalary a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "trainingSalary" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The estimated salary earned while in the program." .

example:transFatContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transFatContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of trans fat." .

example:transcript a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transcript" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "If this MediaObject is an AudioObject or VideoObject, the transcript of that object." .

example:transitTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transitTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The typical delay the order has been sent for delivery and the goods reach the final customer. Typical properties: minValue, maxValue, unitCode (d for DAY)." .

example:transitTimeLabel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transitTimeLabel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Label to match an [[OfferShippingDetails]] with a [[DeliveryTimeSettings]] (within the context of a [[shippingSettingsLink]] cross-reference)." .

example:translationOfWork a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "translationOfWork" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The work that this work has been translated from. e.g. ç‰©ç§èµ·æº is a translationOf â€œOn the Origin of Speciesâ€" .

example:translator a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "translator" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Organization or person who adapts a creative work to different languages, regional differences and technical requirements of a target market, or that translates during some event." .

example:transmissionMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transmissionMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "How the disease spreads, either as a route or vector, for example 'direct contact', 'Aedes aegypti', etc." .

example:travelBans a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "travelBans" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Information about travel bans, e.g. in the context of a pandemic." .

example:trialDesign a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "trialDesign" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifics about the trial design (enumerated)." .

example:tributary a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tributary" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The anatomical or organ system that the vein flows into; a larger structure that the vein connects to." .

example:typeOfBed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "typeOfBed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of bed to which the BedDetail refers, i.e. the type of bed available in the quantity indicated by quantity." .

example:typeOfGood a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "typeOfGood" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The product that this structured value is referring to." .

example:typicalAgeRange a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "typicalAgeRange" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The typical expected age range, e.g. '7-9', '11-'." .

example:typicalCreditsPerTerm a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "typicalCreditsPerTerm" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of credits or units a full-time student would be expected to take in 1 term however 'term' is defined by the institution." .

example:typicalTest a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "typicalTest" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical test typically performed given this condition." .

example:underName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "underName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person or organization the reservation or ticket is for." .

example:unitCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "unitCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL. Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon." .

example:unitText a ns3:ObjectProperty,
        linkml:SlotDefinition ;
