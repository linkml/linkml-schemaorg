example:value a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "value" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The value of the quantitative value or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text;', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

example:valueAddedTaxIncluded a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valueAddedTaxIncluded" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies whether the applicable value-added tax (VAT) is included in the price specification or not." .

example:valueMaxLength a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valueMaxLength" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the allowed range for number of characters in a literal value." .

example:valueMinLength a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valueMinLength" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the minimum allowed range for number of characters in a literal value." .

example:valueName a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valueName" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the name of the PropertyValueSpecification to be used in URL templates and form encoding in a manner analogous to HTML's input@name." .

example:valuePattern a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valuePattern" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies a regular expression for testing literal values according to the HTML spec." .

example:valueReference a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valueReference" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A secondary value that provides additional information on the original value, e.g. a reference temperature or a type of measurement." .

example:valueRequired a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "valueRequired" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether the property must be filled in to complete the action.  Default is false." .

example:variableMeasured a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "variableMeasured" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The variableMeasured property can indicate (repeated as necessary) the  variables that are measured in some dataset, either described as text or as pairs of identifier and description using PropertyValue." .

example:variantCover a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "variantCover" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A description of the variant cover
    	for the issue, if the issue is a variant printing. For example, "Bryan Hitch
    	Variant Cover" or "2nd Printing Variant".""" .

example:variesBy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "variesBy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates the property or properties by which the variants in a [[ProductGroup]] vary, e.g. their size, color etc. Schema.org properties can be referenced by their short name e.g. \"color\"; terms defined elsewhere can be referenced with their URIs." .

example:vatID a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vatID" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Value-added Tax ID of the organization or person." .

example:vehicleConfiguration a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleConfiguration" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A short text indicating the configuration of the vehicle, e.g. '5dr hatchback ST 2.5 MT 225 hp' or 'limited edition'." .

example:vehicleEngine a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleEngine" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Information about the engine or engines of the vehicle." .

example:vehicleIdentificationNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleIdentificationNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The Vehicle Identification Number (VIN) is a unique serial number used by the automotive industry to identify individual motor vehicles." .

example:vehicleInteriorColor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleInteriorColor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The color or color combination of the interior of the vehicle." .

example:vehicleInteriorType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleInteriorType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type or material of the interior of the vehicle (e.g. synthetic fabric, leather, wood, etc.). While most interior types are characterized by the material used, an interior type can also be based on vehicle usage or target audience." .

example:vehicleModelDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleModelDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The release date of a vehicle model (often used to differentiate versions of the same make and model)." .

example:vehicleSeatingCapacity a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleSeatingCapacity" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons." .

example:vehicleSpecialUsage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleSpecialUsage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether the vehicle has been used for special purposes, like commercial rental, driving school, or as a taxi. The legislation in many countries requires this information to be revealed when offering a car for sale." .

example:vehicleTransmission a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vehicleTransmission" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of component used for transmitting the power from a rotating power source to the wheels or other relevant component(s) (\"gearbox\" for cars)." .

example:vendor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vendor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "'vendor' is an earlier term for 'seller'." .

example:verificationFactCheckingPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "verificationFactCheckingPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Disclosure about verification and fact-checking processes for a [[NewsMediaOrganization]] or other fact-checking [[Organization]]." .

example:version a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "version" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The version of the CreativeWork embodied by a specified resource." .

example:video a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "video" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An embedded video object." .

example:videoFormat a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "videoFormat" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of screening or video broadcast used (e.g. IMAX, 3D, SD, HD, etc.)." .

example:videoFrameSize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "videoFrameSize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The frame size of the video." .

example:videoQuality a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "videoQuality" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The quality of the video." .

example:volumeNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "volumeNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\"." .

example:warning a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "warning" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any FDA or other warnings about the drug (text or URL)." .

example:warranty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "warranty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The warranty promise(s) included in the offer." .

example:warrantyPromise a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "warrantyPromise" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The warranty promise(s) included in the offer." .

example:warrantyScope a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "warrantyScope" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The scope of the warranty promise." .

example:webCheckinTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "webCheckinTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time when a passenger can check into the flight online." .

example:webFeed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "webFeed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The URL for a feed, e.g. associated with a podcast series, blog, or series of date-stamped updates. This is usually RSS or Atom." .

example:weight a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "weight" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The weight of the product or person." .

example:weightTotal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "weightTotal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The permitted total weight of the loaded vehicle, including passengers and cargo and the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

example:wheelbase a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "wheelbase" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The distance between the centers of the front and rear wheels.\\n\\nTypical unit code(s): CMT for centimeters, MTR for meters, INH for inches, FOT for foot/feet" .

example:width a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "width" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The width of the item." .

example:winner a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "winner" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of participant. The winner of the action." .

example:wordCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "wordCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of words in the text of the Article." .

example:workExample a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workExample" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Example/instance/realization/derivation of the concept of this creative work. eg. The paperback edition, first edition, or eBook." .

example:workFeatured a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workFeatured" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A work featured in some event, e.g. exhibited in an ExhibitionEvent.
       Specific subproperties are available for workPerformed (e.g. a play), or a workPresented (a Movie at a ScreeningEvent).""" .

example:workHours a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workHours" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The typical working hours for this job (e.g. 1st shift, night shift, 8am-5pm)." .

example:workLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A contact location for a person's place of work." .

example:workPerformed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workPerformed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A work performed in some event, for example a play performed in a TheaterEvent." .

example:workPresented a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workPresented" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The movie presented during this event." .

example:workTranslation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workTranslation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A work that is a translation of the content of this work. e.g. è¥¿éŠè¨˜ has an English workTranslation â€œJourney to the Westâ€,a German workTranslation â€œMonkeys Pilgerfahrtâ€ and a Vietnamese  translation TÃ¢y du kÃ½ bÃ¬nh kháº£o." .

example:workload a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "workload" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Quantitative measure of the physiologic output of the exercise; also referred to as energy expenditure." .

example:worksFor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "worksFor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Organizations that the person works for." .

example:worstRating a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "worstRating" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The lowest value allowed in this rating system. If worstRating is omitted, 1 is assumed." .

example:xpath a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "xpath" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An XPath, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." .

example:yearBuilt a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "yearBuilt" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The year an [[Accommodation]] was constructed. This corresponds to the [YearBuilt field in RESO](https://ddwiki.reso.org/display/DDW17/YearBuilt+Field). " .

example:yearlyRevenue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "yearlyRevenue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The size of the business in annual revenue." .

example:yearsInOperation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "yearsInOperation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The age of the business." .

example:yield a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "yield" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The quantity that results by performing instructions. For example, a paper airplane, 10 personalized candles." .

example:AddAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AddAction" ;
    rdfs:subClassOf example:UpdateAction ;
    ns1:exactMatch <http://schema.org/AddAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of editing by adding an object to a collection." .

example:AggregateRating a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AggregateRating" ;
    rdfs:subClassOf example:Rating ;
    ns1:exactMatch <http://schema.org/AggregateRating> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The average rating based on multiple ratings or reviews." .

example:AudioObject a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AudioObject" ;
    rdfs:subClassOf example:MediaObject ;
    ns1:exactMatch <http://schema.org/AudioObject> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An audio file." .

example:BlogPosting a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "BlogPosting" ;
    rdfs:subClassOf example:SocialMediaPosting ;
    ns1:exactMatch <http://schema.org/BlogPosting> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A blog post." .

example:Book a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Book" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Book> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A book." .

example:BroadcastService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "BroadcastService" ;
    rdfs:subClassOf example:Service ;
    ns1:exactMatch <http://schema.org/BroadcastService> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A delivery service through which content is provided via broadcast over the air or online." .

example:ChooseAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ChooseAction" ;
    rdfs:subClassOf example:AssessAction ;
    ns1:exactMatch <http://schema.org/ChooseAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of expressing a preference from a set of options or a large or unbounded set of choices/options." .

example:Church a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Church" ;
    rdfs:subClassOf example:PlaceOfWorship ;
    ns1:exactMatch <http://schema.org/Church> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A church." .

example:Class a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Class" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Class> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A class, also often called a 'Type'; equivalent to rdfs:Class." .

example:CollectionPage a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CollectionPage" ;
    rdfs:subClassOf example:WebPage ;
    ns1:exactMatch <http://schema.org/CollectionPage> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Web page type: Collection page." .

example:ContactPoint a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ContactPoint" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/ContactPoint> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A contact point&#x2014;for example, a Customer Complaints department." .

example:CoverArt a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CoverArt" ;
    rdfs:subClassOf example:VisualArtwork ;
    ns1:exactMatch <http://schema.org/CoverArt> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The artwork on the outer surface of a CreativeWork." .

example:DataFeed a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataFeed" ;
    rdfs:subClassOf example:Dataset ;
    ns1:exactMatch <http://schema.org/DataFeed> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A single feed providing structured information about one or more entities or topics." .

example:Dataset a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Dataset> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A body of structured information describing some topic(s) of interest." .

example:DefinedTerm a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DefinedTerm" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/DefinedTerm> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A word, name, acronym, phrase, etc. with a formal definition. Often used in the context of category or subject classification, glossaries or dictionaries, product or creative work types, etc. Use the name property for the term being defined, use termCode if the term has an alpha-numeric code allocated, use description to provide the definition of the term." .

example:DefinedTermSet a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DefinedTermSet" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/DefinedTermSet> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A set of defined terms for example a set of categories or a classification scheme, a glossary, dictionary or enumeration." .

example:EducationalOccupationalProgram a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "EducationalOccupationalProgram" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/EducationalOccupationalProgram> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A program offered by an institution which determines the learning progress to achieve an outcome, usually a credential like a degree or certificate. This would define a discrete set of opportunities (e.g., job, courses) that together constitute a program with a clear start, end, set of requirements, and transition to a new occupational opportunity (e.g., a job), or sometimes a higher educational opportunity (e.g., an advanced degree)." .

example:GeoShape a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "GeoShape" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/GeoShape> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The geographic shape of a place. A GeoShape can be described using several properties whose values are based on latitude/longitude pairs. Either whitespace or commas can be used to separate latitude and longitude; whitespace should be used when writing a list of several such points." .

example:GovernmentOffice a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "GovernmentOffice" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/GovernmentOffice> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A government office&#x2014;for example, an IRS or DMV office." .

example:Grant a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Grant" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Grant> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A grant, typically financial or otherwise quantifiable, of resources. Typically a [[funder]] sponsors some [[MonetaryAmount]] to an [[Organization]] or [[Person]],
    sometimes not necessarily via a dedicated or long-lived [[Project]], resulting in one or more outputs, or [[fundedItem]]s. For financial sponsorship, indicate the [[funder]] of a [[MonetaryGrant]]. For non-financial support, indicate [[sponsor]] of [[Grant]]s of resources (e.g. office space).

Grants support  activities directed towards some agreed collective goals, often but not always organized as [[Project]]s. Long-lived projects are sometimes sponsored by a variety of grants over time, but it is also common for a project to be associated with a single grant.

The amount of a [[Grant]] is represented using [[amount]] as a [[MonetaryAmount]].
    """ .

example:House a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "House" ;
    rdfs:subClassOf example:Accommodation ;
    ns1:exactMatch <http://schema.org/House> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A house is a building or structure that has the ability to be occupied for habitation by humans or other creatures (Source: Wikipedia, the free encyclopedia, see <a href=\"http://en.wikipedia.org/wiki/House\">http://en.wikipedia.org/wiki/House</a>)." .

example:HowTo a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "HowTo" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/HowTo> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Instructions that explain how to achieve a result by performing a sequence of steps." .

example:LoanOrCredit a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LoanOrCredit" ;
    rdfs:subClassOf example:FinancialProduct ;
    ns1:exactMatch <http://schema.org/LoanOrCredit> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A financial product for the loaning of an amount of money, or line of credit, under agreed terms and charges." .

example:MedicalClinic a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalClinic" ;
    rdfs:subClassOf example:MedicalOrganization ;
    ns1:exactMatch <http://schema.org/MedicalClinic> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A facility, often associated with a hospital or medical school, that is devoted to the specific diagnosis and/or healthcare. Previously limited to outpatients but with evolution it may be open to inpatients as well." .

example:MedicalSign a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalSign" ;
    rdfs:subClassOf example:MedicalSignOrSymptom ;
    ns1:exactMatch <http://schema.org/MedicalSign> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any physical manifestation of a person's medical condition discoverable by objective diagnostic tests or physical examination." .

example:Message a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Message" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Message> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A single message from a sender to one or more organizations or people." .

example:OrganizationRole a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "OrganizationRole" ;
    rdfs:subClassOf example:Role ;
    ns1:exactMatch <http://schema.org/OrganizationRole> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A subclass of Role used to describe roles within organizations." .

example:PaymentCard a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PaymentCard" ;
    rdfs:subClassOf example:PaymentMethod ;
    ns1:exactMatch <http://schema.org/PaymentCard> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A payment method using a credit, debit, store or other card to associate the payment with an account." .

example:PaymentMethod a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PaymentMethod" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/PaymentMethod> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A payment method is a standardized procedure for transferring the monetary amount for a purchase. Payment methods are characterized by the legal and technical structures used, and by the organization or group carrying out the transaction.\\n\\nCommonly used values:\\n\\n* http://purl.org/goodrelations/v1#ByBankTransferInAdvance\\n* http://purl.org/goodrelations/v1#ByInvoice\\n* http://purl.org/goodrelations/v1#Cash\\n* http://purl.org/goodrelations/v1#CheckInAdvance\\n* http://purl.org/goodrelations/v1#COD\\n* http://purl.org/goodrelations/v1#DirectDebit\\n* http://purl.org/goodrelations/v1#GoogleCheckout\\n* http://purl.org/goodrelations/v1#PayPal\\n* http://purl.org/goodrelations/v1#PaySwarm
        """ .

example:Permit a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Permit" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Permit> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A permit issued by an organization, e.g. a parking pass." .

example:Person a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Person" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Person> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person (alive, dead, undead, or fictional)." .

example:PhysicalActivity a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PhysicalActivity" ;
    rdfs:subClassOf example:LifestyleModification ;
    ns1:exactMatch <http://schema.org/PhysicalActivity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any bodily activity that enhances or maintains physical fitness and overall health and wellness. Includes activity that is part of daily living and routine, structured exercise, and exercise prescribed as part of a medical treatment or recovery plan." .

example:PropertyValue a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PropertyValue" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/PropertyValue> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A property-value pair, e.g. representing a feature of a product or place. Use the 'name' property for the name of the property. If there is an additional human-readable version of the value, put that into the 'description' property.\\n\\n Always use specific schema.org properties when a) they exist and b) you can populate them. Using PropertyValue as a substitute will typically not trigger the same effect as using the original, specific property.
    """ .

example:PublicationIssue a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PublicationIssue" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/PublicationIssue> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A part of a successively published publication such as a periodical or publication volume, often numbered, usually containing a grouping of works such as articles.\\n\\nSee also [blog post](http://blog.schema.org/2014/09/schemaorg-support-for-bibliographic_2.html)." .

example:QuantitativeValueDistribution a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "QuantitativeValueDistribution" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/QuantitativeValueDistribution> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A statistical distribution of values." .

example:ScholarlyArticle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ScholarlyArticle" ;
    rdfs:subClassOf example:Article ;
    ns1:exactMatch <http://schema.org/ScholarlyArticle> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A scholarly article." .

example:SizeGroupEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "SizeGroupEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/SizeGroupEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerates common size groups for various product categories." .

example:SizeSystemEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "SizeSystemEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/SizeSystemEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerates common size systems for different categories of products, for example \"EN-13402\" or \"UK\" for wearables or \"Imperial\" for screws." .

example:Specialty a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Specialty" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/Specialty> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any branch of a field in which people typically develop specific expertise, usually after significant study, time, and effort." .

example:SportsOrganization a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "SportsOrganization" ;
    rdfs:subClassOf example:Organization ;
    ns1:exactMatch <http://schema.org/SportsOrganization> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents the collection of all sports organizations, including sports teams, governing bodies, and sports associations." .

example:TechArticle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "TechArticle" ;
    rdfs:subClassOf example:Article ;
    ns1:exactMatch <http://schema.org/TechArticle> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A technical article - Example: How-to (task) topics, step-by-step, procedural troubleshooting, specifications, etc." .

example:UseAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "UseAction" ;
    rdfs:subClassOf example:ConsumeAction ;
    ns1:exactMatch <http://schema.org/UseAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of applying an object to its intended purpose." .

example:VideoObject a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "VideoObject" ;
    rdfs:subClassOf example:MediaObject ;
    ns1:exactMatch <http://schema.org/VideoObject> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A video file." .

example:VisualArtwork a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "VisualArtwork" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/VisualArtwork> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A work of art that is primarily visual in character." .

example:WebContent a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "WebContent" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/WebContent> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "WebContent is a type representing all [[WebPage]], [[WebSite]] and [[WebPageElement]] content. It is sometimes the case that detailed distinctions between Web pages, sites and their parts is not always important or obvious. The  [[WebContent]] type makes it easier to describe Web-addressable content without requiring such distinctions to always be stated. (The intent is that the existing types [[WebPage]], [[WebSite]] and [[WebPageElement]] will eventually be declared as subtypes of [[WebContent]])." .

example:BroadcastChannel a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "BroadcastChannel" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/BroadcastChannel> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A unique instance of a BroadcastService on a CableOrSatelliteService lineup." .

example:EmergencyService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "EmergencyService" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/EmergencyService> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An emergency service, such as a fire station or ER." .

example:EnergyEfficiencyEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "EnergyEfficiencyEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/EnergyEfficiencyEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerates energy efficiency levels (also known as \"classes\" or \"ratings\") and certifications that are part of several international energy efficiency standards." .

example:HowToItem a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "HowToItem" ;
    rdfs:subClassOf example:ListItem ;
    ns1:exactMatch <http://schema.org/HowToItem> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An item used as either a tool or supply when performing the instructions for how to to achieve a result." .

example:ImageObject a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ImageObject" ;
    rdfs:subClassOf example:MediaObject ;
    ns1:exactMatch <http://schema.org/ImageObject> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An image file." .

example:InformAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "InformAction" ;
    rdfs:subClassOf example:CommunicateAction ;
    ns1:exactMatch <http://schema.org/InformAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of notifying someone of information pertinent to them, with no expectation of a response." .

example:InsertAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "InsertAction" ;
    rdfs:subClassOf example:AddAction ;
    ns1:exactMatch <http://schema.org/InsertAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of adding at a specific location in an ordered collection." .

example:ItemList a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ItemList" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/ItemList> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A list of items of any sort&#x2014;for example, Top 10 Movies About Weathermen, or Top 100 Party Songs. Not to be confused with HTML lists, which are often used only for formatting." .

example:LearningResource a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LearningResource" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/LearningResource> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The LearningResource type can be used to indicate [[CreativeWork]]s (whether physical or digital) that have a particular and explicit orientation towards learning, education, skill acquisition, and other educational purposes.

[[LearningResource]] is expected to be used as an addition to a primary type such as [[Book]], [[VideoObject]], [[Product]] etc.

[[EducationEvent]] serves a similar purpose for event-like things (e.g. a [[Trip]]). A [[LearningResource]] may be created as a result of an [[EducationEvent]], for example by recording one.""" .

example:LegalService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LegalService" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/LegalService> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A LegalService is a business that provides legally-oriented services, advice and representation, e.g. law firms.\\n\\nAs a [[LocalBusiness]] it can be described as a [[provider]] of one or more [[Service]]\\(s)." .

example:LifestyleModification a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LifestyleModification" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/LifestyleModification> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A process of care involving exercise, changes to diet, fitness routines, and other lifestyle changes aimed at improving a health condition." .

example:MeasurementTypeEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MeasurementTypeEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/MeasurementTypeEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumeration of common measurement types (or dimensions), for example \"chest\" for a person, \"inseam\" for pants, \"gauge\" for screws, or \"wheel\" for bicycles." .

example:MediaGallery a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MediaGallery" ;
    rdfs:subClassOf example:CollectionPage ;
    ns1:exactMatch <http://schema.org/MediaGallery> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Web page type: Media gallery page. A mixed-media page that can contains media such as images, videos, and other multimedia." .

example:MedicalCondition a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalCondition" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalCondition> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any condition of the human body that affects the normal functioning of a person, whether physically or mentally. Includes diseases, injuries, disabilities, disorders, syndromes, etc." .

example:MedicalGuideline a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalGuideline" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalGuideline> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any recommendation made by a standard society (e.g. ACC/AHA) or consensus statement that denotes how to diagnose and treat a particular condition. Note: this type should be used to tag the actual guideline recommendation; if the guideline recommendation occurs in a larger scholarly article, use MedicalScholarlyArticle to tag the overall article, not this type. Note also: the organization making the recommendation should be captured in the recognizingAuthority base property of MedicalEntity." .

example:MedicalRiskEstimator a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalRiskEstimator" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalRiskEstimator> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any rule set or interactive tool for estimating the risk of developing a complication or condition." .

example:MedicalSignOrSymptom a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalSignOrSymptom" ;
    rdfs:subClassOf example:MedicalCondition ;
    ns1:exactMatch <http://schema.org/MedicalSignOrSymptom> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any feature associated or not with a medical condition. In medicine a symptom is generally subjective while a sign is objective." .

example:MedicalStudy a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalStudy" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalStudy> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical study is an umbrella type covering all kinds of research studies relating to human medicine or health, including observational studies and interventional trials and registries, randomized, controlled or not. When the specific type of study is known, use one of the extensions of this type, such as MedicalTrial or MedicalObservationalStudy. Also, note that this type should be used to mark up data that describes the study itself; to tag an article that publishes the results of a study, use MedicalScholarlyArticle. Note: use the code property of MedicalEntity to store study IDs, e.g. clinicaltrials.gov ID." .

example:MusicPlaylist a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MusicPlaylist" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/MusicPlaylist> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A collection of music tracks in playlist form." .

example:Number a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Number" ;
    ns1:exactMatch <http://schema.org/Number> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Data type: Number.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

example:PeopleAudience a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PeopleAudience" ;
    rdfs:subClassOf example:Audience ;
    ns1:exactMatch <http://schema.org/PeopleAudience> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A set of characteristics belonging to people, e.g. who compose an item's target audience." .

example:Periodical a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Periodical" ;
    rdfs:subClassOf example:CreativeWorkSeries ;
    ns1:exactMatch <http://schema.org/Periodical> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A publication in any medium issued in successive parts bearing numerical or chronological designations and intended, such as a magazine, scholarly journal, or newspaper to continue indefinitely.\\n\\nSee also [blog post](http://blog.schema.org/2014/09/schemaorg-support-for-bibliographic_2.html)." .

example:PlayAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PlayAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/PlayAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of playing/exercising/training/performing for enjoyment, leisure, recreation, Competition or exercise.\\n\\nRelated actions:\\n\\n* [[ListenAction]]: Unlike ListenAction (which is under ConsumeAction), PlayAction refers to performing for an audience or at an event, rather than consuming music.\\n* [[WatchAction]]: Unlike WatchAction (which is under ConsumeAction), PlayAction refers to showing/displaying for an audience or at an event, rather than consuming visual content." .

example:Project a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Project" ;
    rdfs:subClassOf example:Organization ;
    ns1:exactMatch <http://schema.org/Project> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.
Use properties from [[Organization]], [[subOrganization]]/[[parentOrganization]] to indicate project sub-structures. 
   """ .

example:PublicationEvent a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PublicationEvent" ;
    rdfs:subClassOf example:Event ;
    ns1:exactMatch <http://schema.org/PublicationEvent> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A PublicationEvent corresponds indifferently to the event of publication for a CreativeWork of any type e.g. a broadcast event, an on-demand event, a book/journal publication via a variety of delivery media." .

example:RadioChannel a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "RadioChannel" ;
    rdfs:subClassOf example:BroadcastChannel ;
    ns1:exactMatch <http://schema.org/RadioChannel> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A unique instance of a radio BroadcastService on a CableOrSatelliteService lineup." .

example:Rating a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Rating" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Rating> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A rating is an evaluation on a numeric scale, such as 1 to 5 stars." .

example:Residence a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Residence" ;
    rdfs:subClassOf example:Place ;
    ns1:exactMatch <http://schema.org/Residence> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place where a person lives." .

example:Room a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Room" ;
    rdfs:subClassOf example:Accommodation ;
    ns1:exactMatch <http://schema.org/Room> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A room is a distinguishable space within a structure, usually separated from other spaces by interior walls. (Source: Wikipedia, the free encyclopedia, see <a href="http://en.wikipedia.org/wiki/Room">http://en.wikipedia.org/wiki/Room</a>).
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" .

example:Series a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Series" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Series> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A Series in schema.org is a group of related items, typically but not necessarily of the same kind. See also [[CreativeWorkSeries]], [[EventSeries]]." .

example:SocialMediaPosting a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "SocialMediaPosting" ;
    rdfs:subClassOf example:Article ;
    ns1:exactMatch <http://schema.org/SocialMediaPosting> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A post to a social media platform, including blog posts, tweets, Facebook posts, etc." .

example:Substance a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Substance" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/Substance> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical." .

example:TherapeuticProcedure a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "TherapeuticProcedure" ;
    rdfs:subClassOf example:MedicalProcedure ;
    ns1:exactMatch <http://schema.org/TherapeuticProcedure> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical procedure intended primarily for therapeutic purposes, aimed at improving a health condition." .

example:AchieveAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AchieveAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/AchieveAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of accomplishing something via previous efforts. It is an instantaneous action rather than an ongoing process." .

example:Comment a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Comment" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Comment> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A comment on an item - for example, a comment on a blog post. The comment's content is expressed via the [[text]] property, and its topic via [[about]], properties shared with all CreativeWorks." .

example:CreativeWorkSeason a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CreativeWorkSeason" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/CreativeWorkSeason> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media season e.g. tv, radio, video game etc." .

example:DoseSchedule a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DoseSchedule" ;
    rdfs:subClassOf example:MedicalIntangible ;
    ns1:exactMatch <http://schema.org/DoseSchedule> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A specific dosing schedule for a drug or supplement." .

example:Episode a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Episode" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Episode> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media episode (e.g. TV, radio, video game) which can be part of a series or season." .

example:FindAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "FindAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/FindAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of finding an object.\\n\\nRelated actions:\\n\\n* [[SearchAction]]: FindAction is generally lead by a SearchAction, but not necessarily." .

example:InvestmentOrDeposit a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "InvestmentOrDeposit" ;
    rdfs:subClassOf example:FinancialProduct ;
    ns1:exactMatch <http://schema.org/InvestmentOrDeposit> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A type of financial product that typically requires the client to transfer funds to a financial service in return for potential beneficial financial return." .

example:MedicalIndication a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalIndication" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalIndication> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A condition or factor that indicates use of a medical therapy, including signs, symptoms, risk factors, anatomical states, etc." .

example:MoveAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MoveAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/MoveAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of an agent relocating to a place.\\n\\nRelated actions:\\n\\n* [[TransferAction]]: Unlike TransferAction, the subject of the move is a living Person or Organization rather than an inanimate object." .

example:NonprofitType a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "NonprofitType" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/NonprofitType> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "NonprofitType enumerates several kinds of official non-profit types of which a non-profit organization can be." .

example:Offer a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Offer" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Offer> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An offer to transfer some rights to an item or to provide a service â€” for example, an offer to sell tickets to an event, to rent the DVD of a movie, to stream a TV show over the internet, to repair a motorcycle, or to loan a book.\\n\\nNote: As the [[businessFunction]] property, which identifies the form of offer (e.g. sell, lease, repair, dispose), defaults to http://purl.org/goodrelations/v1#Sell; an Offer without a defined businessFunction value can be assumed to be an offer to sell.\\n\\nFor [GTIN](http://www.gs1.org/barcodes/technical/idkeys/gtin)-related fields, see [Check Digit calculator](http://www.gs1.org/barcodes/support/check_digit_calculator) and [validation guide](http://www.gs1us.org/resources/standards/gtin-validation-guide) from [GS1](http://www.gs1.org/)." .

example:PerformingGroup a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PerformingGroup" ;
    rdfs:subClassOf example:Organization ;
    ns1:exactMatch <http://schema.org/PerformingGroup> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A performance group, such as a band, an orchestra, or a circus." .

example:PlanAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PlanAction" ;
    rdfs:subClassOf example:OrganizeAction ;
    ns1:exactMatch <http://schema.org/PlanAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of planning the execution of an event/task/action/reservation/plan to a future date." .

example:Role a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Role" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Role> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Represents additional information about a relationship or property. For example a Role can be used to say that a 'member' role linking some SportsTeam to a player occurred during a particular time period. Or that a Person's 'actor' role in a Movie was for some particular characterName. Such properties can be attached to a Role entity, which is then associated with the main entities using ordinary properties like 'member' or 'actor'.\\n\\nSee also [blog post](http://blog.schema.org/2014/06/introducing-role.html)." .

example:SoftwareApplication a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "SoftwareApplication" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/SoftwareApplication> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A software application." .

example:UpdateAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "UpdateAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/UpdateAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of managing by changing/editing the state of the object." .

example:Vessel a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Vessel" ;
    rdfs:subClassOf example:AnatomicalStructure ;
    ns1:exactMatch <http://schema.org/Vessel> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A component of the human body circulatory system comprised of an intricate network of hollow tubes that transport blood throughout the entire body." .

example:AdministrativeArea a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AdministrativeArea" ;
    rdfs:subClassOf example:Place ;
    ns1:exactMatch <http://schema.org/AdministrativeArea> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A geographical region, typically under the jurisdiction of a particular government." .

example:AllocateAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AllocateAction" ;
    rdfs:subClassOf example:OrganizeAction ;
    ns1:exactMatch <http://schema.org/AllocateAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of organizing tasks/objects/events by associating resources to it." .

example:AssessAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AssessAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/AssessAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of forming one's opinion, reaction or sentiment." .

example:Audience a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Audience" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Audience> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Intended audience for an item, i.e. the group for whom the item was created." .

example:BioChemEntity a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "BioChemEntity" ;
    ns2:source <http://bioschemas.org> ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/BioChemEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any biological, chemical, or biochemical thing. For example: a protein; a gene; a chemical; a synthetic chemical." .

example:Clip a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Clip" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Clip> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A short TV or radio program or a segment/part of a program." .

example:ControlAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ControlAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/ControlAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An agent controls a device or application." .

example:DigitalDocument a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "DigitalDocument" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/DigitalDocument> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An electronic file or document." .

example:FinancialService a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "FinancialService" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/FinancialService> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Financial services business." .

example:Landform a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Landform" ;
    rdfs:subClassOf example:Place ;
    ns1:exactMatch <http://schema.org/Landform> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A landform or physical feature.  Landform elements include mountains, plains, lakes, rivers, seascape and oceanic waterbody interface features such as bays, peninsulas, seas and so forth, including sub-aqueous terrain features such as submersed mountain ranges, volcanoes, and the great ocean basins." .

example:MedicalProcedure a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalProcedure" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalProcedure> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A process of care used in either a diagnostic, therapeutic, preventive or palliative capacity that relies on invasive (surgical), non-invasive, or other techniques." .

example:MedicalTest a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalTest" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalTest> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any medical test, typically performed for diagnostic purposes." .

example:OrganizeAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "OrganizeAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/OrganizeAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of manipulating/administering/supervising/controlling one or more objects." .

example:PriceSpecification a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PriceSpecification" ;
    rdfs:subClassOf example:StructuredValue ;
    ns1:exactMatch <http://schema.org/PriceSpecification> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A structured value representing a price or price range. Typically, only the subclasses of this type are used for markup. It is recommended to use [[MonetaryAmount]] to describe independent amounts of money such as a salary, credit card limits, etc." .

example:QualitativeValue a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "QualitativeValue" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/QualitativeValue> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A predefined value for a product characteristic, e.g. the power cord plug type 'US' or the garment sizes 'S', 'M', 'L', and 'XL'." .

example:Quantity a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Quantity" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Quantity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Quantities such as distance, time, mass, weight, etc. Particular instances of say Mass are entities like '3 Kg' or '4 milligrams'." .

example:Text a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Text" ;
    ns1:exactMatch <http://schema.org/Text> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Data type: Text." .

example:Vehicle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Vehicle" ;
    rdfs:subClassOf example:Product ;
    ns1:exactMatch <http://schema.org/Vehicle> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A vehicle is a device that is designed or used to transport people or cargo over land, water, air, or through space." .

example:Accommodation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Accommodation" ;
    rdfs:subClassOf example:Place ;
    ns1:exactMatch <http://schema.org/Accommodation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """An accommodation is a place that can accommodate human beings, e.g. a hotel room, a camping pitch, or a meeting room. Many accommodations are for overnight stays, but this is not a mandatory requirement.
For more specific types of accommodations not defined in schema.org, one can use additionalType with external vocabularies.
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" .

example:FinancialProduct a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "FinancialProduct" ;
    rdfs:subClassOf example:Service ;
    ns1:exactMatch <http://schema.org/FinancialProduct> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A product provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies which comprise the financial services industry." .

example:GovernmentBuilding a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "GovernmentBuilding" ;
    rdfs:subClassOf example:CivicStructure ;
    ns1:exactMatch <http://schema.org/GovernmentBuilding> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A government building." .

example:HealthAndBeautyBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "HealthAndBeautyBusiness" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/HealthAndBeautyBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Health and beauty." .

example:ListItem a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ListItem" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/ListItem> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An list item, e.g. a step in a checklist or how-to description." .

example:MedicalTherapy a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalTherapy" ;
    rdfs:subClassOf example:TherapeuticProcedure ;
    ns1:exactMatch <http://schema.org/MedicalTherapy> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any medical intervention designed to prevent, treat, and cure human diseases and medical conditions, including both curative and palliative therapies. Medical therapies are typically processes of care relying upon pharmacotherapy, behavioral therapy, supportive therapy (with fluid or nutrition for example), or detoxification (e.g. hemodialysis) aimed at improving or preventing a health condition." .

example:PlaceOfWorship a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "PlaceOfWorship" ;
    rdfs:subClassOf example:CivicStructure ;
    ns1:exactMatch <http://schema.org/PlaceOfWorship> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Place of worship, such as a church, synagogue, or mosque." .

example:Trip a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Trip" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Trip> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A trip or journey. An itinerary of visits to one or more places." .

example:CreateAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CreateAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/CreateAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of deliberately creating/producing/generating/building a result out of the agent." .

example:EducationalOrganization a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "EducationalOrganization" ;
    rdfs:subClassOf example:Organization ;
    ns1:exactMatch <http://schema.org/EducationalOrganization> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An educational organization." .

example:LodgingBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LodgingBusiness" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/LodgingBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A lodging business, such as a motel, hotel, or inn." .

example:MedicalIntangible a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalIntangible" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/MedicalIntangible> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A utility class that serves as the umbrella for a number of 'intangible' things in the medical space." .

example:NewsArticle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "NewsArticle" ;
    rdfs:subClassOf example:Article ;
    ns1:exactMatch <http://schema.org/NewsArticle> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A NewsArticle is an article whose content reports news, or provides background context and supporting materials for understanding the news.

A more detailed overview of [schema.org News markup](/docs/news.html) is also available.
""" .

example:Product a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Product" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Product> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any offered product or service. For example: a pair of shoes; a concert ticket; the rental of a car; a haircut; or an episode of a TV show streamed online." .

example:ReactAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReactAction" ;
    rdfs:subClassOf example:AssessAction ;
    ns1:exactMatch <http://schema.org/ReactAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of responding instinctively and emotionally to an object, expressing a sentiment." .

example:Review a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Review" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Review> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A review of an item - for example, of a restaurant, movie, or store." .

example:WebPageElement a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "WebPageElement" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/WebPageElement> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A web page element, like a table or an image." .

example:AnatomicalStructure a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AnatomicalStructure" ;
    rdfs:subClassOf example:MedicalEntity ;
    ns1:exactMatch <http://schema.org/AnatomicalStructure> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any part of the human body, typically a component of an anatomical system. Organs, tissues, and cells are all anatomical structures." .

example:Article a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Article" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/Article> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An article, such as a news article or piece of investigative report. Newspapers and magazines have articles of many different types and this is intended to cover them all.\\n\\nSee also [blog post](http://blog.schema.org/2014/09/schemaorg-support-for-bibliographic_2.html)." .

example:CreativeWorkSeries a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CreativeWorkSeries" ;
    rdfs:subClassOf example:Series ;
    ns1:exactMatch <http://schema.org/CreativeWorkSeries> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A CreativeWorkSeries in schema.org is a group of related items, typically but not necessarily of the same kind. CreativeWorkSeries are usually organized into some order, often chronological. Unlike [[ItemList]] which is a general purpose data structure for lists of things, the emphasis with CreativeWorkSeries is on published materials (written e.g. books and periodicals, or media such as tv, radio and games).\\n\\nSpecific subtypes are available for describing [[TVSeries]], [[RadioSeries]], [[MovieSeries]], [[BookSeries]], [[Periodical]] and [[VideoGameSeries]]. In each case, the [[hasPart]] / [[isPartOf]] properties can be used to relate the CreativeWorkSeries to its parts. The general CreativeWorkSeries type serves largely just to organize these more specific and practical subtypes.\\n\\nIt is common for properties applicable to an item from the series to be usefully applied to the containing group. Schema.org attempts to anticipate some of these cases, but publishers should be free to apply properties of the series parts to the series as a whole wherever they seem appropriate.
	  """ .

example:EntertainmentBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "EntertainmentBusiness" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/EntertainmentBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A business providing entertainment." .

example:MediaObject a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MediaObject" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/MediaObject> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A media object, such as an image, video, or audio object embedded in a web page or a downloadable dataset i.e. DataDownload. Note that a creative work may have many media objects associated with it on the same web page. For example, a page about a single song (MusicRecording) may have a music video (VideoObject), and a high and low bandwidth audio stream (2 AudioObject's)." .

example:MedicalOrganization a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalOrganization" ;
    rdfs:subClassOf example:Organization ;
    ns1:exactMatch <http://schema.org/MedicalOrganization> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical organization (physical or not), such as hospital, institution or clinic." .

example:StatusEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "StatusEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/StatusEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Lists or enumerations dealing with status types." .

example:AutomotiveBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AutomotiveBusiness" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/AutomotiveBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Car repair, sales, or parts." .

example:BodyOfWater a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "BodyOfWater" ;
    rdfs:subClassOf example:Landform ;
    ns1:exactMatch <http://schema.org/BodyOfWater> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A body of water, such as a sea, ocean, or lake." .

example:CommunicateAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CommunicateAction" ;
    rdfs:subClassOf example:InteractAction ;
    ns1:exactMatch <http://schema.org/CommunicateAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of conveying information to another person via a communication medium (instrument) such as speech, email, or telephone conversation." .

example:ConsumeAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "ConsumeAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/ConsumeAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of ingesting information/resources/food." .

example:HomeAndConstructionBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "HomeAndConstructionBusiness" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/HomeAndConstructionBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A construction business.\\n\\nA HomeAndConstructionBusiness is a [[LocalBusiness]] that provides services around homes and buildings.\\n\\nAs a [[LocalBusiness]] it can be described as a [[provider]] of one or more [[Service]]\\(s)." .

example:Service a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Service" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Service> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A service provided by an organization, e.g. delivery service, print services, etc." .

example:FoodEstablishment a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "FoodEstablishment" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/FoodEstablishment> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A food-related business." .

example:InteractAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "InteractAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/InteractAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of interacting with another person or organization." .

example:Place a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Place" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Place> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Entities that have a somewhat fixed, physical extension." .

example:SportsActivityLocation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "SportsActivityLocation" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/SportsActivityLocation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sports location, such as a playing field." .

example:TradeAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "TradeAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/TradeAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of participating in an exchange of goods and services for monetary compensation. An agent trades an object, product or service with a participant in exchange for a one time or periodic payment." .

example:TransferAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "TransferAction" ;
    rdfs:subClassOf example:Action ;
    ns1:exactMatch <http://schema.org/TransferAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of transferring/moving (abstract or concrete) animate or inanimate objects from one place to another." .

example:UserInteraction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "UserInteraction" ;
    rdfs:subClassOf example:Event ;
    ns1:exactMatch <http://schema.org/UserInteraction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "UserInteraction and its subtypes is an old way of talking about users interacting with pages. It is generally better to use [[Action]]-based vocabulary, alongside types such as [[Comment]]." .

example:Reservation a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Reservation" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Reservation> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Describes a reservation for travel, dining or an event. Some reservations require tickets. \\n\\nNote: This type is for information about actual reservations, e.g. in confirmation emails or HTML pages with individual confirmations of reservations. For offers of tickets, restaurant reservations, flights, or rental cars, use [[Offer]]." .

example:Thing a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Thing" ;
    ns1:exactMatch <http://schema.org/Thing> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The most generic type of item." .

example:WebPage a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "WebPage" ;
    rdfs:subClassOf example:CreativeWork ;
    ns1:exactMatch <http://schema.org/WebPage> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A web page. Every web page is implicitly assumed to be declared to be of type WebPage, so the various properties about that webpage, such as <code>breadcrumb</code> may be used. We recommend explicit declaration if these properties are specified, but if they are found outside of an itemscope, they will be assumed to be about the page." .

example:MedicalEnumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalEnumeration" ;
    rdfs:subClassOf example:Enumeration ;
    ns1:exactMatch <http://schema.org/MedicalEnumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Enumerations related to health and the practice of medicine: A concept that is used to attribute a quality to another concept, as a qualifier, a collection of items or a listing of all of the elements of a set in medicine practice." .

example:Organization a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Organization" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Organization> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An organization such as a school, NGO, corporation, club, etc." .

example:Action a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Action" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Action> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An action performed by a direct agent and indirect participants upon a direct object. Optionally happens at a location with the help of an inanimate instrument. The execution of the action may produce a result. Specific action sub-type documentation specifies the exact expectation of each argument/role.\\n\\nSee also [blog post](http://blog.schema.org/2014/04/announcing-schemaorg-actions.html) and [Actions overview document](https://schema.org/docs/actions.html)." .

example:MedicalEntity a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalEntity" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/MedicalEntity> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The most generic type of entity related to health and the practice of medicine." .

example:MedicalBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "MedicalBusiness" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/MedicalBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A particular physical or virtual business of an organization for medical purposes. Examples of MedicalBusiness include differents business run by health professionals." .

example:Event a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Event" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Event> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An event happening at a certain time and location, such as a concert, lecture, or festival. Ticketing information may be added via the [[offers]] property. Repeated events may be structured as separate Event objects." .

example:CivicStructure a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CivicStructure" ;
    rdfs:subClassOf example:Place ;
    ns1:exactMatch <http://schema.org/CivicStructure> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A public structure, such as a town hall or concert hall." .

example:StructuredValue a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "StructuredValue" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/StructuredValue> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Structured values are used when the value of a property has a more complex structure than simply being a textual value or a reference to another thing." .

example:LocalBusiness a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "LocalBusiness" ;
    rdfs:subClassOf example:Place ;
    ns1:closeMatch <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:exactMatch <http://schema.org/LocalBusiness> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A particular physical business or branch of an organization. Examples of LocalBusiness include a restaurant, a particular branch of a restaurant chain, a branch of a bank, a medical practice, a club, a bowling alley, etc." .

example:Store a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Store" ;
    rdfs:subClassOf example:LocalBusiness ;
    ns1:exactMatch <http://schema.org/Store> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A retail good store." .

example:Enumeration a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Enumeration" ;
    rdfs:subClassOf example:Intangible ;
    ns1:exactMatch <http://schema.org/Enumeration> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Lists or enumerationsâ€”for example, a list of cuisines or music genres, etc." .

example:Intangible a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Intangible" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/Intangible> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A utility class that serves as the umbrella for a number of 'intangible' things such as quantities, structured values, etc." .

example:CreativeWork a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "CreativeWork" ;
    rdfs:subClassOf example:Thing ;
    ns1:exactMatch <http://schema.org/CreativeWork> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The most generic kind of creative work, including books, movies, photographs, software programs, etc." .

<http://example.org/example> a ns3:Ontology ;
    rdfs:label "example" .

