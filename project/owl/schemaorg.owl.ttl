example:recordedIn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recordedIn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The CreativeWork that captured all or part of this Event." .

example:recordingOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recordingOf" ;
    ns1:inScheme <http://example.org/example> ;
