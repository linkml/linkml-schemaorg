example:children a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "children" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A child of the person." .

example:cholesterolContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cholesterolContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of milligrams of cholesterol." .

example:circle a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "circle" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A circle is the circular region of a specified radius centered at a specified latitude and longitude. A circle is expressed as a pair followed by a radius in meters." .

example:citation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "citation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc." .

example:claimInterpreter a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "claimInterpreter" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """For a [[Claim]] interpreted from [[MediaObject]] content
    sed to indicate a claim contained, implied or refined from the content of a [[MediaObject]].""" .

example:claimReviewed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "claimReviewed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A short summary of the specific claims reviewed in a ClaimReview." .

example:clincalPharmacology a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "clincalPharmacology" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." .

example:clinicalPharmacology a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "clinicalPharmacology" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." .

example:clipNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "clipNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Position of the clip within an ordered group of clips." .

example:closes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "closes" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The closing hour of the place or service on the given day(s) of the week." .

example:coach a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "coach" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person that acts in a coaching role for a sports team." .

example:code a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "code" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A medical code for the entity, taken from a controlled vocabulary or ontology such as ICD-9, DiseasesDB, MeSH, SNOMED-CT, RxNorm, etc." .

example:codeRepository a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "codeRepository" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Link to the repository where the un-compiled, human readable code and related code is located (SVN, github, CodePlex)." .

example:codeSampleType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "codeSampleType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." .

example:codeValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "codeValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A short textual code that uniquely identifies the value." .

example:codingSystem a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "codingSystem" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The coding system, e.g. 'ICD-10'." .

example:colleague a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "colleague" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A colleague of the person." .

example:colleagues a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "colleagues" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A colleague of the person." .

example:collection a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "collection" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of object. The collection target of the action." .

example:collectionSize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "collectionSize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of items in the [[Collection]]." .

example:color a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "color" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The color of the product." .

example:colorist a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "colorist" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The individual who adds color to inked drawings." .

example:comment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "comment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Comments, typically from users." .

example:commentCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "commentCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of comments this CreativeWork (e.g. Article, Question or Answer) has received. This is most applicable to works published in Web sites with commenting system; additional comments may exist elsewhere." .

example:commentText a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "commentText" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The text of the UserComment." .

example:commentTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "commentTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time at which the UserComment was made." .

example:competencyRequired a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "competencyRequired" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Knowledge, skill, ability or personal attribute that must be demonstrated by a person or other entity in order to do something such as earn an Educational Occupational Credential or understand a LearningResource." .

example:competitor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "competitor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A competitor in a sports event." .

example:composer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "composer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person or organization who wrote a composition, or who is the composer of a work performed at some event." .

example:comprisedOf a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "comprisedOf" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifying something physically contained by something else. Typically used here for the underlying anatomical structures, such as organs, that comprise the anatomical system." .

example:conditionsOfAccess a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "conditionsOfAccess" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Conditions that affect the availability of, or method(s) of access to, an item. Typically used for real world items such as an [[ArchiveComponent]] held by an [[ArchiveOrganization]]. This property is not suitable for use as a general Web access control mechanism. It is expressed only in natural language.\\n\\nFor example \"Available by appointment from the Reading Room\" or \"Accessible only from logged-in accounts \". " .

example:confirmationNumber a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "confirmationNumber" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A number that confirms the given order or payment has been received." .

example:connectedTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "connectedTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Other anatomical structures to which this structure is connected." .

example:constrainingProperty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "constrainingProperty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Indicates a property used as a constraint to define a [[StatisticalPopulation]] with respect to the set of entities
  corresponding to an indicated type (via [[populationType]]).""" .

example:contactOption a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contactOption" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An option available on this contact point (e.g. a toll-free number or support for hearing-impaired callers)." .

example:contactPoint a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contactPoint" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A contact point for a person or organization." .

example:contactPoints a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contactPoints" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A contact point for a person or organization." .

example:contactType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contactType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A person or organization can have different contact points, for different purposes. For example, a sales contact point, a PR contact point and so on. This property is used to specify the kind of contact point." .

example:contactlessPayment a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contactlessPayment" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A secure method for consumers to purchase products or services via debit, credit or smartcards by using RFID or NFC technology." .

example:containedIn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containedIn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The basic containment relation between a place and one that contains it." .

example:containedInPlace a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containedInPlace" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The basic containment relation between a place and one that contains it." .

example:containsPlace a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containsPlace" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The basic containment relation between a place and another that it contains." .

example:containsSeason a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containsSeason" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A season that is part of the media series." .

example:contentLocation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contentLocation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The location depicted or described in the content. For example, the location in a photograph or painting." .

example:contentRating a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contentRating" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Official rating of a piece of content&#x2014;for example,'MPAA PG-13'." .

example:contentReferenceTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contentReferenceTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The specific time described by a creative work, for works (e.g. articles, video objects etc.) that emphasise a particular moment within an Event." .

example:contentSize a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contentSize" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "File size in (mega/kilo) bytes." .

example:contentType a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contentType" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The supported content type(s) for an EntryPoint response." .

example:contentUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contentUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Actual bytes of the media object, for example the image file or video file." .

example:contraindication a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contraindication" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A contraindication for this therapy." .

example:contributor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contributor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A secondary contributor to the CreativeWork or Event." .

example:cookTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cookTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time it takes to actually cook the dish, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

example:cookingMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cookingMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The method of cooking, such as Frying, Steaming, ..." .

example:copyrightHolder a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "copyrightHolder" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The party holding the legal copyright to the CreativeWork." .

example:copyrightNotice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "copyrightNotice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work." .

example:copyrightYear a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "copyrightYear" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The year during which the claimed copyright for the CreativeWork was first asserted." .

example:correction a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "correction" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a correction to a [[CreativeWork]], either via a [[CorrectionComment]], textually or in another document." .

example:correctionsPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "correctionsPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For an [[Organization]] (e.g. [[NewsMediaOrganization]]), a statement describing (in news media, the newsroomâ€™s) disclosure and correction policy for errors." .

example:costCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "costCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The category of cost, such as wholesale, retail, reimbursement cap, etc." .

example:costCurrency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "costCurrency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The currency (in 3-letter of the drug cost. See: http://en.wikipedia.org/wiki/ISO_4217. " .

example:costOrigin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "costOrigin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Additional details to capture the origin of the cost data. For example, 'Medicare Part B'." .

example:costPerUnit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "costPerUnit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The cost per unit of the drug." .

example:countriesNotSupported a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "countriesNotSupported" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Countries for which the application is not supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." .

example:countriesSupported a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "countriesSupported" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Countries for which the application is supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." .

example:countryOfAssembly a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "countryOfAssembly" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place where the product was assembled." .

example:countryOfLastProcessing a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "countryOfLastProcessing" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place where the item (typically [[Product]]) was last processed and tested before importation." .

example:countryOfOrigin a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "countryOfOrigin" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The country of origin of something, including products as well as creative  works such as movie and TV content.

In the case of TV and movie, this would be the country of the principle offices of the production company or individual responsible for the movie. For other kinds of [[CreativeWork]] it is difficult to provide fully general guidance, and properties such as [[contentLocation]] and [[locationCreated]] may be more applicable.

In the case of products, the country of origin of the product. The exact interpretation of this may vary by context and product type, and cannot be fully enumerated here.""" .

example:course a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "course" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of location. The course where this action was taken." .

example:courseCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "courseCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The identifier for the [[Course]] used by the course [[provider]] (e.g. CS101 or 6.001)." .

example:courseMode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "courseMode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The medium or means of delivery of the course instance or the mode of study, either as a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or as a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous )." .

example:coursePrerequisites a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "coursePrerequisites" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Requirements for taking the Course. May be completion of another [[Course]] or a textual description like \"permission of instructor\". Requirements may be a pre-requisite competency, referenced using [[AlignmentObject]]." .

example:courseWorkload a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "courseWorkload" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of work expected of students taking the course, often provided as a figure per week or per month, and may be broken down by type. For example, \"2 hours of lectures, 1 hour of lab work and 3 hours of independent study per week\"." .

example:coverageEndTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "coverageEndTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time when the live blog will stop covering the Event. Note that coverage may continue after the Event concludes." .

example:coverageStartTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "coverageStartTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time when the live blog will begin covering the Event. Note that coverage may begin before the Event's start time. The LiveBlogPosting may also be created before coverage begins." .

example:creativeWorkStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "creativeWorkStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The status of a creative work in terms of its stage in a lifecycle. Example terms include Incomplete, Draft, Published, Obsolete. Some organizations define a set of terms for the stages of their publication lifecycle." .

example:creator a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "creator" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork." .

example:credentialCategory a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "credentialCategory" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The category or type of credential being described, for example \"degreeâ€, â€œcertificateâ€, â€œbadgeâ€, or more specific term." .

example:creditText a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "creditText" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work." .

example:creditedTo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "creditedTo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The group the release is credited to if different than the byArtist. For example, Red and Blue is credited to \"Stefani Germanotta Band\", but by Lady Gaga." .

example:cssSelector a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cssSelector" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A CSS selector, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." .

example:currenciesAccepted a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "currenciesAccepted" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The currency accepted.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." .

example:currency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "currency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The currency in which the monetary amount is expressed.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." .

example:currentExchangeRate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "currentExchangeRate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The current price of a currency." .

example:customer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "customer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Party placing the order or paying the invoice." .

example:customerRemorseReturnFees a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "customerRemorseReturnFees" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The type of return fees if the product is returned due to customer remorse." .

example:customerRemorseReturnLabelSource a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "customerRemorseReturnLabelSource" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The method (from an enumeration) by which the customer obtains a return shipping label for a product returned due to customer remorse." .

example:customerRemorseReturnShippingFeesAmount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "customerRemorseReturnShippingFeesAmount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The amount of shipping costs if a product is returned due to customer remorse. Applicable when property [[customerRemorseReturnFees]] equals [[ReturnShippingFees]]." .

example:cutoffTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cutoffTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Order cutoff time allows merchants to describe the time after which they will no longer process orders received on that day. For orders processed after cutoff time, one day gets added to the delivery time estimate. This property is expected to be most typically used via the [[ShippingRateSettings]] publication pattern. The time is indicated using the ISO-8601 Time format, e.g. \"23:30:00-05:00\" would represent 6:30 pm Eastern Standard Time (EST) which is 5 hours behind Coordinated Universal Time (UTC)." .

example:cvdCollectionDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdCollectionDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "collectiondate - Date for which patient counts are reported." .

example:cvdFacilityCounty a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdFacilityCounty" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Name of the County of the NHSN facility that this data record applies to. Use [[cvdFacilityId]] to identify the facility. To provide other details, [[healthcareReportingData]] can be used on a [[Hospital]] entry." .

example:cvdFacilityId a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdFacilityId" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifier of the NHSN facility that this data record applies to. Use [[cvdFacilityCounty]] to indicate the county. To provide other details, [[healthcareReportingData]] can be used on a [[Hospital]] entry." .

example:cvdNumBeds a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumBeds" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numbeds - HOSPITAL INPATIENT BEDS: Inpatient beds, including all staffed, licensed, and overflow (surge) beds used for inpatients." .

example:cvdNumBedsOcc a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumBedsOcc" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numbedsocc - HOSPITAL INPATIENT BED OCCUPANCY: Total number of staffed inpatient beds that are occupied." .

example:cvdNumC19Died a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumC19Died" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numc19died - DEATHS: Patients with suspected or confirmed COVID-19 who died in the hospital, ED, or any overflow location." .

example:cvdNumC19HOPats a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumC19HOPats" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numc19hopats - HOSPITAL ONSET: Patients hospitalized in an NHSN inpatient care location with onset of suspected or confirmed COVID-19 14 or more days after hospitalization." .

example:cvdNumC19HospPats a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumC19HospPats" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numc19hosppats - HOSPITALIZED: Patients currently hospitalized in an inpatient care location who have suspected or confirmed COVID-19." .

example:cvdNumC19MechVentPats a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumC19MechVentPats" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numc19mechventpats - HOSPITALIZED and VENTILATED: Patients hospitalized in an NHSN inpatient care location who have suspected or confirmed COVID-19 and are on a mechanical ventilator." .

example:cvdNumC19OFMechVentPats a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumC19OFMechVentPats" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numc19ofmechventpats - ED/OVERFLOW and VENTILATED: Patients with suspected or confirmed COVID-19 who are in the ED or any overflow location awaiting an inpatient bed and on a mechanical ventilator." .

example:cvdNumC19OverflowPats a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumC19OverflowPats" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numc19overflowpats - ED/OVERFLOW: Patients with suspected or confirmed COVID-19 who are in the ED or any overflow location awaiting an inpatient bed." .

example:cvdNumICUBeds a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumICUBeds" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numicubeds - ICU BEDS: Total number of staffed inpatient intensive care unit (ICU) beds." .

example:cvdNumICUBedsOcc a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumICUBedsOcc" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numicubedsocc - ICU BED OCCUPANCY: Total number of staffed inpatient ICU beds that are occupied." .

example:cvdNumTotBeds a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumTotBeds" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numtotbeds - ALL HOSPITAL BEDS: Total number of all Inpatient and outpatient beds, including all staffed,ICU, licensed, and overflow (surge) beds used for inpatients or outpatients." .

example:cvdNumVent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumVent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numvent - MECHANICAL VENTILATORS: Total number of ventilators available." .

example:cvdNumVentUse a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cvdNumVentUse" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "numventuse - MECHANICAL VENTILATORS IN USE: Total number of ventilators in use." .

example:dataFeedElement a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataFeedElement" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An item within in a data feed. Data feeds may have many elements." .

example:dataset a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataset" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A dataset contained in this catalog." .

example:datasetTimeInterval a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "datasetTimeInterval" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The range of temporal applicability of a dataset, e.g. for a 2011 census dataset, the year 2011 (in ISO 8601 time interval format)." .

example:dateCreated a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateCreated" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date on which the CreativeWork was created or the item was added to a DataFeed." .

example:dateDeleted a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateDeleted" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The datetime the item was removed from the DataFeed." .

example:dateIssued a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateIssued" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date the ticket was issued." .

example:dateModified a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateModified" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed." .

example:datePosted a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "datePosted" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Publication date of an online listing." .

example:datePublished a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "datePublished" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date of first broadcast/publication." .

example:dateRead a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateRead" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date/time at which the message has been read by the recipient if a single recipient exists." .

example:dateReceived a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateReceived" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date/time the message was received if a single recipient exists." .

example:dateSent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateSent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date/time at which the message was sent." .

example:dateVehicleFirstRegistered a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateVehicleFirstRegistered" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date of the first registration of the vehicle with the respective public authorities." .

example:dateline a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateline" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A [dateline](https://en.wikipedia.org/wiki/Dateline) is a brief piece of text included in news articles that describes where and when the story was written or filed though the date is often omitted. Sometimes only a placename is provided.

Structured representations of dateline-related information can also be expressed more explicitly using [[locationCreated]] (which represents where a work was created e.g. where a news report was written).  For location depicted or described in the content, use [[contentLocation]].

Dateline summaries are oriented more towards human readers than towards automated processing, and can vary substantially. Some examples: "BEIRUT, Lebanon, June 2.", "Paris, France", "December 19, 2017 11:43AM Reporting from Washington", "Beijing/Moscow", "QUEZON CITY, Philippines".
      """ .

example:dayOfWeek a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dayOfWeek" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The day of the week for which these opening hours are valid." .

example:deathDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deathDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date of death." .

example:deathPlace a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deathPlace" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The place where the person died." .

example:defaultValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "defaultValue" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The default value of the input.  For properties that expect a literal, the default is a literal value, for properties that expect an object, it's an ID reference to one of the current values." .

example:deliveryAddress a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deliveryAddress" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Destination address." .

example:deliveryLeadTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deliveryLeadTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup." .

example:deliveryMethod a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deliveryMethod" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of instrument. The method of delivery." .

example:deliveryStatus a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deliveryStatus" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "New entry added as the package passes through each leg of its journey (from shipment to final delivery)." .

example:deliveryTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deliveryTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The total delay between the receipt of the order and the goods reaching the final customer." .

example:department a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "department" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A relationship between an organization and a department of that organization, also described as an organization (allowing different urls, logos, opening hours). For example: a store with a pharmacy, or a bakery with a cafe." .

example:departureAirport a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureAirport" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The airport where the flight originates." .

example:departureBoatTerminal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureBoatTerminal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The terminal or port from which the boat departs." .

example:departureBusStop a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureBusStop" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The stop or station from which the bus departs." .

example:departureGate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureGate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifier of the flight's departure gate." .

example:departurePlatform a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departurePlatform" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The platform from which the train departs." .

example:departureStation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureStation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The station from which the train departs." .

example:departureTerminal a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureTerminal" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Identifier of the flight's departure terminal." .

example:departureTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "departureTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The expected departure time." .

example:dependencies a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dependencies" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Prerequisites needed to fulfill steps in article." .

example:depth a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "depth" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The depth of the item." .

example:description a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "description" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A description of the item." .

example:device a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "device" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Device required to run the application. Used in cases where a specific make/model is required to run the application." .

example:diagnosis a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diagnosis" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "One or more alternative conditions considered in the differential diagnosis process as output of a diagnosis process." .

example:diagram a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diagram" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An image containing a diagram that illustrates the structure and/or its component substructures and/or connections with other structures." .

example:diet a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diet" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of instrument. The diet used in this action." .

example:dietFeatures a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dietFeatures" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Nutritional information specific to the dietary plan. May include dietary recommendations on what foods to avoid, what foods to consume, and specific alterations/deviations from the USDA or other regulatory body's approved dietary guidelines." .

example:differentialDiagnosis a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "differentialDiagnosis" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "One of a set of differential diagnoses for the condition. Specifically, a closely-related or competing diagnosis typically considered later in the cognitive process whereby this medical condition is distinguished from others most likely responsible for a similar collection of signs and symptoms to reach the most parsimonious diagnosis or diagnoses in a patient." .

example:directApply a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "directApply" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates whether an [[url]] that is associated with a [[JobPosting]] enables direct application for the job, via the posting website. A job posting is considered to have directApply of [[True]] if an application process for the specified job can be directly initiated via the url(s) given (noting that e.g. multiple internet domains might nevertheless be involved at an implementation level). A value of [[False]] is appropriate if there is no clear path to applying directly online for the specified job, navigating directly from the JobPosting url(s) supplied." .

example:director a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "director" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A director of e.g. tv, radio, movie, video gaming etc. content, or of an event. Directors can be associated with individual items or with a series, episode, clip." .

example:directors a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "directors" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A director of e.g. tv, radio, movie, video games etc. content. Directors can be associated with individual items or with a series, episode, clip." .

example:disambiguatingDescription a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "disambiguatingDescription" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A sub property of description. A short description of the item used to disambiguate from other, similar items. Information from other properties (in particular, name) may be necessary for the description to be useful for disambiguation." .

example:discount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "discount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Any discount applied (to an Order)." .

example:discountCode a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "discountCode" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Code used to redeem a discount." .

example:discountCurrency a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "discountCurrency" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The currency of the discount.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." .

example:discusses a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "discusses" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Specifies the CreativeWork associated with the UserComment." .

example:discussionUrl a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "discussionUrl" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A link to the page containing the comments of the CreativeWork." .

example:diseasePreventionInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diseasePreventionInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Information about disease prevention." .

example:diseaseSpreadStatistics a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diseaseSpreadStatistics" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """Statistical information about the spread of a disease, either as [[WebContent]], or
  described directly as a [[Dataset]], or the specific [[Observation]]s in the dataset. When a [[WebContent]] URL is
  provided, the page indicated might also contain more such markup.""" .

example:dissolutionDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dissolutionDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date that this organization was dissolved." .

example:distance a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "distance" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The distance travelled, e.g. exercising or travelling." .

example:distinguishingSign a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "distinguishingSign" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "One of a set of signs and symptoms that can be used to distinguish this diagnosis from others in the differential diagnosis." .

example:distribution a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "distribution" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A downloadable form of this dataset, at a specific location, in a specific format." .

example:diversityPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diversityPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Statement on diversity policy by an [[Organization]] e.g. a [[NewsMediaOrganization]]. For a [[NewsMediaOrganization]], a statement describing the newsroomâ€™s diversity policy on both staffing and sources, typically providing staffing data." .

example:diversityStaffingReport a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diversityStaffingReport" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a report on staffing diversity issues. In a news context this might be for example ASNE or RTDNA (US) reports, or self-reported." .

example:documentation a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "documentation" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Further documentation describing the Web API in more detail." .

example:doesNotShip a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "doesNotShip" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates when shipping to a particular [[shippingDestination]] is not available." .

example:domainIncludes a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "domainIncludes" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Relates a property to a class that is (one of) the type(s) the property is expected to be used on." .

example:domiciledMortgage a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "domiciledMortgage" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Whether borrower is a resident of the jurisdiction where the property is located." .

example:doorTime a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "doorTime" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The time admission will commence." .

example:dosageForm a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dosageForm" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A dosage form in which this drug/supplement is available, e.g. 'tablet', 'suspension', 'injection'." .

example:doseSchedule a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "doseSchedule" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A dosing schedule for the drug for a given population, either observed, recommended, or maximum dose based on the type used." .

example:doseUnit a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "doseUnit" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The unit of the dose, e.g. 'mg'." .

example:doseValue a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "doseValue" ;
    ns1:inScheme <http://example.org/example> ;
