example:recordLabel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recordLabel" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The label that issued the release." .

example:recordedAs a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recordedAs" ;
    ns1:inScheme <http://example.org/example> ;
