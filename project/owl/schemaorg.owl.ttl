example:AdvertiserContentArticle a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AdvertiserContentArticle" ;
    rdfs:subClassOf example:Article ;
    ns1:exactMatch <http://schema.org/AdvertiserContentArticle> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An [[Article]] that an external entity has paid to place or to produce to its specifications. Includes [advertorials](https://en.wikipedia.org/wiki/Advertorial), sponsored content, native advertising and other paid content." .

example:AggregateOffer a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AggregateOffer" ;
    rdfs:subClassOf example:Offer ;
    ns1:exactMatch <http://schema.org/AggregateOffer> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "When a single product is associated with multiple offers (for example, the same pair of shoes is offered by different merchants), then AggregateOffer can be used.\\n\\nNote: AggregateOffers are normally expected to associate multiple offers that all share the same defined [[businessFunction]] value, or default to http://purl.org/goodrelations/v1#Sell if businessFunction is not explicitly defined." .

example:AgreeAction a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "AgreeAction" ;
    rdfs:subClassOf example:ReactAction ;
    ns1:exactMatch <http://schema.org/AgreeAction> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The act of expressing a consistency of opinion with the object. An agent agrees to/about an object (a proposition, topic or theme) with participants." .

example:Airline a ns3:Class,
        linkml:ClassDefinition ;
