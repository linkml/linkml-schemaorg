    rdfs:subClassOf example:PaymentCard ;
    ns1:exactMatch <http://schema.org/CreditCard> ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """A card payment method of a particular brand or name.  Used to mark up a particular payment method and/or the financial product/service that supplies the card account.\\n\\nCommonly used values:\\n\\n* http://purl.org/goodrelations/v1#AmericanExpress\\n* http://purl.org/goodrelations/v1#DinersClub\\n* http://purl.org/goodrelations/v1#Discover\\n* http://purl.org/goodrelations/v1#JCB\\n* http://purl.org/goodrelations/v1#MasterCard\\n* http://purl.org/goodrelations/v1#VISA
       """ .

example:Crematorium a ns3:Class,
