example:producer a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "producer" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The person or organization who produced the work (e.g. music album, movie, tv/radio series etc.)." .

example:produces a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "produces" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The tangible thing generated by the service, e.g. a passport, permit, etc." .

example:productGroupID a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "productGroupID" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Indicates a textual identifier for a ProductGroup." .

example:productID a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "productID" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The product identifier, such as ISBN. For example: ``` meta itemprop=\"productID\" content=\"isbn:123-456-789\" ```." .

example:productSupported a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "productSupported" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The product or service this support contact point is related to (such as product support for a particular product line). This can be a specific product or product line (e.g. \"iPhone\") or a general category of products or services (e.g. \"smartphones\")." .

example:productionCompany a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "productionCompany" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The production company or studio responsible for the item e.g. series, video game, episode etc." .

example:productionDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "productionDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date of production of the item, e.g. vehicle." .

example:proficiencyLevel a ns3:ObjectProperty,
        linkml:SlotDefinition ;
