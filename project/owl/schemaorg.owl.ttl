example:Integer a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Integer" ;
    rdfs:subClassOf example:Number ;
    ns1:exactMatch <http://schema.org/Integer> ;
    ns1:inScheme <http://example.org/example> ;
