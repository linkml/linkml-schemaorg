example:Attorney a ns3:Class,
        linkml:ClassDefinition ;
    rdfs:label "Attorney" ;
    rdfs:subClassOf example:LegalService ;
    ns1:exactMatch <http://schema.org/Attorney> ;
    ns1:inScheme <http://example.org/example> ;
