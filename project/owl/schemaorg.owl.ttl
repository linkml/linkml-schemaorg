    ns1:inScheme <http://example.org/example> ;
    ns1:note """A string or text indicating the unit of measurement. Useful if you cannot provide a standard unit code for
<a href='unitCode'>unitCode</a>.""" .

example:unnamedSourcesPolicy a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "unnamedSourcesPolicy" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "For an [[Organization]] (typically a [[NewsMediaOrganization]]), a statement about policy on use of unnamed sources and the decision process required." .

example:unsaturatedFatContent a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "unsaturatedFatContent" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of grams of unsaturated fat." .

example:uploadDate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "uploadDate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Date when this media object was uploaded to this site." .

example:upvoteCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "upvoteCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of upvotes this question, answer or comment has received from the community." .

example:url a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "url" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "URL of the item." .

example:urlTemplate a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "urlTemplate" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "An url template (RFC6570) that will be used to construct the target of the execution of the action." .

example:usageInfo a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "usageInfo" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The schema.org [[usageInfo]] property indicates further information about a [[CreativeWork]]. This property is applicable both to works that are freely available and to those that require payment or other transactions. It can reference additional information e.g. community expectations on preferred linking and citation conventions, as well as purchasing details. For something that can be commercially licensed, usageInfo can provide detailed, resource-specific information about licensing options.

This property can be used alongside the license property which indicates license(s) applicable to some piece of content. The usageInfo property can provide information about other licensing options, e.g. acquiring commercial usage rights for an image that is also available under non-commercial creative commons licenses.""" .

example:usedToDiagnose a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "usedToDiagnose" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "A condition the test is used to diagnose." .

example:userInteractionCount a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "userInteractionCount" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication." .

example:usesDevice a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "usesDevice" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Device used to perform the test." .

example:usesHealthPlanIdStandard a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "usesHealthPlanIdStandard" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The standard for interpreting thePlan ID. The preferred is \"HIOS\". See the Centers for Medicare & Medicaid Services for more details." .

example:utterances a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "utterances" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "Text of an utterances (spoken words, lyrics etc.) that occurs at a certain section of a media object, represented as a [[HyperTocEntry]]." .

example:validFor a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "validFor" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The duration of validity of a permit or similar thing." .

example:validFrom a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "validFrom" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The date when the item becomes valid." .

example:validIn a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "validIn" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note "The geographic area where a permit or similar thing is valid." .

example:validThrough a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "validThrough" ;
    ns1:inScheme <http://example.org/example> ;
