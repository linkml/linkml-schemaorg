example:bed a ns3:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bed" ;
    ns1:inScheme <http://example.org/example> ;
    ns1:note """The type of bed or beds included in the accommodation. For the single case of just one bed of a certain type, you use bed directly with a text.
      If you want to indicate the quantity of a certain kind of bed, use an instance of BedDetails. For more detailed information, use the amenityFeature property.""" .

example:beforeMedia a ns3:ObjectProperty,
        linkml:SlotDefinition ;
