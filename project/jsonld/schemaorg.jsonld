      "mappings": [
        "http://schema.org/firstPerformance"
      ],
      "slot_uri": "http://schema.org/firstPerformance",
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "archiveHeld",
      "definition_uri": "http://example.org/example/archiveHeld",
      "comments": [
        "Collection, [fonds](https://en.wikipedia.org/wiki/Fonds), or item held, kept or maintained by an [[ArchiveOrganization]]."
      ],
      "from_schema": "http://example.org/example",
      "mappings": [
